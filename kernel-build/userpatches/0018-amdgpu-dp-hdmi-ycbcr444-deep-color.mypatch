From: rpf16rj/bc250-steamos-real-toolkit (via SkillFishOS)
Subject: [PATCH] drm/amd/display: YCbCr 4:4:4 and deep color on DP-HDMI PCON dongles

The BC-250 only has DisplayPort output; an HDMI TV needs an active
DP-to-HDMI protocol converter (PCON). With the stock driver such a link
is RGB, 8 bpc, TMDS only. Four changes, taken from the BC-250 SteamOS
Real Toolkit (bc250-dp-hdmi-ycbcr444-deep-color.patch):

 1. Two amdgpu module parameters, both OFF by default:
      force_ycbcr444 (bool, default 0)  force YCbCr 4:4:4 on a PCON
                                        when FRL is negotiated;
      force_min_bpc  (uint, default 0)  floor for bits per color
                                        (0 = auto, 8/10/12 = floor).
    On DC_FAIL_ENC_VALIDATE / DC_EXCEED_DONGLE_CAP the driver now also
    retries with YCbCr 4:4:4 before dropping to 4:2:2 and 4:2:0.
 2. Deep color (10/12 bpc) on a PCON is taken from the HDMI CTA EDID
    deep color flags (edid_hdmi_rgb444_dc_modes / ycbcr444_dc_modes)
    instead of display_info.bpc, which never reports deep color on a
    DP connector. requested_bpc is also capped to the dongle max bpc.
 3. Quirk for the Chrontel CH7218 PCON (branch OUI 2B02F0, name
    "CH7218", e.g. Ugreen DP-HDMI 2.1): the dongle reports a malformed
    downstream port topology, which made DC drop its HDMI converter
    caps and with them HDMI 2.1 FRL. The quirk restores converter type,
    12 bpc, 48 Gbps FRL and 4:2:2/4:2:0 pass-through.
 4. dc->caps.dp_hdmi21_pcon_support = true on DCN201 (Cyan Skillfish),
    which upstream sets for DCN20/21/30x but not for DCN201; without it
    the FRL caps of a PCON are never parsed.

Plus debug prints (drm_dbg_kms / pr_debug / DC_LOG_DC, silent unless
dynamic debug is enabled) used by the toolkit troubleshooting guide.

Requirements: the HDMI FRL framework of kernel 7.2+, enabled at boot
with amdgpu.dcfeaturemask=0x402 (DC_FRL_MASK, bit 10, off by default).
Typical use from the toolkit:
    options amdgpu force_ycbcr444=1 force_min_bpc=10 dcfeaturemask=0x402

Ported to Linux 7.2 for SkillFishOS on 2026-09-11. Compared with the
original: DP_BRANCH_DEVICE_ID_2B02F0 did not exist in 7.2 and is added
to include/ddc_service_types.h; the two unconditional printk(KERN_INFO)
DPCD dumps became DC_LOG_DC; the module parameters sit after the DMUB
firmware list (the original context was SteamOS-specific).

UNTESTED on our boards: none of them has a PCON dongle. With both
parameters at their defaults the only behavioural changes for a plain
DP monitor are the dp_hdmi21_pcon_support flag and the extra YCbCr
4:4:4 retry on a PCON validation failure.
---
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -161,6 +161,19 @@
 #define FIRMWARE_DCN_42B_DMUB "amdgpu/dcn_4_2_1_dmcub.bin"
 MODULE_FIRMWARE(FIRMWARE_DCN_42B_DMUB);
 
+/*
+ * Force YCbCr 4:4:4 pixel encoding on DP to HDMI PCON dongles.
+ */
+static bool amdgpu_dm_force_ycbcr444;
+module_param_named(force_ycbcr444, amdgpu_dm_force_ycbcr444, bool, 0644);
+MODULE_PARM_DESC(force_ycbcr444,
+		 "Force YCbCr 4:4:4 pixel encoding on DP-HDMI PCON outputs (default: off)");
+
+static uint amdgpu_dm_force_min_bpc;
+module_param_named(force_min_bpc, amdgpu_dm_force_min_bpc, uint, 0644);
+MODULE_PARM_DESC(force_min_bpc,
+		 "Minimum bits per color on PCON outputs (0 = auto, 8/10/12 = floor)");
+
 /**
  * DOC: overview
  *
@@ -6784,8 +6797,18 @@
 convert_color_depth_from_display_info(const struct drm_connector *connector,
 				      bool is_y420, int requested_bpc)
 {
+	const struct drm_display_info *info = &connector->display_info;
+	struct amdgpu_dm_connector *aconnector = NULL;
+	bool is_hdmi_pcon = false;
 	u8 bpc;
 
+	if (connector->connector_type != DRM_MODE_CONNECTOR_WRITEBACK) {
+		aconnector = to_amdgpu_dm_connector(connector);
+		is_hdmi_pcon = aconnector && aconnector->dc_link &&
+			aconnector->dc_link->dpcd_caps.dongle_type ==
+				DISPLAY_DONGLE_DP_HDMI_CONVERTER;
+	}
+
 	if (is_y420) {
 		bpc = 8;
 
@@ -6796,12 +6819,41 @@
 			bpc = 12;
 		else if (connector->display_info.hdmi.y420_dc_modes & DRM_EDID_YCBCR420_DC_30)
 			bpc = 10;
+	} else if (is_hdmi_pcon) {
+		/*
+		 * display_info.bpc does not reflect deep color on a DP
+		 * connector: use the HDMI CTA deep color flags of the sink
+		 * behind the PCON instead.
+		 */
+		u8 dc_modes = amdgpu_dm_force_ycbcr444 ?
+			info->edid_hdmi_ycbcr444_dc_modes :
+			info->edid_hdmi_rgb444_dc_modes;
+
+		bpc = 8;
+		if (dc_modes & DRM_EDID_HDMI_DC_48)
+			bpc = 16;
+		else if (dc_modes & DRM_EDID_HDMI_DC_36)
+			bpc = 12;
+		else if (dc_modes & DRM_EDID_HDMI_DC_30)
+			bpc = 10;
+		drm_dbg_kms(connector->dev,
+			"PCON bpc from dc_modes=0x%x -> %d (rgb_dc=0x%x y444_dc=0x%x info_bpc=%u)\n",
+			dc_modes, bpc, info->edid_hdmi_rgb444_dc_modes,
+			info->edid_hdmi_ycbcr444_dc_modes, info->bpc);
 	} else {
 		bpc = (uint8_t)connector->display_info.bpc;
 		/* Assume 8 bpc by default if no bpc is specified. */
 		bpc = bpc ? bpc : 8;
 	}
 
+	if (amdgpu_dm_force_min_bpc && !is_y420) {
+		bpc = max_t(u8, bpc, (u8)amdgpu_dm_force_min_bpc);
+		bpc = bpc - (bpc & 1);
+		drm_dbg_kms(connector->dev,
+			"force_min_bpc=%u -> bpc floored to %d\n",
+			amdgpu_dm_force_min_bpc, bpc);
+	}
+
 	if (requested_bpc > 0) {
 		/*
 		 * Cap display bpc based on the user requested value.
@@ -7005,7 +7057,22 @@
 			&& (aconnector->force_yuv_pixel_format == PIXEL_ENCODING_YCBCR422
 			|| aconnector->force_yuv422_output))
 		timing_out->pixel_encoding = PIXEL_ENCODING_YCBCR422;
-	else if ((connector->display_info.color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR444))
+	else if (amdgpu_dm_force_ycbcr444 && aconnector &&
+			stream->signal == SIGNAL_TYPE_HDMI_FRL) {
+		/*
+		 * Force YCbCr 4:4:4 only when FRL is already negotiated for this
+		 * mode. FRL has enough bandwidth (48 Gbps on CH7218) to sustain
+		 * 4:4:4 at 10-bit for 1440p120. For TMDS modes (which includes
+		 * gamescope custom modes where FRL may not be negotiated), don't
+		 * force 4:4:4 and let the driver fall back to 4:2:0 if needed.
+		 */
+		timing_out->pixel_encoding = PIXEL_ENCODING_YCBCR444;
+		drm_dbg_kms(connector->dev,
+			"force_ycbcr444=Y -> YCBCR444 (FRL signal=%d dongle=%d pix_clk=%u)\n",
+			stream->signal,
+			aconnector->dc_link ? aconnector->dc_link->dpcd_caps.dongle_type : -1,
+			timing_out->pix_clk_100hz / 10);
+	} else if ((connector->display_info.color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR444))
 			&& (stream->signal == SIGNAL_TYPE_HDMI_TYPE_A ||
 			    stream->signal == SIGNAL_TYPE_HDMI_FRL)
 			&& aconnector
@@ -7019,6 +7086,10 @@
 		connector,
 		(timing_out->pixel_encoding == PIXEL_ENCODING_YCBCR420),
 		requested_bpc);
+	drm_dbg_kms(connector->dev,
+		"stream depth=%d encoding=%d requested_bpc=%d signal=%d\n",
+		timing_out->display_color_depth, timing_out->pixel_encoding,
+		requested_bpc, stream->signal);
 	timing_out->scan_type = SCANNING_TYPE_NODATA;
 	timing_out->hdmi_vic = 0;
 
@@ -8452,6 +8523,33 @@
 	     aconnector->dc_link->dpcd_caps.dongle_type == DISPLAY_DONGLE_DP_HDMI_CONVERTER))
 		bpc_limit = 8;
 
+	if (amdgpu_dm_force_min_bpc)
+		bpc_limit = max_t(uint8_t, bpc_limit, (uint8_t)amdgpu_dm_force_min_bpc);
+
+	if (aconnector && aconnector->dc_link) {
+		struct dc_dongle_caps *dcaps = &aconnector->dc_link->dpcd_caps.dongle_caps;
+
+		/*
+		 * Cap requested_bpc to the dongle's max bpc to avoid
+		 * pointless validation iterations that always fail.
+		 */
+		if (dcaps->dp_hdmi_max_bpc > 0 &&
+		    aconnector->dc_link->dpcd_caps.dongle_type ==
+			    DISPLAY_DONGLE_DP_HDMI_CONVERTER &&
+		    dcaps->extendedCapValid)
+			requested_bpc = min_t(int, requested_bpc,
+					      dcaps->dp_hdmi_max_bpc);
+
+		drm_dbg_kms(connector->dev,
+			"validate req_bpc=%d bpc_limit=%d force_y444=%d force_min_bpc=%u dongle_type=%d dp_hdmi_max_bpc=%d dfp_ext=%d frl_bw=%d\n",
+			requested_bpc, bpc_limit, amdgpu_dm_force_ycbcr444,
+			amdgpu_dm_force_min_bpc,
+			aconnector->dc_link->dpcd_caps.dongle_type,
+			dcaps->dp_hdmi_max_bpc,
+			dcaps->dfp_cap_ext.supported,
+			dcaps->dp_hdmi_frl_max_link_bw_in_kbps);
+	}
+
 	do {
 		drm_dbg_kms(connector->dev, "Trying with %d bpc\n", requested_bpc);
 		stream = create_stream_for_sink(connector, drm_mode,
@@ -8474,6 +8572,11 @@
 			dc_result = dm_validate_stream_and_context(adev->dm.dc, stream);
 
 		if (dc_result != DC_OK) {
+			drm_dbg_kms(connector->dev,
+				"VALIDATION FAILED at bpc=%d depth=%d enc=%d result=%d (%s)\n",
+				requested_bpc, stream->timing.display_color_depth,
+				stream->timing.pixel_encoding, dc_result,
+				dc_status_to_str(dc_result));
 			drm_dbg_kms(connector->dev, "Pruned mode %d x %d (clk %d) %s %s -- %s\n",
 				      drm_mode->hdisplay,
 				      drm_mode->vdisplay,
@@ -8498,6 +8601,24 @@
 	 */
 	case DC_FAIL_ENC_VALIDATE:
 	case DC_EXCEED_DONGLE_CAP:
+		/*
+		 * RGB did not pass on the PCON: retry with YCbCr 4:4:4 at the
+		 * same depth before giving up chroma with 4:2:2 / 4:2:0.
+		 */
+		if (aconnector &&
+		    !amdgpu_dm_force_ycbcr444 &&
+		    !(aconnector->force_yuv422_output ||
+		      aconnector->force_yuv420_output)) {
+			drm_dbg_kms(connector->dev,
+				"RGB failed (%d), trying YCbCr 4:4:4 fallback\n", dc_result);
+			amdgpu_dm_force_ycbcr444 = true;
+			stream = create_validate_stream_for_sink(connector, drm_mode,
+								 dm_state, old_stream);
+			amdgpu_dm_force_ycbcr444 = false;
+			if (stream)
+				return stream;
+		}
+		fallthrough;
 	case DC_NO_DP_LINK_BANDWIDTH:
 		/* recursively entered twice and already tried both YUV422 and YUV420 */
 		if (aconnector->force_yuv422_output && aconnector->force_yuv420_output)
diff --git a/drivers/gpu/drm/amd/display/dc/link/link_validation.c b/drivers/gpu/drm/amd/display/dc/link/link_validation.c
--- a/drivers/gpu/drm/amd/display/dc/link/link_validation.c
+++ b/drivers/gpu/drm/amd/display/dc/link/link_validation.c
@@ -74,6 +74,12 @@
 
 	if (dpcd_caps->dongle_type == DISPLAY_DONGLE_DP_HDMI_CONVERTER &&
 			dongle_caps->extendedCapValid == true) {
+		pr_debug("dongle_validate enc=%d depth=%d dp_hdmi_max_bpc=%d dfp_ext=%d frl_bw=%d max_pix_clk=%d\n",
+			timing->pixel_encoding, timing->display_color_depth,
+			dongle_caps->dp_hdmi_max_bpc,
+			dongle_caps->dfp_cap_ext.supported,
+			dongle_caps->dp_hdmi_frl_max_link_bw_in_kbps,
+			dongle_caps->dp_hdmi_max_pixel_clk_in_khz);
 		/* Check Pixel Encoding */
 		switch (timing->pixel_encoding) {
 		case PIXEL_ENCODING_RGB:
@@ -492,6 +498,10 @@
 
 	req_bw = dc_bandwidth_in_kbps_from_timing(timing, dc_link_get_highest_encoding_format(link));
 	max_bw = dp_link_bandwidth_kbps(link, link_setting);
+	pr_debug("dp_validate req_bw=%u max_bw=%u link_rate=%d lanes=%d encoding=%d pix_clk=%d depth=%d enc=%d\n",
+		req_bw, max_bw, link_setting->link_rate, link_setting->lane_count,
+		dc_link_get_highest_encoding_format(link),
+		timing->pix_clk_100hz, timing->display_color_depth, timing->pixel_encoding);
 	uint32_t max_uncompressed_pixel_rate_100hz =
 		link->dpcd_caps.max_uncompressed_pixel_rate_cap.bits.max_uncompressed_pixel_rate_cap * 10000U;
 
diff --git a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_capability.c b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_capability.c
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_capability.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_capability.c
@@ -1168,6 +1168,29 @@
 
 	/* decode converter info*/
 	if (!ds_port.fields.PORT_PRESENT) {
+		/*
+		 * Chrontel CH7218 DP-HDMI 2.1 PCON: reports no downstream
+		 * port, which would hide its HDMI converter (and FRL) caps.
+		 */
+		if (link->dpcd_caps.branch_dev_id == DP_BRANCH_DEVICE_ID_2B02F0 &&
+				!memcmp(link->dpcd_caps.branch_dev_name, "CH7218",
+					sizeof(link->dpcd_caps.branch_dev_name)) &&
+				link->dc->caps.dp_hdmi21_pcon_support) {
+			printk(KERN_INFO "amdgpu: DC: CH7218 PCON quirk: port not present, restoring converter caps\n");
+			link->dpcd_caps.is_branch_dev = true;
+			link->dpcd_caps.dongle_type =
+				DISPLAY_DONGLE_DP_HDMI_CONVERTER;
+			link->dpcd_caps.dongle_caps.dongle_type =
+				link->dpcd_caps.dongle_type;
+			link->dpcd_caps.dongle_caps.dp_hdmi_max_bpc = 12;
+			link->dpcd_caps.dongle_caps.dp_hdmi_frl_max_link_bw_in_kbps = 48000000;
+			link->dpcd_caps.dongle_caps.is_dp_hdmi_ycbcr422_pass_through = true;
+			link->dpcd_caps.dongle_caps.is_dp_hdmi_ycbcr420_pass_through = true;
+			link->dpcd_caps.dongle_caps.extendedCapValid = true;
+			set_dongle_type(link->ddc,
+					link->dpcd_caps.dongle_type);
+			return;
+		}
 		link->dpcd_caps.dongle_type = DISPLAY_DONGLE_NONE;
 		set_dongle_type(link->ddc,
 				link->dpcd_caps.dongle_type);
@@ -1202,7 +1225,23 @@
 			switch (port_caps->bits.DWN_STRM_PORTX_TYPE) {
 			/*Handle DP case as DONGLE_NONE*/
 			case DOWN_STREAM_DETAILED_DP:
-				link->dpcd_caps.dongle_type = DISPLAY_DONGLE_NONE;
+				if (link->dpcd_caps.branch_dev_id == DP_BRANCH_DEVICE_ID_2B02F0 &&
+						!memcmp(link->dpcd_caps.branch_dev_name, "CH7218",
+							sizeof(link->dpcd_caps.branch_dev_name)) &&
+						link->dc->caps.dp_hdmi21_pcon_support) {
+					printk(KERN_INFO "amdgpu: DC: CH7218 PCON quirk: detailed port=DP, restoring HDMI converter caps\n");
+					link->dpcd_caps.dongle_type =
+						DISPLAY_DONGLE_DP_HDMI_CONVERTER;
+					link->dpcd_caps.dongle_caps.dongle_type =
+						link->dpcd_caps.dongle_type;
+					link->dpcd_caps.dongle_caps.dp_hdmi_max_bpc = 12;
+					link->dpcd_caps.dongle_caps.dp_hdmi_frl_max_link_bw_in_kbps = 48000000;
+					link->dpcd_caps.dongle_caps.is_dp_hdmi_ycbcr422_pass_through = true;
+					link->dpcd_caps.dongle_caps.is_dp_hdmi_ycbcr420_pass_through = true;
+					link->dpcd_caps.dongle_caps.extendedCapValid = true;
+				} else {
+					link->dpcd_caps.dongle_type = DISPLAY_DONGLE_NONE;
+				}
 				break;
 			case DOWN_STREAM_DETAILED_VGA:
 				link->dpcd_caps.dongle_type =
@@ -1228,6 +1267,16 @@
 					link->dpcd_caps.dongle_caps.dp_hdmi_max_pixel_clk_in_khz =
 						det_caps[1] * 2500;
 
+					DC_LOG_DC("PCON DPCD det_caps: %02x %02x %02x %02x %02x %02x %02x %02x  port_type=%d\n",
+						det_caps[0], det_caps[1], det_caps[2], det_caps[3],
+						det_caps[4], det_caps[5], det_caps[6], det_caps[7],
+						port_caps->bits.DWN_STRM_PORTX_TYPE);
+					DC_LOG_DC("PCON hdmi_color_caps raw=0x%02x MAX_BPC=%d MAX_FRL_BW=%d (dp_hdmi21=%d)\n",
+						hdmi_color_caps.raw,
+						hdmi_color_caps.bits.MAX_BITS_PER_COLOR_COMPONENT,
+						hdmi_color_caps.bits.MAX_ENCODED_LINK_BW_SUPPORT,
+						link->dc->caps.dp_hdmi21_pcon_support);
+
 					link->dpcd_caps.dongle_caps.is_dp_hdmi_s3d_converter =
 						hdmi_caps.bits.FRAME_SEQ_TO_FRAME_PACK;
 					/*YCBCR capability only for HDMI case*/
diff --git a/drivers/gpu/drm/amd/display/dc/resource/dcn201/dcn201_resource.c b/drivers/gpu/drm/amd/display/dc/resource/dcn201/dcn201_resource.c
--- a/drivers/gpu/drm/amd/display/dc/resource/dcn201/dcn201_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/resource/dcn201/dcn201_resource.c
@@ -1331,6 +1331,9 @@
 
 	dc->caps.max_odm_combine_factor = 2;
 
+	/* Needed to parse HDMI 2.1 FRL caps of a DP-HDMI PCON (was missing on DCN201) */
+	dc->caps.dp_hdmi21_pcon_support = true;
+
 	dc->cap_funcs = cap_funcs;
 
 	return true;
diff --git a/drivers/gpu/drm/amd/display/include/ddc_service_types.h b/drivers/gpu/drm/amd/display/include/ddc_service_types.h
--- a/drivers/gpu/drm/amd/display/include/ddc_service_types.h
+++ b/drivers/gpu/drm/amd/display/include/ddc_service_types.h
@@ -37,6 +37,8 @@
 #define DP_BRANCH_DEVICE_ID_001CF8 0x001CF8
 #define DP_BRANCH_DEVICE_ID_0060AD 0x0060AD
 #define DP_BRANCH_DEVICE_ID_001FF2 0x001FF2
+/* 2B02F0 Chrontel CH7218 DP to HDMI 2.1 PCON */
+#define DP_BRANCH_DEVICE_ID_2B02F0 0x2B02F0
 #define DP_BRANCH_HW_REV_10 0x10
 #define DP_BRANCH_HW_REV_20 0x20
 

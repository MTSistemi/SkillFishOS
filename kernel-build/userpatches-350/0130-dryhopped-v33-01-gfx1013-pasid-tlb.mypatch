diff --git a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
index 304be33dc..f41523a8b 100644
--- a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
@@ -270,12 +270,13 @@ static bool gmc_v10_0_get_atc_vmid_pasid_mapping_info(
  *
  * Flush the TLB for the requested page table.
  */
-static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
-					uint32_t vmhub, uint32_t flush_type)
+static void gmc_v10_0_flush_gpu_tlb_internal(struct amdgpu_device *adev,
+					uint32_t vmid, uint32_t vmhub,
+					uint32_t flush_type, bool pasid_path)
 {
-	bool use_semaphore = gmc_v10_0_use_invalidate_semaphore(adev, vmhub);
+	bool use_semaphore;
 	struct amdgpu_vmhub *hub = &adev->vmhub[vmhub];
-	u32 inv_req = hub->vmhub_funcs->get_invalidate_req(vmid, flush_type);
+	u32 inv_req;
 	/* Use register 17 for GART */
 	const unsigned int eng = 17;
 	unsigned char hub_ip = 0;
@@ -283,6 +284,18 @@ static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
 	unsigned int i;
 	u32 tmp;
 
+	/* ===== DryhoppedIPA v33/0001, ported ===== */
+	/* On the PASID path gfx1013 only ever completes a type-0
+	 * invalidation on the GFXHUB, and it needs the semaphore that
+	 * gmc_v10_0_use_invalidate_semaphore() withholds for GFX10.
+	 */
+	if (pasid_path && vmhub == AMDGPU_GFXHUB(0) && flush_type == 2)
+		flush_type = 0;
+	use_semaphore = gmc_v10_0_use_invalidate_semaphore(adev, vmhub) ||
+		(pasid_path && vmhub == AMDGPU_GFXHUB(0));
+	inv_req = hub->vmhub_funcs->get_invalidate_req(vmid, flush_type);
+	/* ===== DryhoppedIPA v33/0001 END ===== */
+
 	sem = hub->vm_inv_eng0_sem + hub->eng_distance * eng;
 	req = hub->vm_inv_eng0_req + hub->eng_distance * eng;
 	ack = hub->vm_inv_eng0_ack + hub->eng_distance * eng;
@@ -403,6 +416,12 @@ static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
 			vmhub);
 }
 
+static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
+					uint32_t vmhub, uint32_t flush_type)
+{
+	gmc_v10_0_flush_gpu_tlb_internal(adev, vmid, vmhub, flush_type, false);
+}
+
 /**
  * gmc_v10_0_flush_gpu_tlb_pasid - tlb flush via pasid
  *
@@ -433,8 +452,9 @@ static void gmc_v10_0_flush_gpu_tlb_pasid(struct amdgpu_device *adev,
 			if (!gmc_v10_0_get_atc_vmid_pasid_mapping_info(
 			    adev, vmid, &queried))
 				continue;
-			gmc_v10_0_flush_gpu_tlb(adev, vmid,
-						AMDGPU_GFXHUB(0), flush_type);
+			gmc_v10_0_flush_gpu_tlb_internal(adev, vmid,
+						AMDGPU_GFXHUB(0), flush_type,
+						true);
 			atingidos++;
 		}
 		dev_info_ratelimited(adev->dev,

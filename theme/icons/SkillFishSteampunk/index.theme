[Icon Theme]
Name=SkillFish Steampunk
Comment=Brass & copper steampunk icon theme matching the SkillFishOS wallpaper
Inherits=breeze-dark,Adwaita,hicolor
Directories=48x48/apps,64x64/apps,256x256/apps,scalable/emblems,scalable/status,scalable/places,scalable/apps,scalable/categories,scalable/mimetypes,scalable/actions

[scalable/places]
Size=128
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=128
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/categories]
Size=128
MinSize=16
MaxSize=512
Type=Scalable
Context=Categories

[scalable/mimetypes]
Size=128
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/actions]
Size=128
MinSize=16
MaxSize=512
Type=Scalable
Context=Actions

[scalable/status]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status

[scalable/emblems]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Emblems

# ⚠️ OGNI applicazione SkillFishOS deve avere la sua icona QUI DENTRO.
# Il ripiego sul prefisso descritto qui sotto vale per tutte: senza il file
# nel tema, «skillfish-qualcosa» diventa «skillfish» e nel menu escono piu'
# applicazioni con lo stesso pesce, anche se in hicolor l'icona giusta c'e'.
# Il 21/08 e' successo con Telemetria, Gestore Kernel, Remote Manager, Info e AI.
# ⚠️ QUI NON C'E' PIU' IL PESCE DEL PULSANTE DEL MENU.
# C'era, salvato col nome «skillfish-tuner», e il pannello lo otteneva
# chiedendo quel nome. Ha funzionato finche' il Tuner non ha avuto
# un'icona sua: il 21/08 gliel'abbiamo data, e il pulsante del menu si e'
# ritrovato i cursori del Tuner. Ora il pannello chiede «skillfishos» —
# il nome del logo, senza trattini da tagliare — e lo trova nel hicolor
# ereditato. Un nome che dice una cosa e contiene un'altra e' una
# trappola che scatta al primo che tocca l'icona giusta.
# Le misure qui sotto restano quelle del Tuner, che e' quello che sono.
#
# PERCHE' STA QUI E NON SOLO IN hicolor
# Il pannello chiede l'icona per nome, "skillfish-tuner". Quel nome nel tema non
# c'era, e KDE allora taglia dopo l'ultimo trattino e riprova con "skillfish" -
# che nel tema C'E', ed e' il pesce stilizzato con l'ingranaggio. Il tema attivo
# vince su hicolor ereditato, quindi al posto del pesce di ottone usciva quello
# stilizzato: nessun errore da nessuna parte, solo l'icona sbagliata.
# Col nome esatto dentro il tema la ricerca finisce al primo colpo.

[48x48/apps]
Size=48
Type=Fixed
Context=Applications

[64x64/apps]
Size=64
Type=Fixed
Context=Applications

[256x256/apps]
Size=256
MinSize=64
MaxSize=512
Type=Threshold
Context=Applications

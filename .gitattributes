*.mypatch text eol=lf
*.sh text eol=lf
customization.cfg text eol=lf
*.hook.chroot text eol=lf
apps/iso-mount/** text eol=lf
# extension-less Linux executables under apps/ (skillfish-*, *-helper) must stay LF
apps/**/skillfish-* text eol=lf

system/** text=auto eol=lf

# L'albero live-build finisce su una macchina Linux anche per copia diretta,
# non solo con git clone. Con i fine riga di Windows auto/config muore alla
# prima riga (#!/bin/bash seguito da CR) e gli script della ISO escono con lo
# shebang rotto.
iso/** text=auto eol=lf

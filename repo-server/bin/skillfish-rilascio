#!/bin/bash
# SkillFishOS - rilascio di un aggiornamento.
#
# Sta qui, sul container, e non piu' sulla console: indicizzare, firmare e
# caricare non deve piu' rubare la scheda a chi ci sta giocando.
#
#   skillfish-rilascio pacchetto.deb [altri.deb ...]   -> va in "aetherium"
#   skillfish-rilascio --prova pacchetto.deb           -> va in "aetherium-proposed"
#   skillfish-rilascio --dalla-scheda                  -> prende i .deb appena
#                                                        costruiti sulla scheda
#   skillfish-rilascio --pubblica                      -> manda fuori cio' che
#                                                        e' gia' in archivio
#
# Senza --pubblica il repository resta solo qui: e' il modo di provare un
# rilascio prima che lo veda il mondo.
set -u
export LC_ALL=C
ARCHIVIO=/srv/apt
SUITE=aetherium
# Dove sta la macchina che costruisce i pacchetti. Si cambia senza
# toccare lo script:  SKILLFISH_BOARD=1.2.3.4 skillfish-rilascio ...
# Il valore predefinito e' l'indirizzo vero e non un nome .local: quello
# richiede mDNS, che sul container non e' installato, e --dalla-scheda
# falliva prima ancora di provare a collegarsi.
SCHEDA="${SKILLFISH_BOARD:-192.168.5.40}"
PUBBLICA=no
FILE=()
# ⚠️ QUI PASSANO I PACCHETTI CHE POI FIRMIAMO NOI.
# Accettare qualunque chiave significa che chi si mette in mezzo fra questo
# container e la scheda ci fa firmare cio' che vuole, e da quel momento apt lo
# installa a tutti senza un lamento: la firma dice che e' roba nostra.
SSHOPT="-o StrictHostKeyChecking=yes -o ConnectTimeout=15"

while [ $# -gt 0 ]; do
  case "$1" in
    --prova|--proposed)   SUITE=aetherium-proposed ;;
    --pubblica|--publish) PUBBLICA=si ;;
    --dalla-scheda)
        echo "== prendo i .deb dalla scheda ($SCHEDA)"
        mkdir -p /srv/incoming
        preso=no
        motivo=$(mktemp)
        for d in /root/dist-debs/out /root/dist-debs /tmp/sfx-debs/out \
                 /home/root/dist-debs /root/deb-out; do
          # niente -q: spegnerebbe anche la spiegazione del rifiuto
          if scp $SSHOPT "root@$SCHEDA:$d/*.deb" /srv/incoming/ \
                 >/dev/null 2>"$motivo"; then
            echo "   presi da $d"; preso=si; break
          fi
        done
        if [ "$preso" = no ]; then
          if grep -qi "host key\|known_hosts\|Host key verification" "$motivo"; then
            echo "   FERMO: la chiave di $SCHEDA non e' fra quelle conosciute."
            echo "          Non la accetto da solo: e' esattamente il momento in cui"
            echo "          qualcuno potrebbe farsi passare per la scheda."
            echo "          Guardala, confrontala con quella vera, e registrala:"
            echo "              ssh-keyscan -t ed25519 $SCHEDA"
            echo "              ssh-keyscan -t ed25519 $SCHEDA >> ~/.ssh/known_hosts"
          else
            echo "   non trovo i .deb sulla scheda"
            sed 's/^/      /' "$motivo" | head -3
          fi
          rm -f "$motivo"
          exit 1
        fi
        rm -f "$motivo"
        for f in /srv/incoming/*.deb; do FILE+=("$f"); done
        ;;
    -h|--aiuto|--help) sed -n '2,16p' "$0" | cut -c3-; exit 0 ;;
    *.deb) FILE+=("$1") ;;
    *) echo "non so cosa farmene di: $1"; exit 1 ;;
  esac
  shift
done

if [ ${#FILE[@]} -eq 0 ] && [ "$PUBBLICA" = no ]; then
  echo "nessun pacchetto e nessun --pubblica: non c'e' niente da fare"
  echo "aiuto:  skillfish-rilascio --aiuto"
  exit 1
fi

# --- la chiave di firma c'e'? ------------------------------------------------
if [ ${#FILE[@]} -gt 0 ]; then
  if ! gpg --list-secret-keys apt@skillfishos.com >/dev/null 2>&1; then
    echo "ERRORE: qui non c'e' la chiave di firma dell'archivio."
    echo "        Senza quella reprepro non firma, e apt rifiuterebbe tutto."
    exit 1
  fi
fi

# --- inserimento -------------------------------------------------------------
for f in "${FILE[@]}"; do
  n=$(basename "$f")
  p=$(dpkg-deb -f "$f" Package 2>/dev/null)
  v=$(dpkg-deb -f "$f" Version 2>/dev/null)
  if [ -z "$p" ]; then
    echo "   $n non e' un pacchetto valido, lo salto"
    continue
  fi
  # se la stessa versione c'e' gia', reprepro si rifiuta: la tolgo prima
  reprepro -b "$ARCHIVIO" remove "$SUITE" "$p" >/dev/null 2>&1
  if reprepro -b "$ARCHIVIO" includedeb "$SUITE" "$f" >/dev/null 2>&1; then
    echo "   messo: $p $v  ->  $SUITE"
  else
    echo "   FALLITO: $n"
    reprepro -b "$ARCHIVIO" includedeb "$SUITE" "$f" 2>&1 | tail -3 | sed 's/^/      /'
  fi
done

reprepro -b "$ARCHIVIO" --delete clearvanished >/dev/null 2>&1

echo
echo "== archivio ora"
reprepro -b "$ARCHIVIO" list "$SUITE" | sed 's/^/   /'

# --- fuori -------------------------------------------------------------------
if [ "$PUBBLICA" = si ]; then
  echo
  echo "== mando fuori"
  /usr/local/bin/skillfish-carica-ovh || exit 1
else
  echo
  echo "Resta solo qui: http://$(hostname -I | awk '{print $1}')/apt"
  echo "Quando ti convince:  skillfish-rilascio --pubblica"
fi

# --- promemoria: l'altro mirror non si aggiorna da solo ----------------------
# Le ISO scaricano da mtsistemi.github.io, non da qui. Se Pages resta indietro
# si costruiscono immagini coi pacchetti vecchi, e non se ne accorge nessuno
# perche' non c'e' nessun errore: c'e' solo la versione sbagliata.
echo
echo "PROMEMORIA: GitHub Pages NON e' stato aggiornato da questo comando."
echo "            Le ISO scaricano da li'. Per allinearlo, dal portatile:"
echo "                python scripts/sincronizza-ghpages.py"

---
// ⚠️ IL SELETTORE DELLE LINGUE E' UN MENU', NON PIU' UNA FILA DI PULSANTI.
// Con quattro lingue la fila IT EN PL UK ci stava; con russo, spagnolo,
// portoghese e tedesco in arrivo diventerebbe una fila di otto sigle che sul
// telefono manda a capo la barra e a monitor sembra un codice a barre. Il menu'
// mostra una voce sola - la lingua corrente - e apre le altre su richiesta.
//
// E' fatto con <details>, cioe' SENZA JavaScript: la pagina e' statica e deve
// funzionare anche a script bloccati. Le voci restano <a> veri, quindi i motori
// di ricerca li seguono e il tasto centrale del mouse apre in una scheda nuova,
// che con un <select> pilotato da script non succederebbe.
import { t, localePath, languages, langOrder, type Lang } from '../i18n';
import { SITE } from '../i18n';
interface Props { lang: Lang; page?: string; }
const { lang, page = '/' } = Astro.props;
const home = localePath('/', lang);
const active = (p: string) => (page === p || (p === '/docs' && page.startsWith('/docs')) ? 'active' : '');
---
<header>
  <div class="wrap nav">
    <a class="logo" href={home}><img src="/img/logo.png" alt="SkillFishOS"/><span class="brandfont">SkillFish<span class="gold-text">OS</span></span></a>
    <input type="checkbox" id="navtoggle" class="nav-toggle" />
    <label for="navtoggle" class="nav-burger" aria-label="Menu" title="Menu"><span></span><span></span><span></span></label>
    <nav class="navlinks">
      <a href={`${home}#funzioni`}>{t('nav.feat', lang)}</a>
      <a href={localePath('/gallery', lang)} class={active('/gallery')}>{t('nav.gallery', lang)}</a>
      <a href={localePath('/hardware', lang)} class={active('/hardware')}>{t('nav.hw', lang)}</a>
      <a href={localePath('/docs', lang)} class={active('/docs')}>{t('nav.docs', lang)}</a>
      <a href={localePath('/news', lang)} class={active('/news')}>{t('nav.news', lang)}</a>
      <a href={localePath('/roadmap', lang)} class={active('/roadmap')}>{t('nav.road', lang)}</a>
      <a href={localePath('/download', lang)} class={active('/download')}>{t('nav.download', lang)}</a>
      <a href={localePath('/contact', lang)} class={active('/contact')}>{t('nav.contact', lang)}</a>
      <a href={localePath('/donate', lang)} class={`donate-link ${active('/donate')}`}>{t('nav.donate', lang)}</a>
      <a href={SITE.github} target="_blank" rel="noopener">GitHub ↗</a>
    </nav>
    <details class="langmenu">
      <summary aria-label={languages[lang]} title={languages[lang]}>
        <span class="langcode">{lang.toUpperCase()}</span>
        <span class="langname">{languages[lang]}</span>
        <span class="caret" aria-hidden="true">▾</span>
      </summary>
      <ul>
        {langOrder.map((l) => (
          <li>
            <a class={lang === l ? 'active' : undefined} href={localePath(page, l)}
               hreflang={l} lang={l}>
              <span class="langcode">{l.toUpperCase()}</span>
              <span>{languages[l]}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>

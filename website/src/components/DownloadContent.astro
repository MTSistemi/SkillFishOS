---
import { t, localePath, SITE, type Lang } from '../i18n';
import Icona from './Icona.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const hasIso = SITE.isoUrl !== '';
const sizeLine = t('dl.size', lang).replace('{size}', SITE.isoSizeGb);
const issues = `${SITE.github}/issues`;
const donatePage = localePath('/donate', lang);
const comm = [
  { i: 'stella', t: 'comm.star.t', d: 'comm.star.d', btn: 'comm.star.btn', href: SITE.ghStar },
  { i: 'recensione', t: 'comm.review.t', d: 'comm.review.d', btn: 'comm.review.btn', href: SITE.reviews },
  { i: 'idea', t: 'comm.idea.t', d: 'comm.idea.d', btn: 'comm.idea.btn', href: SITE.discussions },
];
---
{/* I torrent sono ritirati finche' non ne pubblichiamo uno della 26.06.4:
    la sezione si disegna solo se l'indirizzo c'e' davvero. */}
{SITE.torrentBc250 && (<>
<section class="hero" style="padding-bottom:30px">
  <div class="wrap">
    <div class="soon"><span class="dot"></span><span>{t('dl.badge', lang)}</span></div>
    <h1 style="font-size:clamp(2.2rem,6vw,4rem)" set:html={t('dl.h2', lang)} />
    <p class="sub" style="margin-bottom:30px">{t('dl.sub', lang)}</p>
    {/* Internet Archive per primo: dall'Europa e' circa dieci volte piu' veloce
        di SourceForge, che serve tutto da San Diego. E' lo stesso file. */}
    <div class="hero-btns">
      {hasIso ? (
        <>
          <a class="btn btn-primary dl-go" href="/go.php?f=ia-bc250" target="_blank" rel="noopener">
            <Icona nome="scarica" dim={20} classe="in-riga" />
            <span set:html={t('dl.fast.bc250', lang)} />
          </a>
          <a class="btn dl-go" href="/go.php?f=ia-generic" target="_blank" rel="noopener">
            <Icona nome="scarica" dim={20} classe="in-riga" />
            <span set:html={t('dl.fast.generic', lang)} />
          </a>
        </>
      ) : (
        <span class="btn btn-primary" style="cursor:default;opacity:.85" set:html={t('dl.btnsoon', lang)} />
      )}
    </div>
    {hasIso && (
      <p class="sub fastnote" set:html={t('dl.fast.sub', lang)} />
    )}
    {hasIso && (
      <div class="altbox">
        <div class="torh">{t('dl.sf.h', lang)}</div>
        <p class="sub tors">{t('dl.sf.sub', lang)}</p>
        <div class="torrow">
          <a class="btn btn-ghost dl-go" href="/go.php?f=bc250" target="_blank" rel="noopener" set:html={t('dl.ed.bc250', lang)} />
          <a class="btn btn-ghost dl-go" href="/go.php?f=generic" target="_blank" rel="noopener" set:html={t('dl.ed.generic', lang)} />
        </div>
      </div>
    )}
    {hasIso && (
      <div class="torbox">
        <div class="torh" set:html={t('dl.tor.h', lang)} />
        <p class="sub tors" set:html={t('dl.tor.sub', lang)} />
        <div class="torrow">
          <a class="btn btn-ghost dl-tor" href="/go.php?f=tor-bc250" set:html={t('dl.tor.bc250', lang)} />
          <a class="magnet" href={SITE.magnetBc250} title="BC-250" data-conta="magnet-bc250">{t('dl.tor.magnet', lang)}</a>
          <a class="btn btn-ghost dl-tor" href="/go.php?f=tor-generic" set:html={t('dl.tor.generic', lang)} />
          <a class="magnet" href={SITE.magnetGeneric} title="Generic" data-conta="magnet-generic">{t('dl.tor.magnet', lang)}</a>
        </div>
      </div>
    )}
    {hasIso && (
      <p class="sub" style="margin-top:14px;font-size:.92rem"><a href="/go.php?f=tutti" target="_blank" rel="noopener" set:html={t('dl.ed.all', lang)} /></p>
    )}
    <div class="pill" style="margin-top:24px">{sizeLine}</div>
    <p class="sub" style="margin-top:14px;font-size:.95rem" set:html={t('dl.ver', lang)} />
    <p class="sub" style="margin-top:24px;color:var(--gold-lt)" set:html={t('dl.notice', lang)} />
  </div>
</section>
</>)}

<section class="features" style="padding-top:30px">
  <div class="wrap">
    <div class="grid">
      <div class="card"><span class="ico"><Icona nome="requisiti" /></span><h3>{t('dl.req.h', lang)}</h3><p set:html={t('dl.req.d', lang)} /></div>
      <div class="card"><span class="ico"><Icona nome="contenuto" /></span><h3>{t('dl.inc.h', lang)}</h3><p set:html={t('dl.inc.d', lang)} /></div>
      <div class="card"><span class="ico"><Icona nome="aggiornamenti" /></span><h3>{t('dl.repo.h', lang)}</h3><p set:html={t('dl.repo.d', lang)} /></div>
    </div>
  </div>
</section>

<section class="cta" style="padding-top:10px">
  <div class="wrap">
    <div class="cta-box">
      <div class="eyebrow">{t('dl.badge', lang)}</div>
      <h2>{t('dl.bugs.h', lang)}</h2>
      <p set:html={t('dl.bugs.d', lang)} />
      <a class="btn btn-primary" href={issues} target="_blank" rel="noopener" set:html={t('dl.bugs.btn', lang)} />
    </div>
  </div>
</section>

<section class="specs" style="padding-top:20px">
  <div class="wrap">
    <div class="sec-head"><h2>{t('dl.steps.h', lang)}</h2></div>
    <div class="chips" style="align-items:stretch">
      <div class="chip" style="max-width:320px;text-align:left"><div class="big">1</div><div class="lbl" set:html={t('dl.step1', lang)} /></div>
      <div class="chip" style="max-width:320px;text-align:left"><div class="big">2</div><div class="lbl" set:html={t('dl.step2', lang)} /></div>
      <div class="chip" style="max-width:320px;text-align:left"><div class="big">3</div><div class="lbl" set:html={t('dl.step3', lang)} /></div>
    </div>
  </div>
</section>

<!-- Support strip: persuasive, right under the downloads -->
<section class="features" style="padding-top:30px">
  <div class="wrap">
    <div class="dl-donate">
      <div class="dl-donate-txt">
        <div class="eyebrow">{t('don.eye', lang)}</div>
        <h2 style="font-size:clamp(1.5rem,3.5vw,2.1rem)">{t('don.give.h', lang)}</h2>
        <p class="muted" set:html={t('don.sub', lang)} />
        <div class="amounts">
          {SITE.donateAmounts.map((a) => (
            <a class="amt" href={`${SITE.donateUrl}/${a}EUR`} target="_blank" rel="noopener">
              <span class="amt-eur">€{a}</span>
            </a>
          ))}
          <a class="amt amt-more" href={donatePage}>{t('don.give.custom', lang)}</a>
        </div>
        <p class="muted" style="font-size:.86rem;margin-top:14px" set:html={t('don.give.note', lang)} />
      </div>
      <a class="dl-qr" href={donatePage} aria-label={t('nav.donate', lang)}>
        <img src={SITE.donateQr} alt="QR PayPal" width="180" height="200" loading="lazy" />
        <span>{t('don.give.scan', lang)} →</span>
      </a>
    </div>
  </div>
</section>

<script define:vars={{ donatePage }}>
  // After starting an ISO download (it opens in a new tab), bring this tab to the Support page.
  document.querySelectorAll('.dl-go').forEach((a) => {
    a.addEventListener('click', () => {
      setTimeout(() => { window.location.href = donatePage; }, 600);
    });
  });

  // A magnet link never reaches our server: the click goes straight to the
  // torrent program. Without this, magnet users are invisible in the stats.
  // The href stays a real magnet, so copying it or opening it in a new tab
  // keeps working; we only send a fire-and-forget ping alongside the click.
  document.querySelectorAll('[data-conta]').forEach((a) => {
    a.addEventListener('click', () => {
      const url = '/go.php?f=' + encodeURIComponent(a.dataset.conta) + '&b=1';
      if (navigator.sendBeacon) navigator.sendBeacon(url);
      else fetch(url, { method: 'POST', keepalive: true }).catch(() => {});
    });
  });
</script>

<!-- Free ways to help -->
<section class="showcase" style="padding:50px 0 70px">
  <div class="wrap">
    <div class="sec-head"><h2>{t('comm.h', lang)}</h2><p>{t('comm.sub', lang)}</p></div>
    <div class="grid">
      {comm.map((c) => (
        <div class="card comm-card">
          <span class="ico"><Icona nome={c.i} /></span>
          <h3>{t(c.t, lang)}</h3>
          <p>{t(c.d, lang)}</p>
          <a class="btn btn-ghost" href={c.href} target="_blank" rel="noopener">{t(c.btn, lang)}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .dl-donate{display:grid;grid-template-columns:1.4fr .7fr;gap:clamp(20px,4vw,42px);align-items:center;
    background:linear-gradient(135deg,rgba(216,168,73,.13),rgba(185,114,47,.06));border:1px solid rgba(216,168,73,.38);
    border-radius:24px;padding:clamp(26px,4vw,44px)}
  .dl-donate .muted{color:var(--muted);margin:10px 0 18px;max-width:60ch}
  .dl-donate .amounts{display:flex;gap:12px;flex-wrap:wrap}
  .dl-donate .amt{padding:12px 22px;border-radius:13px;background:linear-gradient(160deg,var(--panel),var(--panel2));
    border:1px solid var(--line);transition:transform .15s,border-color .25s,box-shadow .25s}
  .dl-donate .amt:hover{transform:translateY(-3px);border-color:rgba(216,168,73,.6);box-shadow:0 12px 28px rgba(0,0,0,.4)}
  .dl-donate .amt-eur{font-family:'Sora','Inter',sans-serif;font-weight:800;font-size:1.35rem;color:var(--gold-lt)}
  .dl-donate .amt-more{display:grid;place-items:center;font-size:1.2rem}
  .dl-qr{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;color:var(--muted);font-size:.86rem}
  .dl-qr img{width:170px;max-width:60vw;border-radius:14px;background:#fff;padding:8px;border:1px solid rgba(216,168,73,.3);
    box-shadow:0 12px 30px rgba(0,0,0,.4);transition:transform .2s}
  .dl-qr:hover img{transform:scale(1.04)}
  .dl-qr span{color:var(--gold-lt)}
  .comm-card{display:flex;flex-direction:column;align-items:flex-start}
  .comm-card p{flex:1;margin-bottom:18px;color:var(--muted)}
  @media(max-width:760px){.dl-donate{grid-template-columns:1fr;text-align:center}.dl-donate .muted{margin-left:auto;margin-right:auto}.dl-donate .amounts{justify-content:center}.dl-qr{order:-1}}
</style>

<style>
  /* La nota sotto ai pulsanti principali: spiega perche' consigliamo
     Internet Archive, con i numeri misurati invece che con un aggettivo. */
  .fastnote{max-width:640px;margin:14px auto 0;font-size:.92rem}

  /* SourceForge e il torrent sono alternative, non l'opzione principale:
     stanno sotto, con un contorno leggero invece che in evidenza. */
  .altbox,
  .torbox{margin:26px auto 0;max-width:640px;padding:18px 20px;border:1px solid rgba(216,168,73,.22);border-radius:12px;background:rgba(255,255,255,.02)}
  .altbox .torh{color:var(--gold-lt);font-weight:700;margin-bottom:6px}
  .torh{color:var(--gold-lt);font-weight:700;margin-bottom:6px}
  .tors{font-size:.9rem;margin:0 auto 14px;max-width:560px}
  .torrow{display:flex;gap:10px;justify-content:center;align-items:center;flex-wrap:wrap}
  .torrow .btn{padding:9px 16px;font-size:.9rem}
  .magnet{font-size:.82rem;color:var(--muted);border-bottom:1px dotted rgba(216,168,73,.5);padding-bottom:1px}
  .magnet:hover{color:var(--gold-lt)}
</style>

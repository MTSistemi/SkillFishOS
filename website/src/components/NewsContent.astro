---
// La roadmap stava qui sotto, e adesso ha una pagina sua (RoadmapContent):
// questa resta la pagina di cosa è cambiato, e rimanda là per cosa arriva.
import { t, type Lang } from '../i18n';
import { news, pick } from '../news';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<section class="hero" style="padding-bottom:24px">
  <div class="wrap">
    <div class="soon"><span class="dot"></span><span>{t('news.eye', lang)}</span></div>
    <h1 style="font-size:clamp(2.1rem,5.5vw,3.6rem)" set:html={t('news.h1', lang)} />
    <p class="sub" style="max-width:720px" set:html={t('news.sub', lang)} />
  </div>
</section>

<section class="features" style="padding-top:10px">
  <div class="wrap">
    <h2 class="sec-title" set:html={t('news.h.news', lang)} />

    <div class="newslist">
      {news.map((p) => (
        <article class="newsitem">
          <div class="newsmeta">
            <time datetime={p.data}>{pick(p.quando, lang)}</time>
            {p.etichetta && <span class="newstag">{pick(p.etichetta, lang)}</span>}
          </div>
          <h3 set:html={pick(p.titolo, lang)} />
          <p set:html={pick(p.testo, lang)} />
        </article>
      ))}
    </div>

    <p class="sub" style="margin-top:36px;max-width:720px" set:html={t('news.diroad', lang)} />
    <p class="sub" style="margin-top:10px;max-width:720px" set:html={t('news.foot', lang)} />
  </div>
</section>

<style>
  .newslist { display: grid; gap: 18px; margin-top: 24px; }
  .newsitem {
    border: 1px solid rgba(216,168,73,.22);
    border-radius: 12px;
    padding: 20px 22px;
    background: rgba(255,255,255,.02);
  }
  .newsitem h3 { margin: 6px 0 10px; font-size: 1.16rem; color: var(--gold-lt); }
  .newsitem p { margin: 0; line-height: 1.65; opacity: .92; }
  .newsmeta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .newsmeta time { font-size: .82rem; opacity: .7; letter-spacing: .3px; }
  .newstag {
    font-size: .72rem; text-transform: uppercase; letter-spacing: .6px;
    padding: 2px 8px; border-radius: 999px;
    border: 1px solid rgba(216,168,73,.35); color: var(--gold-lt);
  }
  @media (min-width: 900px) {
    .newslist { grid-template-columns: 1fr 1fr; }
    .newsitem:first-child { grid-column: 1 / -1; }
  }
</style>

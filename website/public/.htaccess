# SkillFishOS — Apache config (OVH shared hosting)

RewriteEngine On

# Masked ISO download: skillfishos.com/dl/<name> -> Dropbox direct download (dl=1).
# Keeps the public-facing URL on our own domain; QSD discards any incoming query string.
# (Full proxy-masking of a 5.6 GB file isn't feasible on shared hosting, so this is a 302.)

# 26.06.4 "Aetherium" — current release (2 editions), hosted on SourceForge.
# ⚠️ 26.06, .1, .2 e .3 sono state RITIRATE: contenevano file privati della
#    macchina di costruzione. I loro collegamenti brevi puntano alla 26.06.4.
RewriteRule ^dl/SkillFishOS-26\.06\.4-Aetherium-BC250-amd64\.iso$ https://sourceforge.net/projects/skillfishos/files/26.06.4-Aetherium/SkillFishOS-26.06.4-Aetherium-BC250-amd64.iso/download [R=302,L,QSD]
RewriteRule ^dl/SkillFishOS-26\.06\.4-Aetherium-Generic-amd64\.iso$ https://sourceforge.net/projects/skillfishos/files/26.06.4-Aetherium/SkillFishOS-26.06.4-Aetherium-Generic-amd64.iso/download [R=302,L,QSD]

# back-compat: bare BC-250 short link keeps working, now points at 26.06.4
RewriteRule ^dl/SkillFishOS-26\.06-Aetherium-BC250-amd64\.iso$ https://sourceforge.net/projects/skillfishos/files/26.06.4-Aetherium/SkillFishOS-26.06.4-Aetherium-BC250-amd64.iso/download [R=302,L,QSD]

# stable alias (always points at the latest SourceForge default download)
RewriteRule ^dl/skillfishos-latest\.iso$ https://sourceforge.net/projects/skillfishos/files/latest/download [R=302,L,QSD]

# legacy preview (kept for old links)
RewriteRule ^dl/skillfishos-preview\.iso$ https://www.dropbox.com/scl/fi/ppnob3ia0x5gnbbuw3o29/SkillFishOs-Preview.iso?rlkey=29nckgkils1pp0p703mthx6z5&dl=1 [R=302,L,QSD]

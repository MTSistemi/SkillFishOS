#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""SkillFishOS - what to install, and what the machine is doing about it.

Two pages. The first asks what the user wants; the second shows it being
downloaded, one bar per application.

WHY THIS WINDOW EXISTS
A freshly installed system has no Steam, no browser and no emulator: they are
Flatpaks, about six gigabytes, and they are not in the image. Until 12/09/2026
a fixed list of them was downloaded in complete silence at first boot, so the
first impression of SkillFishOS was a desktop with nothing in the menu and no
way to tell whether anything was happening. Somebody would reasonably conclude
the install had failed.

And the list was fixed: everybody got Chrome whether they wanted it or not. One
user said so out loud, and he was right.

⚠️ THIS WINDOW DOES NOT INSTALL ANYTHING. The work is done by
skillfish-firstboot-flatpaks.service, as root. This only writes down what was
chosen (through the helper, via pkexec) and then reads the status file the
service writes. A window that a user can close must never be the thing that
decides whether the system finishes setting itself up.
"""
import json
import os
import subprocess
import sys

from PyQt6.QtCore import Qt, QTimer
from PyQt6.QtGui import QIcon, QPixmap
from PyQt6.QtWidgets import (QApplication, QCheckBox, QFrame, QHBoxLayout,
                             QLabel, QMessageBox, QProgressBar, QPushButton,
                             QScrollArea, QStackedWidget,
                             QVBoxLayout, QWidget)

sys.path.insert(0, "/usr/share/skillfish")
try:
    from i18n import L
except Exception:                                        # pragma: no cover
    def L(it, en):
        return it if (os.environ.get("LANG", "") or "").startswith("it") else en


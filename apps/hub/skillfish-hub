                      if x.pkgid == chiesta or x.appid == chiesta), None)
            if a:
                self.open_app(a)
            else:
                # non trovata per nome esatto: meglio la ricerca che una
                # finestra vuota senza spiegazioni
                self.search.setText(chiesta)

            hdr.setStyleSheet("color:#e8c878;font-weight:600;"); fv.addWidget(hdr)
            bd = QLabel(html.escape(rv.get("description", ""))); bd.setWordWrap(True); bd.setStyleSheet("color:#d9c8a8;font-size:12px;"); fv.addWidget(bd)

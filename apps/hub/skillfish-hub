    # ---------- operations ----------
    def do_op(self, app, action):
        # ⚠️ Per APT si passa sempre dalla transazione staccata: un'installazione
        # o una rimozione interrotta a meta' lascia dpkg da riparare a mano, e
        # a interromperla basta che questa finestra muoia. Flatpak e snap no:
        # li' un'interruzione al massimo lascia un file da riscaricare.
        if app.backend == "apt":
            azione = "installa" if action == "install" else "rimuovi"
            verbo = (L("Installazione", "Installing") if action == "install"
                     else L("Rimozione", "Removing"))
            self._avvia_transazione(azione, [app.pkgid], "%s %s…" % (verbo, app.name))
            return
        if action == "install":
            argv = self._install_cmd(app); verb = L("Installazione", "Installing")
        else:
            argv = self._remove_cmd(app); verb = L("Rimozione", "Removing")
        if not argv:
            self.statusBar().showMessage(L("Backend non supportato: ", "Unsupported backend: ") + app.backend, 5000); return
        self._run_op(argv, "%s %s…" % (verb, app.name))

    # L'AMBITO DEI FLATPAK VA DETTO SEMPRE.
    #
    # Qui c'era `flatpak install -y --noninteractive flathub <id>`, senza
    # --system ne' --user. Su questa macchina flathub e' configurato in
    # ENTRAMBI gli ambiti, e flatpak si rifiuta:
    #
    #   error: Remote 'flathub' found in multiple installations,
    #          unable to proceed in non-interactive mode
    #
    # Non poteva nemmeno chiedere all'utente quale usare, perche'
    # --noninteractive glielo vieta. Risultato: nessuna installazione dall'Hub
    # funzionava, e l'errore non era ovvio perche' parla di "installations"
    # intendendo gli ambiti di flatpak, non i programmi.
    #
    # Si installa a SISTEMA, come gia' si fa per apt e snap: e' un centro
    # software di macchina, non del singolo utente, e cosi' l'app la vedono
    # tutti. Serve pkexec, esattamente come per gli altri due backend.
    def _install_cmd(self, app):
        if app.backend == "apt": return ["pkexec", HELPER, "apt-install", app.pkgid]
        if app.backend == "flatpak":
            return ["pkexec", "flatpak", "install", "-y", "--noninteractive",
                    "--system", "flathub", app.pkgid]
        if app.backend == "snap":
            ch = getattr(self, "_snap_channel", None)
            return ["pkexec", "snap", "install", app.pkgid] + (["--channel", ch] if ch else [])
        return None

    def _flatpak_scope(self, pkgid):
        """Dove e' installato davvero: --user o --system.

        Non si puo' rimuovere sempre da --system: sulla scheda ci sono 9 app
        installate per utente (le ha messe EmuDeck) e 6 a sistema. Disinstallare
        con l'ambito sbagliato fallisce dicendo che l'app non e' installata,
        che per chi guarda e' semplicemente falso.
        """
        rc, _, _ = run(["flatpak", "info", "--user", pkgid], 10)
        return "--user" if rc == 0 else "--system"

    def _remove_cmd(self, app):
        if app.backend == "apt": return ["pkexec", HELPER, "apt-remove", app.pkgid]
        if app.backend == "flatpak":
            scope = self._flatpak_scope(app.pkgid)
            argv = ["flatpak", "uninstall", "-y", "--noninteractive", scope, app.pkgid]
            # per l'ambito utente non serve nessun privilegio, e chiederlo
            # sarebbe solo una richiesta di password in piu' senza motivo
            return argv if scope == "--user" else ["pkexec"] + argv
        if app.backend == "snap": return ["pkexec", "snap", "remove", app.pkgid]
        return None

    def _run_op(self, argv, title):
        dlg = QDialog(self); dlg.setWindowTitle("SkillFishOS Hub"); dlg.resize(660, 440)
        v = QVBoxLayout(dlg); v.addWidget(QLabel(title))
        log = QPlainTextEdit(); log.setReadOnly(True); v.addWidget(log)
        bar = QProgressBar(); bar.setRange(0, 0); v.addWidget(bar)
        cb = QPushButton(L("Chiudi", "Close")); cb.setEnabled(False); cb.clicked.connect(dlg.accept); v.addWidget(cb)
        self._op = Op(argv); self._op.line.connect(log.appendPlainText)
        self._op.pct.connect(lambda p: (bar.setRange(0, 100), bar.setValue(p)))
        def fin(rc):
            bar.setRange(0, 100); bar.setValue(100); cb.setEnabled(True)
            log.appendPlainText("\n" + (L("✓ Completato.", "✓ Done.") if rc == 0 else L("! Operazione fallita (rc=%d)", "! Operation failed (rc=%d)") % rc))
            self.reload_catalog()
        self._op.done.connect(fin); self._op.start(); dlg.exec()


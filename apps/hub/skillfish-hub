class Carousel(QWidget):
    """Discover-style screenshot carousel: one big image with prev/next + dots."""
    def __init__(self, urls, height=400):
        super().__init__()
        self.urls = list(urls); self.idx = 0; self.pms = {}; self.H = height
        v = QVBoxLayout(self); v.setContentsMargins(0, 0, 0, 0); v.setSpacing(8)
        row = QHBoxLayout(); row.setSpacing(8)
        arrow = ("QToolButton{color:#e8c878;background:rgba(216,168,73,0.12);border:none;border-radius:20px;"
                 "font-size:24px;min-width:40px;min-height:40px;}QToolButton:hover{background:rgba(216,168,73,0.30);}")
        self.b_prev = QToolButton(); self.b_prev.setText("‹"); self.b_prev.setCursor(Qt.CursorShape.PointingHandCursor); self.b_prev.setStyleSheet(arrow); self.b_prev.clicked.connect(self.prev)
        self.img = QLabel(); self.img.setFixedHeight(height); self.img.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.img.setStyleSheet("background:#100c06;border:1px solid rgba(216,168,73,0.16);border-radius:12px;color:#8a7a55;")
        self.img.setText(L("Caricamento screenshot…", "Loading screenshots…"))
        self.b_next = QToolButton(); self.b_next.setText("›"); self.b_next.setCursor(Qt.CursorShape.PointingHandCursor); self.b_next.setStyleSheet(arrow); self.b_next.clicked.connect(self.next)
        row.addWidget(self.b_prev); row.addWidget(self.img, 1); row.addWidget(self.b_next); v.addLayout(row)
        self.dots = QLabel(); self.dots.setAlignment(Qt.AlignmentFlag.AlignCenter); self.dots.setStyleSheet("color:#d8a849;font-size:15px;letter-spacing:4px;background:transparent;"); v.addWidget(self.dots)
        self._ld = ImgLoad(self.urls); self._ld.ready.connect(self._got); self._ld.start()
        self._update()
    def _got(self, i, pm):
        self.pms[i] = pm
        if i == self.idx: self._update()
        else: self._dots()
    def prev(self): self.idx = (self.idx - 1) % max(1, len(self.urls)); self._update()
    def next(self): self.idx = (self.idx + 1) % max(1, len(self.urls)); self._update()
    def _update(self):
        pm = self.pms.get(self.idx)
        if pm and not pm.isNull(): self.img.setPixmap(pm.scaledToHeight(self.H, Qt.TransformationMode.SmoothTransformation))
        single = len(self.urls) <= 1
        self.b_prev.setVisible(not single); self.b_next.setVisible(not single); self._dots()
    def _dots(self):
        self.dots.setText("" if len(self.urls) <= 1 else "  ".join("●" if i == self.idx else "○" for i in range(len(self.urls))))


# ======================= QUELLO CHE CI HANNO CHIESTO DI APRIRE =======================
# ⚠️ Discover era il gestore di .deb, .flatpakref, .flatpakrepo e dei link
# appstream:// e apt://. Togliendolo senza mettere questo, un doppio clic su un
# pacchetto scaricato o su un pulsante «installa» di Flathub non aprirebbe piu'
# niente — e non e' un errore che l'utente riesce a collegare a noi: gli si
# rompe il doppio clic, e basta.
#
# ⚠️ QUI NON SI INSTALLA NIENTE. Si capisce COSA ci hanno passato e lo si
# racconta all'utente; a installare e' la solita transazione staccata, dopo un
# si' esplicito. Un file arrivato da fuori che si installa da solo perche' ci
# hanno cliccato sopra e' esattamente il modo in cui si prende un pacchetto
# malevolo.
BERSAGLI = {
    ".deb": "deb",
    ".flatpakref": "flatpakref",
    ".flatpakrepo": "flatpakrepo",
    ".flatpak": "flatpakbundle",
}


def bersaglio(argomenti):
    u"""(tipo, valore) di cio' che ci hanno passato, o None.

    Accetta un percorso, un file:// (KDE passa quello) e i due schemi che
    gestiva Discover. ⚠️ Il file deve esistere ed essere un file normale: un
    percorso inventato, una cartella o un dispositivo non devono arrivare
    all'helper, che gira da root.
    """
    for a in (argomenti or []):
        if not a or a.startswith("-"):
            continue
        if a.startswith("appstream://"):
            return ("app", a[len("appstream://"):].strip("/ "))
        if a.startswith("apt://"):
            return ("app", a[len("apt://"):].strip("/ "))
        percorso = a
        if percorso.startswith("file://"):
            percorso = urllib.parse.unquote(urllib.parse.urlparse(percorso).path)
        percorso = os.path.abspath(os.path.expanduser(percorso))
        tipo = BERSAGLI.get(os.path.splitext(percorso)[1].lower())
        if tipo and os.path.isfile(percorso):
            return (tipo, percorso)
    return None


def _ini(percorso):
    u"""Le chiavi di un .flatpakref o .flatpakrepo, che sono file ini."""
    fuori = {}
    try:
        with open(percorso, encoding="utf-8", errors="replace") as f:
            for riga in f:
                if "=" in riga and not riga.lstrip().startswith(("#", "[")):
                    k, v = riga.split("=", 1)
                    fuori[k.strip()] = v.strip()
    except OSError:
        pass
    return fuori


def descrivi(tipo, percorso):
    u"""Che cosa sto per installare: nome, versione, provenienza.

    Serve perche' la domanda «vuoi installarlo?» abbia una risposta possibile.
    Chiedere su un nome di file non e' chiedere: e' far premere Si'.
    """
    nome = os.path.basename(percorso)
    righe = []
    if tipo == "deb":
        rc, out, _ = run(["dpkg-deb", "-W", "--showformat",
                          "${Package}\\n${Version}\\n${Architecture}\\n${Installed-Size}\\n${Maintainer}",
                          percorso], 20)
        if rc == 0:
            campi = (out or "").split("\n")
            while len(campi) < 5:
                campi.append("")
            nome = campi[0] or nome
            righe = [
                (L("Versione", "Version"), campi[1]),
                (L("Architettura", "Architecture"), campi[2]),
                (L("Spazio occupato", "Installed size"),
                 ("%s kB" % campi[3]) if campi[3].isdigit() else campi[3]),
                (L("Chi lo mantiene", "Maintainer"), campi[4]),
            ]
    elif tipo in ("flatpakref", "flatpakrepo"):
        d = _ini(percorso)
        nome = d.get("Name") or d.get("Title") or nome
        righe = [(L("Origine", "Origin"), d.get("Url") or d.get("RuntimeRepo") or "—")]
        if d.get("Title"):
            righe.insert(0, (L("Repository", "Repository"), d["Title"]))
    elif tipo == "flatpakbundle":
        try:
            righe = [(L("Dimensione", "Size"),
                      "%.1f MiB" % (os.path.getsize(percorso) / 1048576.0))]
        except OSError:
            pass
    return nome, righe


def avviso_bersaglio(tipo):
    u"""⚠️ Un file preso da fuori non e' un pacchetto dei nostri repository.

    Nessuna delle nostre chiavi lo ha firmato: chi lo installa si fida di chi
    glielo ha dato. Dirlo non e' burocrazia — e' l'unica differenza che conta
    fra installare dall'Hub e installare un file trovato in giro, e l'utente
    non ha modo di saperlo se non glielo diciamo qui.
    """
    if tipo == "flatpakrepo":
        return L("Stai aggiungendo una fonte di software nuova. Da quel momento "
                 "quello che arriva da lì viene installato come il resto: "
                 "aggiungila solo se sai di chi è.",
                 "You are adding a new source of software. From then on what comes "
                 "from it is installed like everything else: add it only if you "
                 "know whose it is.")
    return L("Questo file non viene dai nostri repository e nessuna delle nostre "
             "chiavi lo ha firmato: installandolo ti fidi di chi te lo ha dato.",
             "This file does not come from our repositories and none of our keys "
             "signed it: by installing it you are trusting whoever gave it to you.")


POLKIT_DIR = "/usr/share/polkit-1/actions"


def permessi_apt(pkgid, appid=""):
    u"""Le autorizzazioni che questo pacchetto dichiara a polkit.

    ⚠️ Si guarda quali file di politica il PACCHETTO installa, non quali
    contengono il suo nome: e' l'unico legame vero fra un .deb e le
    autorizzazioni che chiede, e non si sbaglia con i nomi che si somigliano.
    """
    if not pkgid:
        return ""
    rc, out, _ = run(["dpkg", "-L", pkgid], 12)
    if rc != 0:
        return ""
    politiche = [r.strip() for r in out.splitlines()
                 if r.strip().startswith(POLKIT_DIR) and r.strip().endswith(".policy")]
    if not politiche:
        return ""
    fuori = []
    for p in politiche:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                testo = f.read()
        except OSError:
            continue
        for azione in re.findall(r'<action id="[^"]*">(.*?)</action>', testo, re.S):
            # la descrizione nella lingua dell'utente, se c'e'
            d = (re.search(r'<description xml:lang="%s">(.*?)</description>' % LANG, azione, re.S)
                 or re.search(r'<description>(.*?)</description>', azione, re.S))
            if not d:
                continue
            regola = re.search(r'<allow_active>(.*?)</allow_active>', azione)
            regola = (regola.group(1).strip() if regola else "")
            come = {
                "yes": L("senza chiedere niente", "without asking"),
                "auth_admin": L("chiede la password ogni volta", "asks for the password every time"),
                "auth_admin_keep": L("chiede la password una volta per sessione",
                                     "asks for the password once per session"),
                "auth_self": L("chiede la tua password", "asks for your password"),
                "auth_self_keep": L("chiede la tua password una volta per sessione",
                                    "asks for your password once per session"),
                "no": L("non e' permesso", "not allowed"),
            }.get(regola, regola)
            testo_d = re.sub(r'\s+', " ", d.group(1)).strip()
            fuori.append("• %s — %s" % (testo_d, come) if come else "• " + testo_d)
    return "\n".join(fuori)


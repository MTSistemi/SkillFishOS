class Worker(QThread):
    done = pyqtSignal(object)
    def __init__(self, fn): super().__init__(); self.fn = fn
    def run(self):
        try: self.done.emit(self.fn())
        except Exception: self.done.emit(None)

class Op(QThread):
    line = pyqtSignal(str); pct = pyqtSignal(int); done = pyqtSignal(int)
    def __init__(self, argv, t=3600): super().__init__(); self.argv = argv; self.t = t
    def run(self):
        try:
            p = subprocess.Popen(self.argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
            for ln in iter(p.stdout.readline, ""):
                if not ln: continue
                self.line.emit(ln.rstrip())
                m = re.search(r'(\d{1,3})%', ln)
                if m:
                    v = int(m.group(1))
                    if 0 <= v <= 100: self.pct.emit(v)
            p.wait(self.t); self.done.emit(p.returncode)
        except Exception as e:
            self.line.emit(str(e)); self.done.emit(1)

class ImgLoad(QThread):
    ready = pyqtSignal(int, QPixmap)
    def __init__(self, urls): super().__init__(); self.urls = urls
    def run(self):
        os.makedirs(CACHE_DIR, exist_ok=True)
        for i, url in enumerate(self.urls):
            pm = QPixmap()
            try:
                if url.startswith("http"):
                    cf = os.path.join(CACHE_DIR, hashlib.sha1(url.encode()).hexdigest() + ".img")
                    if not os.path.exists(cf):
                        req = urllib.request.Request(url, headers={"User-Agent": "SkillFishOS-Hub"})
                        with urllib.request.urlopen(req, timeout=20) as r, open(cf, "wb") as o:
                            o.write(r.read())
                    pm.load(cf)
                elif os.path.exists(url):
                    pm.load(url)
            except Exception:
                pm = QPixmap()
            if not pm.isNull():
                self.ready.emit(i, pm)


# ============================ LA TRANSAZIONE ============================
# ⚠️ L'AGGIORNAMENTO NON E' PIU' FIGLIO DELLA FINESTRA.
# Prima l'apt girava come processo figlio dell'Hub, con l'uscita in una pipe:
# bastava che la finestra morisse perche' la pipe si chiudesse e l'apt se ne
# andasse a meta' strada, con dpkg in mezzo al guado. E la finestra muore
# facile, perche' l'aggiornamento sostituisce sotto di lei le librerie Qt —
# quando non aggiorna l'Hub stesso.
# Ora il lavoro sta in una unita' systemd transitoria che non e' figlia di
# nessuno: qui si LEGGE il suo registro. Chiudere la finestra non ferma niente,
# e riaprendo l'Hub ci si riattacca a quello che sta girando.
STATO_DIR = "/var/lib/skillfish/hub"
TX_LOG = os.path.join(STATO_DIR, "tx.log")
TX_JSON = os.path.join(STATO_DIR, "tx.json")
CONTEGGIO = os.path.join(STATO_DIR, "updates.json")


def _leggi_json(percorso):
    try:
        with open(percorso) as f:
            return json.load(f)
    except Exception:
        return {}


def tx_stato():
    u"""Che sta facendo la transazione: {} se non ce n'e' mai stata una."""
    return _leggi_json(TX_JSON)


def tx_in_corso():
    return tx_stato().get("stato") == "in-corso"


def tx_avvia(azione, *argomenti):
    u"""Chiede all'helper di avviarla. Torna (ok, messaggio).

    Non aspetta la fine — sarebbe il contrario di tutto questo: torna appena la
    transazione e' partita, e a seguirla ci pensa la finestra.
    """
    porta = LOCALE if azione in DA_FUORI else HELPER
    rc, out, err = run(["pkexec", porta, "tx-start", azione] + list(argomenti), 120)
    if rc == 3:   # ne sta gia' girando una: ci si attacca a quella
        return True, ""
    return rc == 0, (err or out).strip()


def conteggio():
    u"""Quanti aggiornamenti aveva contato l'ultimo giro del timer."""
    return _leggi_json(CONTEGGIO)


class SeguiTransazione(QDialog):
    u"""Guarda una transazione che gira per conto suo.

    Non lancia niente e non uccide niente: apre il registro, legge i byte
    aggiunti da quando ha guardato l'ultima volta e li mostra. Per questo il
    pulsante «Chiudi» e' attivo da subito — chiudere la finestra qui non ha
    nessun effetto sull'aggiornamento, ed e' il motivo per cui l'abbiamo
    staccato.
    """
    def __init__(self, parent, titolo, alla_fine=None):
        super().__init__(parent)
        self.setWindowTitle("SkillFishOS Hub")
        self.resize(720, 470)
        self._alla_fine = alla_fine
        self._pos = 0
        v = QVBoxLayout(self)
        t = QLabel(titolo)
        t.setStyleSheet("color:#e8c878;font-size:15px;font-weight:700;")
        v.addWidget(t)
        nota = QLabel(L("Puoi chiudere questa finestra: l'aggiornamento va avanti "
                        "per conto suo e lo ritrovi qui riaprendo l'Hub.",
                        "You can close this window: the update carries on by "
                        "itself, and you will find it here when you reopen the Hub."))
        nota.setWordWrap(True)
        nota.setStyleSheet("color:#b9a07a;font-size:12px;")
        v.addWidget(nota)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setStyleSheet("QPlainTextEdit{background:#120f0a;color:#d9c8a8;"
                               "border:1px solid rgba(216,168,73,0.18);border-radius:8px;}")
        v.addWidget(self.log)
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        v.addWidget(self.bar)
        self.chiudi = QPushButton(L("Chiudi", "Close"))
        self.chiudi.clicked.connect(self.accept)
        v.addWidget(self.chiudi)
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._giro)
        self._timer.start(400)
        self._giro()

    def _giro(self):
        try:
            dimensione = os.path.getsize(TX_LOG)
        except OSError:
            dimensione = 0
        # ⚠️ Il registro viene azzerato all'inizio di ogni transazione: se e'
        # piu' corto di dove eravamo arrivati, e' una transazione NUOVA e si
        # riparte da capo. Senza questo controllo non si vedrebbe piu' niente.
        if dimensione < self._pos:
            self._pos = 0
            self.log.clear()
        if dimensione > self._pos:
            try:
                with open(TX_LOG, "rb") as f:
                    f.seek(self._pos)
                    dati = f.read()
                    self._pos = f.tell()
            except OSError:
                dati = b""
            if dati:
                testo = dati.decode("utf-8", "replace").rstrip("\n")
                if testo:
                    self.log.appendPlainText(testo)
                    m = None
                    for m in re.finditer(r'(\d{1,3})%', testo):
                        pass
                    if m:
                        v = int(m.group(1))
                        if 0 <= v <= 100:
                            self.bar.setRange(0, 100)
                            self.bar.setValue(v)
        st = tx_stato()
        if st.get("stato") == "finita":
            self._timer.stop()
            self.bar.setRange(0, 100)
            self.bar.setValue(100)
            rc = st.get("rc")
            self.log.appendPlainText(
                "\n" + (L("✓ Completato.", "✓ Done.") if rc in (0, "0")
                        else L("! Non riuscito (rc=%s)", "! Failed (rc=%s)") % rc))
            if self._alla_fine:
                self._alla_fine(rc)
                self._alla_fine = None


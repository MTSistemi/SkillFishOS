        self._chanrow.addWidget(lab); self._chanrow.addWidget(cb); self._chanrow.addStretch(1)

    def _permissions(self, app):
        try:
            if app.backend == "flatpak":
                rc, out, _ = run(["flatpak", "info", "--show-permissions", app.pkgid], 12) if app.installed else (1, "", "")
                if rc != 0:
                    # Anche qui va detto l'ambito: nominare "flathub" quando il
                    # remote esiste sia a sistema sia per utente fa fallire il
                    # comando con "No remote chosen to resolve 'flathub' which
                    # exists in multiple installations", e la scheda dell'app
                    # restava senza l'elenco dei permessi.
                    rc, out, _ = run(["flatpak", "remote-info", "--system",
                                      "--show-metadata", "flathub", app.pkgid], 20)
                share = re.search(r'shared=([^\n]+)', out); sock = re.search(r'sockets=([^\n]+)', out)
                dev = re.search(r'devices=([^\n]+)', out); fs = re.search(r'filesystems=([^\n]+)', out)
                bits = []
                if share: bits.append(L("rete/ipc: ", "network/ipc: ") + share.group(1).strip())
                if sock: bits.append(L("socket: ", "sockets: ") + sock.group(1).strip())
                if dev: bits.append(L("dispositivi: ", "devices: ") + dev.group(1).strip())
                if fs: bits.append(L("filesystem: ", "filesystem: ") + fs.group(1).strip()[:120])
                return "  ·  ".join(bits)
            if app.backend == "snap":
                c = app.confinement or "strict"
                return L("Confinamento: %s", "Confinement: %s") % c
            if app.backend == "apt":
                # Un .deb non dichiara permessi come un Flatpak, ma se ha
                # bisogno di root lo dichiara a polkit: quelle sono le sue
                # autorizzazioni, e sono gia' scritte e tradotte.
                return permessi_apt(app.pkgid, app.appid)
        except Exception:
            return ""
        return ""

    def scrivi_recensione(self, app):
        u"""Le stelle e due righe di testo, e li manda a ODRS.

        ⚠️ QUELLO CHE SI SCRIVE QUI DIVENTA PUBBLICO. ODRS e' l'archivio comune
        delle recensioni (lo stesso che legge GNOME Software), non un quaderno
        locale: una volta spedita, la recensione la leggono tutti. La finestra
        lo dice prima di far premere il pulsante, perche' dopo e' tardi.

        ⚠️ E NON SI MANDA NIENTE CHE IDENTIFICHI LA MACCHINA. L'identificativo
        richiesto dal servizio e' una impronta, la stessa che gia' si usa per
        leggere le recensioni: serve solo perche' ODRS sappia riconoscere due
        voti della stessa persona.
        """
        dlg = QDialog(self)
        dlg.setWindowTitle("SkillFishOS Hub")
        dlg.setMinimumWidth(560)
        v = QVBoxLayout(dlg)
        t = QLabel(L("La tua recensione di %s", "Your review of %s") % app.name)
        t.setStyleSheet("color:#e8c878;font-size:16px;font-weight:700;")
        v.addWidget(t)

        # le stelle: si cliccano, e quella scelta resta accesa
        stelle = {"n": 0}
        rs = QHBoxLayout()
        rs.setSpacing(2)
        bottoni = []
        def ridisegna():
            for i, b in enumerate(bottoni):
                b.setText("★" if i < stelle["n"] else "☆")
        def scegli(i):
            stelle["n"] = i + 1
            ridisegna()
        for i in range(5):
            b = QToolButton()
            b.setText("☆")
            b.setStyleSheet("QToolButton{color:#e8c878;font-size:26px;border:none;background:transparent;}")
            b.setCursor(Qt.CursorShape.PointingHandCursor)
            b.clicked.connect(lambda _c=False, k=i: scegli(k))
            bottoni.append(b)
            rs.addWidget(b)
        rs.addStretch(1)
        rw = QWidget(); rw.setLayout(rs); v.addWidget(rw)

        titolo = QLineEdit()
        titolo.setPlaceholderText(L("In una riga: com'e'?", "In one line: what is it like?"))
        v.addWidget(titolo)
        corpo = QPlainTextEdit()
        corpo.setPlaceholderText(L("Cosa fa bene, cosa no, su che macchina.",
                                   "What it does well, what it does not, on which machine."))
        corpo.setFixedHeight(120)
        v.addWidget(corpo)
        nome = QLineEdit()
        nome.setText(os.environ.get("USER", "") or "anon")
        nome.setPlaceholderText(L("Come vuoi firmarti", "How you want to sign it"))
        v.addWidget(nome)

        av = QLabel(L("Va nell'archivio pubblico delle recensioni (ODRS), quello che "
                      "leggono anche gli altri programmi: la vedranno tutti, e non si "
                      "cancella da qui.",
                      "This goes to the public review database (ODRS), the one other "
                      "software reads too: everyone will see it, and it cannot be "
                      "deleted from here."))
        av.setWordWrap(True)
        av.setStyleSheet("color:#d8a849;font-size:12px;")
        v.addWidget(av)
        esito = QLabel("")
        esito.setWordWrap(True)
        esito.setStyleSheet("color:#b9a07a;font-size:12px;")
        v.addWidget(esito)

        riga = QHBoxLayout(); riga.addStretch(1)
        annulla = QPushButton(L("Annulla", "Cancel"))
        annulla.setStyleSheet("QPushButton{background:rgba(216,168,73,0.18);color:#f1e3c6;border-radius:9px;padding:7px 16px;}")
        annulla.clicked.connect(dlg.reject)
        riga.addWidget(annulla)
        manda = QPushButton(L("Pubblica", "Publish"))
        manda.setStyleSheet("QPushButton{background:#9ccf6a;color:#10240a;border-radius:9px;padding:7px 18px;font-weight:800;}")
        riga.addWidget(manda)
        rp = QWidget(); rp.setLayout(riga); v.addWidget(rp)

        def invia():
            if not stelle["n"]:
                esito.setText(L("Manca il voto: quante stelle?", "No rating yet: how many stars?"))
                return
            if not titolo.text().strip():
                esito.setText(L("Manca il titolo.", "The title is missing."))
                return
            manda.setEnabled(False)
            esito.setText(L("Invio…", "Sending…"))
            dati = {
                "app_id": (app.odrs_id if "." in app.odrs_id else app.odrs_id + ".desktop"),
                "locale": LANG,
                "distro": "SkillFishOS",
                "version": app.ver or "",
                # ⚠️ ODRS vuole il voto da 0 a 100 a passi di 20, non da 1 a 5:
                # mandando 5 si pubblica una recensione da una stella.
                "rating": stelle["n"] * 20,
                "user_hash": hashlib.sha1(("skillfishos" + os.uname().nodename).encode()).hexdigest(),
                "user_display": nome.text().strip() or "anon",
                "summary": titolo.text().strip()[:70],
                "description": corpo.toPlainText().strip()[:3000],
            }
            def spedisci():
                try:
                    req = urllib.request.Request(
                        ODRS + "/submit", data=json.dumps(dati).encode(),
                        headers={"Content-Type": "application/json"})
                    with urllib.request.urlopen(req, timeout=20) as r:
                        return (r.status, r.read().decode("utf-8", "replace")[:200])
                except urllib.error.HTTPError as e:
                    return (e.code, e.read().decode("utf-8", "replace")[:200])
                except Exception as e:
                    return (0, str(e)[:200])
            def finito(risposta):
                codice, testo = risposta or (0, "")
                if codice in (200, 201):
                    esito.setText(L("Pubblicata. Grazie.", "Published. Thank you."))
                    QTimer.singleShot(1200, dlg.accept)
                    self._load_reviews(app)
                else:
                    manda.setEnabled(True)
                    esito.setText(L("Non e' andata (%s). %s", "It did not go through (%s). %s")
                                  % (codice or "-", testo))
            self._rev_send = Worker(spedisci)
            self._rev_send.done.connect(finito)
            self._rev_send.start()

        manda.clicked.connect(invia)
        dlg.exec()

    def _load_reviews(self, app):
        def fetch():
            try:
                uh = hashlib.sha1(("skillfishos" + os.uname().nodename).encode()).hexdigest()
                aid = app.odrs_id if app.odrs_id.endswith(".desktop") or "." in app.odrs_id else app.odrs_id + ".desktop"
                body = json.dumps({"user_hash": uh, "app_id": aid, "locale": LANG, "distro": "SkillFishOS",
                                   "version": app.ver or "", "limit": 8}).encode()
                req = urllib.request.Request(ODRS + "/fetch", data=body, headers={"Content-Type": "application/json"})
                with urllib.request.urlopen(req, timeout=15) as r:
                    return json.loads(r.read().decode())
            except Exception:
                return []
        self._rw = Worker(fetch); self._rw.done.connect(self._show_reviews); self._rw.start()
    def _show_reviews(self, reviews):

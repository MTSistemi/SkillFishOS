ICONE_NOSTRE = {
    "skillfish-ai-panel": "skillfish-ai",
    "skillfish-kernel-manager": "skillfish-kernel",
    "skillfish-dashboard": "skillfish-remote",
    "skillfish-tuner": "skillfish-tuner",

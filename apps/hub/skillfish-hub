    def aggiorna_firmware(self, nome, ident):
        u"""Aggiorna il firmware di UN dispositivo, dopo averlo chiesto sul serio."""
        if not ident:
            self.statusBar().showMessage(
                L("Questo dispositivo non dice il suo identificativo: fwupd non "
                  "saprebbe quale aggiornare.",
                  "This device does not report an id: fwupd would not know which "
                  "one to update."), 6000)
            return
        r = QMessageBox.warning(
            self, "SkillFishOS Hub",
            L("Aggiornare il firmware di «%s»?\n\nNon si disinstalla e non si "
              "torna indietro. Non spegnere la macchina finché non ha finito.",
              "Update the firmware of “%s”?\n\nIt cannot be uninstalled and there "
              "is no way back. Do not switch the machine off until it is done.") % nome,
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel,
            QMessageBox.StandardButton.Cancel)
        if r != QMessageBox.StandardButton.Yes:
            return
        self._avvia_transazione("firmware", [ident],
                                L("Aggiornamento del firmware di %s…",
                                  "Updating the firmware of %s…") % nome)


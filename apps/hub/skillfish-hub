    def _avvia_transazione(self, azione, argomenti, titolo):
        u"""Fa partire il lavoro e apre la finestra che lo guarda.

        ⚠️ Qui non si esegue niente: si chiede all'helper di farlo partire per
        conto suo. Se la finestra muore — e durante un aggiornamento delle Qt
        muore — il lavoro continua lo stesso, ed e' tutto il punto.
        """
        ok, messaggio = tx_avvia(azione, *argomenti)
        if not ok:
            QMessageBox.warning(self, "SkillFishOS Hub",
                                messaggio or L("Non sono riuscito ad avviare l'operazione.",
                                               "I could not start the operation."))
            return
        self._segui(titolo)

    def _segui(self, titolo):
        dlg = SeguiTransazione(self, titolo, alla_fine=lambda rc: self.reload_catalog())
        dlg.exec()

    def _riattacca_transazione(self):
        u"""All'avvio: se qualcosa sta girando, riattaccatici.

        E' la meta' che mancava allo staccare la transazione — se l'Hub riparte
        e fa finta di niente, l'utente vede un sistema che si muove da solo
        senza sapere perche'.
        """
        if not tx_in_corso():
            return
        self._dlg_tx = SeguiTransazione(
            self, L("C'è un aggiornamento in corso", "An update is running"),
            alla_fine=lambda rc: self.reload_catalog())
        self._dlg_tx.show()   # non modale: l'Hub resta usabile mentre guarda


class InstallPage(QWizardPage):
    def __init__(self):
        super().__init__()
        self.setTitle(L("Installazione del motore", "Installing the engine"))
        self.ok = False
        v = QVBoxLayout(self)
        if True:
            self.info = QLabel(L("Premi «Installa» per scaricare e configurare Unsloth Studio "
                                 "con il backend Vulkan. Sono circa 2 GB: può richiedere "
                                 "qualche minuto.",
                                 "Press “Install” to download and set up Unsloth Studio with the "
                                 "Vulkan backend. It is about 2 GB: this may take a few minutes."))
        self.info.setWordWrap(True); v.addWidget(self.info)
        self.btn = QPushButton(L("Installa / Avvia", "Install / Start")); self.btn.clicked.connect(self.run)
        v.addWidget(self.btn)
        self.bar = QProgressBar(); self.bar.setRange(0, 0); self.bar.hide(); v.addWidget(self.bar)
        self.log = QTextEdit(); self.log.setReadOnly(True); self.log.setMinimumHeight(220)
        v.addWidget(self.log)
        self._w = None
    def isComplete(self): return self.ok
    def _append(self, s): self.log.append(s)
    def run(self):
        self.btn.setEnabled(False); self.bar.show()
        # Un solo passo privilegiato: l'installer scarica Unsloth, forza il bundle
        # llama.cpp con Vulkan e installa la unit systemd.
        #
        # ATTENZIONE, qui c'era un difetto: si impostava self.steps mentre _next()
        # legge self._queue, che non veniva creato da nessuna parte. Premere
        # «Installa» sollevava un AttributeError. Non si vedeva perche' questa
        # procedura compare solo quando il motore NON e' ancora installato, e sulla
        # macchina di sviluppo lo e' sempre stato.
        self._queue = [f"pkexec sh -c 'UNSLOTH_FORCE_VULKAN=1 bash {UNSLOTH_INSTALLER}'"]
        self._next()
    def _next(self):
        if not self._queue:
            self._append(L("\n✓ Unsloth Studio installato e avviato. Al primo accesso ti chiedera' "
                           "di impostare una password: la scegli tu.",
                           "\n✓ Unsloth Studio installed and started. On first sign-in it will ask "
                           "you to set a password: you choose it."))
            self.bar.hide(); self.ok = True; self.completeChanged.emit(); return
        cmd = self._queue.pop(0)
        self._append("$ " + (cmd[:90] + ("…" if len(cmd) > 90 else "")))
        self._w = Worker(cmd); self._w.line.connect(self._append)
        self._w.done.connect(self._step_done); self._w.start()
    def _step_done(self, rc):
        if rc != 0:
            self._append(L("! comando fallito (rc=%s) — continuo", "! command failed (rc=%s) — continuing") % (rc,))
        self._next()


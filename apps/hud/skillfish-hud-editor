def _detect_lang():
    val = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
           or os.environ.get("LANG") or os.environ.get("LANGUAGE") or "")
    v = val.lower()
    if v.startswith("it"):
        return "it"
    if v.startswith("ua"):
        return "uk"
    c = v.replace("-", "_").split(".")[0].split("@")[0].split("_")[0].strip()
    return c if len(c) == 2 and c.isalpha() else "en"



    def _prova_uscita(self):
        sensori = (self.stato or {}).get("sensori") or []
        ventole = [x for x in sensori if x.get("type") == "fan" and x.get("value")]
        pwm = self.conf.get("pwm") or self._scegli_pwm()
        if not ventole or not pwm:
            QMessageBox.information(self, L("Non si puo' provare", "Cannot test"), L(
                "Serve un'uscita PWM e una ventola che dia i giri. Su questa macchina "
                "manca almeno una delle due.",
                "This needs a PWM output and a fan that reports its speed. At least one "
                "of the two is missing on this machine."))
            return
        self.bottone_prova.setEnabled(False)
        self.et_prova.setStyleSheet("color:#9a8a70;")
        self.et_prova.setText(L("Prova in corso, una trentina di secondi. Si sente.",
                                "Testing, about thirty seconds. You will hear it."))
        self._filo = Prova(pwm, ventole[0]["key"], self)
        self._filo.finita.connect(self._prova_finita)
        self._filo.start()

    def _prova_finita(self, risponde, dettaglio):
        self.bottone_prova.setEnabled(True)
        self._mostra_prova(leggi_json(PROVA, {}) or {"risponde": risponde})
        if dettaglio:
            self.et_prova.setText(self.et_prova.text() + chr(10) + dettaglio)

    def _sez_tensioni(self):
        g, v = self._box(L("Tensioni e assorbimento",
                           "Voltages and power draw"), "tensioni")
        self.contenitore_tensioni = QVBoxLayout()
        v.addLayout(self.contenitore_tensioni)
        h = QHBoxLayout()
        h.addWidget(QLabel(L("Rinomina i sensori", "Rename the sensors")))
        h.addStretch(1)
        h.addWidget(_aiuto("etichette", g))
        v.addLayout(h)
        v.addStretch(1)
        return g

    # -- vita ---------------------------------------------------------------
    def _curva_toccata(self):
        for b in self.gruppo.buttons():
            self.gruppo.setExclusive(False)
            b.setChecked(False)
            self.gruppo.setExclusive(True)
        self.bottone_preset.setEnabled(False)
        self.etichetta_salva.setText(L("modificata, non ancora applicata",
                                       "changed, not applied yet"))

    def _usa_preset(self):
        for b in self.gruppo.buttons():
            if b.isChecked():
                self.grafico.imposta(PRESET[b.chiave])
                self.etichetta_salva.setText(
                    L("%s: premi Applica", "%s: press Apply") % nome_preset(b.chiave))
                return

    def _preset_scelto(self):
        for b in self.gruppo.buttons():
            if b.isChecked():
                return b.chiave
        return "personalizzata"

    def _svuota(self, layout):
        while layout.count():
            v = layout.takeAt(0)
            w = v.widget()
            if w:
                w.deleteLater()
            elif v.layout():
                self._svuota(v.layout())

    def aggiorna(self):
        self.stato = leggi_json(STATO, {})
        s = self.stato
        if not s:
            self.et_motivo.setText(L(
                "Il controllo della ventola non sta girando. Premi Applica per accenderlo.",
                "The fan controller is not running. Press Apply to start it."))
            return

        t = s.get("temperatura")
        self.et_temp.setText("%.1f °C" % t if t is not None else "—")
        self.et_duty.setText(L("Ventola: %s%%", "Fan: %s%%") % s.get("duty", "—"))
        self.et_watt.setText(L("Assorbimento: %.1f W", "Power draw: %.1f W")
                             % s["watt"] if s.get("watt") else "")
        motivo = {
            "curve": L("segue la curva", "following the curve"),
            "no temperature: full speed": L(
                "nessuna temperatura leggibile: al massimo per sicurezza",
                "no readable temperature: full speed, to be safe"),
        }.get(s.get("motivo") or "", s.get("motivo") or "")
        if (s.get("motivo") or "").startswith("emergency"):
            motivo = L("EMERGENZA: al massimo", "EMERGENCY: full speed")
        if (s.get("motivo") or "").startswith("anticipating"):
            motivo = L("sta anticipando la salita", "anticipating the rise")
        if (s.get("motivo") or "").startswith("pre-cooling"):
            motivo = L("pre-raffredda per %s", "pre-cooling for %s") % (s.get("gioco") or "")
        self.et_motivo.setText(motivo)

        if not s.get("in_controllo"):
            self.et_uscita.setText(L(
                "La ventola e' ancora governata dal firmware: la curva non e' attiva.",
                "The fan is still governed by the firmware: the curve is not in charge."))
        else:
            self.et_uscita.setText(L("Uscita comandata: %s", "Driving output: %s")
                                   % (self.conf.get("pwm") or "—"))

        sensori = s.get("sensori") or []
        giri = [x for x in sensori if x.get("type") == "fan" and x.get("value")]
        self.et_giri.setText(L("Giri: %d rpm", "Speed: %d rpm") % giri[0]["value"]
                             if giri else "")
        if t is not None:
            self.grafico.aggiorna_vivo(t, float(s.get("duty") or 0))

        self._riempi_sorgente(sensori)
        self._riempi_tensioni(sensori)
        if s.get("gioco"):
            self.et_gioco.setText(L("Ultimo riconosciuto: %s", "Last recognised: %s")
                                  % s["gioco"])

    def _riempi_sorgente(self, sensori):
        temp = [x for x in sensori if x.get("type") == "temp"]
        chiavi = [x["key"] for x in temp]
        if set(chiavi) != set(self.caselle_sorgente):
            self._svuota(self.contenitore_sorgente)
            self.caselle_sorgente = {}
            scelte = set(self.conf.get("sorgente") or [])
            for x in temp:
                c = QCheckBox(x["label"])
                c.setChecked(x["key"] in scelte)
                self.caselle_sorgente[x["key"]] = c
                h = QHBoxLayout()
                h.addWidget(c)
                h.addStretch(1)
                val = QLabel("")
                val.setStyleSheet("color:#d8a849;")
                h.addWidget(val)
                c.valore = val
                self.contenitore_sorgente.addLayout(h)
        for x in temp:
            c = self.caselle_sorgente.get(x["key"])
            if c is not None and x.get("value") is not None:
                c.valore.setText("%.1f °C" % x["value"])

    def _riempi_tensioni(self, sensori):
        volt = [x for x in sensori if x.get("type") in ("in", "power")]
        chiavi = [x["key"] for x in volt]
        if set(chiavi) != set(self.campi_etichetta):
            self._svuota(self.contenitore_tensioni)
            self.campi_etichetta = {}
            for x in volt:
                h = QHBoxLayout()
                campo = QLineEdit(x["label"])
                campo.setMaximumWidth(150)
                self.campi_etichetta[x["key"]] = campo
                h.addWidget(campo)
                h.addStretch(1)
                val = QLabel("")
                h.addWidget(val)
                campo.valore = val
                self.contenitore_tensioni.addLayout(h)
        allarmi = []
        for x in volt:
            campo = self.campi_etichetta.get(x["key"])
            if campo is None or x.get("value") is None:
                continue
            v = x["value"]
            campo.valore.setText("%.3f V" % v if x["type"] == "in" else "%.1f W" % v)
            if x["type"] != "in":
                continue
            atteso = nominale(x.get("label"))
            if atteso == "dinamica":
                continue           # si muove per progetto: si mostra, non si allarma
            if atteso is None:
                # Nessun nome riconoscibile — sul Fujitsu si chiamano in0, in2,
                # in6 perche' il driver non sa come sono cablate. L'unica cosa
                # onesta e' guardare per un po' e prendere la MEDIANA come
                # valore di riposo. La mediana, non la prima lettura: se il
                # primo campione capita durante un picco, quel picco diventa il
                # riferimento e tutto il resto sembra sbagliato.
                storia = self.riposo.setdefault(x["key"], [])
                if len(storia) < CAMPIONI_RIPOSO:
                    storia.append(v)
                    continue       # ancora non si sa abbastanza per giudicare
                ordinati = sorted(storia)
                atteso = ordinati[len(ordinati) // 2]
                tolleranza = 0.10
            else:
                tolleranza = 0.05
            if atteso and abs(v - atteso) / atteso > tolleranza:
                allarmi.append(L("%s: %.3f V invece di %.2f V",
                                 "%s: %.3f V instead of %.2f V")
                               % (campo.text(), v, atteso))
        self.et_allarme.setText("\n".join(allarmi[:3]))

    # -- salvataggio --------------------------------------------------------
    def salva(self):
        sorgenti = [k for k, c in self.caselle_sorgente.items() if c.isChecked()]
        pwm = self.conf.get("pwm") or self._scegli_pwm()
        if self.interruttore.isChecked() and not sorgenti:
            QMessageBox.warning(self, L("Manca la sorgente", "No source chosen"), L(
                "Scegli almeno una temperatura da usare come sorgente della curva.",
                "Pick at least one temperature for the curve to follow."))
            return
        if self.interruttore.isChecked() and not pwm:
            QMessageBox.warning(self, L("Nessuna uscita", "No output"), L(
                "Su questa macchina non ho trovato un'uscita PWM che si possa comandare.",
                "I could not find a controllable PWM output on this machine."))
            return

        conf = {
            "attivo": self.interruttore.isChecked(),
            "pwm": pwm,
            "sorgente": sorgenti,
            "curva": self.grafico.punti,
            "minimo": self.minimo.value(),
            "isteresi": self.isteresi.value(),
            "emergenza": self.emergenza.value(),
            "preset": self._preset_scelto(),
            "predittivo": {
                "attivo": self.pred_attivo.isChecked(),
                "guadagno": self.guadagno.value(),
                "finestra": self.finestra.value(),
                "preraffredda": self.preraffredda.value(),
            },
        }
        etichette = dict(self.etichette)
        for k, campo in self.campi_etichetta.items():
            testo = campo.text().strip()
            if testo:
                etichette[k] = testo

        ok, msg = self._helper("scrivi", conf)
        if ok and etichette:
            self._helper("etichette", etichette)
        if ok:
            self.conf = conf
            self.etichetta_salva.setText(L("applicata", "applied"))
        else:
            QMessageBox.critical(self, L("Non riesco a salvare", "Could not save"), msg)

    def _scegli_pwm(self):
        u"""L'uscita da comandare, se non e' gia' scelta.

        Si prende quella gia' in modo manuale sullo stesso chip della ventola
        che legge: sulla BC-250 e' pwm2, l'unica che non e' governata dal chip.
        Non e' un indovinello — e' l'unica configurazione coerente possibile
        quando c'e' una sola ventola vera."""
        sensori = (self.stato or {}).get("sensori") or []
        ventole = [x for x in sensori if x.get("type") == "fan" and x.get("value")]
        chip = ventole[0]["key"].split(":")[0] if ventole else ""
        try:
            sys.path.insert(0, "/usr/share/skillfish")
            import hwmon
            _, pwm = hwmon.elenca()
        except Exception:
            return ""
        candidate = [p for p in pwm if p.modo is not None and p.modo >= 0]
        if chip:
            stesso = [p for p in candidate if p.chiave.split(":")[0] == chip]
            candidate = stesso or candidate
        for p in candidate:
            if p.modo == 1:
                return p.chiave
        return candidate[0].chiave if candidate else ""

    @staticmethod
    def _helper(azione, dati):
        try:
            p = subprocess.run(["pkexec", HELPER, azione],
                               input=json.dumps(dati), capture_output=True,
                               text=True, timeout=120)
        except Exception as e:
            return False, str(e)
        if p.returncode == 0:
            return True, ""
        msg = (p.stderr or p.stdout or "").strip()
        if p.returncode == 126:
            msg = L("Autenticazione annullata.", "Authentication cancelled.")
        return False, msg or L("errore sconosciuto", "unknown error")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("SkillFishOS Fan Control")
    if os.path.exists(ICON):
        app.setWindowIcon(QIcon(ICON))
    f = Finestra()
    f.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())

# ---------- il grafico ----------
OTTONE = QColor("#d8a849")
OTTONE_SCURO = QColor("#8a6a2a")
FONDO = QColor("#1b1713")
GRIGLIA = QColor("#3a322a")
VIVO = QColor("#7fd4ff")


class Grafico(QWidget):
    u"""L'unico grafico: gli ultimi minuti che scorrono.

    Orizzontale = il tempo. Verticale = 0-100. Ci finisce dentro tutto quello
    che la macchina legge davvero: temperature, la ventola in percento, i giri,
    i watt, le tensioni.

    ⚠️ UN GRAFICO SOLO, ed e' il motivo per cui questa applicazione esiste: con
    uno solo si tiene d'occhio tutto insieme; con due o tre si passa dall'uno
    all'altro di continuo e le cose da confrontare finiscono su schermate
    diverse.

    ⚠️ CI SONO CINQUE UNITA' DI MISURA MESSE INSIEME. Non esiste un asse
    verticale solo che vada bene per gradi, percento, giri, watt e volt, quindi
    ogni serie viene portata su una scala 0-100 sua. Il valore vero si legge in
    tre modi: nella tessera, passandoci sopra col puntatore, e aprendo la serie
    da sola — che e' l'unico posto dove gli assi portano i numeri veri.
    """

    FINESTRA = 300            # secondi di storia tenuti

    COLORI_TEMP = ["#e8703a", "#d85a5a", "#c78be0", "#7fd4ff",
                   "#8fbf6a", "#e0d05a", "#b06a3a", "#5a8fd8"]
    COL_DUTY = "#d8a849"
    COL_RPM = "#5ad0c0"
    COL_WATT = "#b98cff"
    COL_VOLT = "#6a9fd8"

    def __init__(self, parent=None):
        super().__init__(parent)
        self.serie = {}
        self.ordine = []
        self.nuova_serie = None
        self.apri_serie = None     # richiamo: apri questa serie da sola
        self.cursore = None        # posizione del puntatore
        self.sotto = None          # la linea che ha sotto: e' l'unica che legge
        self._inizio = self._fine = 0.0
        # ⚠️ LA CURVA STA DENTRO AL GRAFICO, nell'angolo in basso a sinistra.
        # Copre un pezzo — non c'e' modo di evitarlo — ma quell'angolo e' il
        # meno frequentato: sotto al venti per cento ci passano solo le linee di
        # una macchina che sta ferma davvero. Si richiude col triangolino.
        self.inserto = CurvaEditor(self)
        self.bottone_inserto = QToolButton(self)
        self.bottone_inserto.setText("▾")
        self.bottone_inserto.setAutoRaise(True)
        self.bottone_inserto.clicked.connect(self._apri_chiudi)
        self._inserto_aperto = True
        self._inserto_pos = None      # None = appoggiata all'origine
        self._inserto_dim = None      # None = la misura di partenza
        self.inserto.spostata = self._sposta_inserto
        self.inserto.ridimensionata = self._ridimensiona_inserto
        self.setMinimumHeight(240)
        self.setMinimumWidth(360)
        self.setMouseTracking(True)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)

    # Quanto e' grande l'inserto della curva quando non lo si e' ancora toccato,
    # e sotto quale misura non lo si puo' stringere: piu' piccolo di cosi' i
    # punti si sovrappongono e trascinarne uno diventa un terno al lotto.
    INS_L, INS_H = 340, 224
    INS_MIN_L, INS_MIN_H = 230, 150

    def _apri_chiudi(self):
        self._inserto_aperto = not self._inserto_aperto
        self.inserto.setVisible(self._inserto_aperto)
        self.bottone_inserto.setText("▾" if self._inserto_aperto else "▸")
        self.bottone_inserto.setToolTip(
            L("Nascondi la curva", "Hide the curve") if self._inserto_aperto
            else L("Mostra la curva", "Show the curve"))
        self.update()

    def resizeEvent(self, ev):
        super().resizeEvent(ev)
        self._posiziona_inserto()

    def _posiziona_inserto(self):
        u"""Dove sta il riquadro della curva.

        Di serie l'angolo in basso a sinistra coincide con l'ORIGINE DEGLI ASSI
        del grafico: appoggiato esattamente dove si incontrano lo zero per cento
        e il bordo sinistro, non a caso dentro all'area.

        Se lo si e' spostato si tiene la sua posizione, ma sempre riportata
        dentro ai bordi: rimpicciolendo la finestra, un riquadro lasciato in
        basso a destra finirebbe fuori e non lo si riprenderebbe piu'."""
        a = self._area()
        # la misura: quella di partenza, o quella a cui e' stata tirata, e mai
        # piu' grande dell'area del grafico
        l, h = self._inserto_dim or (self.INS_L, self.INS_H)
        l = max(self.INS_MIN_L, min(a.width(), l))
        h = max(self.INS_MIN_H, min(a.height(), h))
        if self._inserto_pos is None:
            x, y = a.left(), a.bottom() - h
        else:
            x, y = self._inserto_pos
        x = max(a.left(), min(a.right() - l, x))
        y = max(a.top(), min(a.bottom() - h, y))
        self.inserto.setGeometry(QRect(int(x), int(y), int(l), int(h)))
        self.bottone_inserto.setGeometry(
            QRect(int(x) + int(l) - 21, int(y) + 1, 19, 15))

    def _ridimensiona_inserto(self, l, h):
        u"""⚠️ Tirando l'angolo si sposta il bordo in basso a destra, e quello in
        alto a sinistra resta fermo: se la posizione non e' ancora stata scelta
        a mano bisogna fissarla adesso, o il riquadro «appoggiato all'origine»
        scivolerebbe verso l'alto man mano che lo si allunga."""
        if self._inserto_pos is None:
            g = self.inserto.geometry()
            self._inserto_pos = (g.x(), g.y())
        self._inserto_dim = (l, h)
        self._posiziona_inserto()

    def _sposta_inserto(self, punto):
        p = self.mapFromGlobal(punto)
        self._inserto_pos = (p.x(), p.y())
        self._posiziona_inserto()

    def _bordo(self):
        return 42, 10, 12, 24

    def _area(self):
        s, sup, d, inf = self._bordo()
        return QRect(s, sup, max(1, self.width() - s - d),
                     max(1, self.height() - sup - inf))

    def _y(self, q):
        a = self._area()
        return a.bottom() - max(0.0, min(1.0, q)) * a.height()

    def _colore(self, unita):
        if unita == "C":
            n = len([k for k in self.ordine if self.serie[k]["unita"] == "C"])
            return QColor(self.COLORI_TEMP[n % len(self.COLORI_TEMP)])
        return QColor({"%": self.COL_DUTY, "rpm": self.COL_RPM,
                       "W": self.COL_WATT, "V": self.COL_VOLT}.get(unita, "#999999"))

    def carica(self, storia, meta):
        u"""I campioni li ha presi il demone: qui si disegnano e basta.

        ⚠️ Prima la finestra si costruiva la sua storia accodando un punto a
        ogni aggiornamento. Reggeva finche' si aggiornava ogni secondo, ma
        bastava rallentare per avere un grafico piu' povero — un grafico che
        peggiora perche' lo si guarda meno spesso, che e' il contrario di quello
        che deve succedere. E riaprendo la finestra si ripartiva da zero.

        `meta` da' nome e unita' di ogni chiave; la storia da' i punti.
        """
        nuove = False
        for chiave, punti in (storia or {}).items():
            etichetta, unita = meta.get(chiave, (chiave, ""))
            s = self.serie.get(chiave)
            if s is None:
                s = {"etichetta": etichetta, "unita": unita, "punti": [],
                     # ⚠️ Di serie si accendono temperature, ventola, giri e watt
                     # — i quattro numeri della colonna piu' le temperature.
                     # Accendere anche le tensioni farebbe partire il grafico
                     # con dodici linee sovrapposte.
                     "visibile": unita in ("C", "%", "rpm", "W"), "colore": None}
                self.serie[chiave] = s
                self.ordine.append(chiave)
                s["colore"] = self._colore(unita)
                nuove = True
            s["etichetta"] = etichetta
            # {"t0": primo secondo, "v": [valori]}: il tempo si ricava
            # dall'indice, e i buchi (null) si saltano.
            t0 = punti.get("t0") or 0
            s["punti"] = [(t0 + i, v) for i, v in enumerate(punti.get("v") or [])
                          if v is not None]
        if nuove and self.nuova_serie:
            self.nuova_serie()
        self.update()

    @staticmethod
    def _scala(unita, valori):
        u"""⚠️ Le tensioni si disegnano attorno alla LORO mediana con un piu' o
        meno dieci per cento: su una scala 0-14 volt starebbero tutte
        appiccicate e un calo del cinque per cento — che e' il sintomo che
        interessa — sarebbe invisibile."""
        if unita == "C":
            return 20.0, 100.0
        if unita == "%":
            return 0.0, 100.0
        if unita == "rpm":
            m = max(valori) if valori else 1
            return 0.0, max(500.0, (int(m / 500) + 1) * 500.0)
        if unita == "W":
            m = max(valori) if valori else 1
            return 0.0, max(10.0, (int(m / 10) + 1) * 10.0)
        if unita == "V":
            o = sorted(valori)
            med = o[len(o) // 2] if o else 1.0
            return (0.0, 1.0) if med <= 0 else (med * 0.9, med * 1.1)
        return (min(valori) if valori else 0.0), (max(valori) if valori else 1.0)

    def elenco(self):
        return [(k, self.serie[k]) for k in self.ordine if k in self.serie]

    def _visibili(self):
        return [(k, s) for k, s in self.elenco() if s["visibile"] and s["punti"]]

    @staticmethod
    def valore_a(s, quando):
        u"""Il valore della serie al momento indicato: il campione piu' vicino.

        Non si interpola fra due campioni: a un secondo di distanza
        l'interpolazione inventerebbe un numero che la macchina non ha mai
        letto, e questo e' il posto dove si va a leggere il valore vero."""
        if not s["punti"]:
            return None
        migliore, dist = None, None
        for tempo, v in s["punti"]:
            d = abs(tempo - quando)
            if dist is None or d < dist:
                migliore, dist = v, d
        return migliore

    # ------------------------------------------------------------- disegno
    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.fillRect(self.rect(), FONDO)
        a = self._area()
        p.setFont(QFont(self.font().family(), 8))
        for q in range(0, 101, 20):
            y = self._y(q / 100.0)
            p.setPen(QPen(GRIGLIA, 1))
            p.drawLine(a.left(), int(y), a.right(), int(y))
            p.setPen(QPen(OTTONE_SCURO, 1))
            p.drawText(8, int(y) + 4, "%d%%" % q)
        for i in range(0, 6):
            x = a.left() + a.width() * i / 5.0
            p.setPen(QPen(GRIGLIA, 1))
            p.drawLine(int(x), a.top(), int(x), a.bottom())
            p.setPen(QPen(OTTONE_SCURO, 1))
            sec = int(self.FINESTRA * (5 - i) / 5.0)
            p.drawText(int(x) - (16 if sec else 22), a.bottom() + 16,
                       L("adesso", "now") if sec == 0 else "-%d s" % sec)

        serie = self._visibili()
        if not serie:
            p.setPen(QPen(OTTONE_SCURO, 1))
            p.drawText(a.left() + 12, a.center().y(),
                       L("niente da mostrare", "nothing to show"))
            return
        self._fine = max(s["punti"][-1][0] for _, s in serie)
        self._inizio = self._fine - self.FINESTRA
        for chiave, s in serie:
            valori = [v for _, v in s["punti"]]
            basso, alto = self._scala(s["unita"], valori)
            campo = (alto - basso) or 1.0
            cam = QPainterPath()
            primo = True
            for tempo, v in s["punti"]:
                if tempo < self._inizio:
                    continue
                x = a.left() + (tempo - self._inizio) / float(self.FINESTRA) * a.width()
                y = self._y((v - basso) / campo)
                if primo:
                    cam.moveTo(x, y)
                    primo = False
                else:
                    cam.lineTo(x, y)
            if primo:
                continue
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.setPen(QPen(s["colore"], 2.4 if s["unita"] == "%" else 1.5))
            p.drawPath(cam)
        self._disegna_cursore(p, serie)

    def _disegna_cursore(self, p, serie):
        u"""Il puntatore legge UNA linea: quella che ha sotto.

        ⚠️ Prima il riquadro elencava tutte le serie accese. Con dodici linee
        diventava un muro di righe piccole proprio sopra al grafico, e per
        leggere il numero che interessava bisognava cercarlo nell'elenco. Chi
        avvicina il puntatore a una linea sta chiedendo quella: si risponde con
        quella, grande, e basta.
        """
        if self.cursore is None or self.sotto is None:
            return
        s = self.serie.get(self.sotto)
        if not s or not s["punti"]:
            return
        a = self._area()
        x = max(a.left(), min(a.right(), self.cursore.x()))
        quando = self._inizio + (x - a.left()) / float(max(1, a.width())) * self.FINESTRA
        v = self.valore_a(s, quando)
        if v is None:
            return
        basso, alto = self._scala(s["unita"], [y for _, y in s["punti"]])
        y = self._y((v - basso) / ((alto - basso) or 1.0))

        p.setPen(QPen(QColor(216, 168, 73, 130), 1, Qt.PenStyle.DashLine))
        p.drawLine(int(x), a.top(), int(x), a.bottom())
        p.setBrush(QBrush(s["colore"]))
        p.setPen(QPen(QColor("#15110d"), 2))
        p.drawEllipse(QPointF(x, y), 5.5, 5.5)

        dec = {"C": 1, "%": 0, "rpm": 0, "W": 1, "V": 3}.get(s["unita"], 1)
        grosso = ("%." + str(dec) + "f %s") % (v, s["unita"])
        sec = int(round(self._fine - quando))
        piccolo = "%s  ·  %s" % (s["etichetta"],
                                 L("adesso", "now") if sec <= 0 else "-%d s" % sec)
        fg = QFont(self.font().family(), 20, QFont.Weight.Bold)
        fp = QFont(self.font().family(), 9)
        p.setFont(fg)
        fmg = p.fontMetrics()
        lg = fmg.horizontalAdvance(grosso)
        p.setFont(fp)
        fmp = p.fontMetrics()
        lp = fmp.horizontalAdvance(piccolo)
        larg = max(lg, lp) + 22
        alt = fmg.height() + fmp.height() + 18
        # il riquadro sta dall'altra parte quando starebbe per uscire: verso il
        # bordo destro c'e' proprio il pezzo che interessa di piu'.
        bx = x + 16 if x + 16 + larg < a.right() else x - 16 - larg
        by = max(a.top() + 2, min(a.bottom() - alt - 2, y - alt / 2.0))
        p.setBrush(QBrush(QColor(21, 17, 13, 240)))
        p.setPen(QPen(s["colore"], 1))
        p.drawRoundedRect(QRect(int(bx), int(by), int(larg), int(alt)), 5, 5)
        p.setPen(QPen(QColor("#9a8a70"), 1))
        p.setFont(fp)
        p.drawText(int(bx) + 11, int(by) + 6 + fmp.ascent(), piccolo)
        p.setPen(QPen(s["colore"], 1))
        p.setFont(fg)
        p.drawText(int(bx) + 11, int(by) + 10 + fmp.height() + fmg.ascent(), grosso)

    # --------------------------------------------------------- interazione
    def mouseMoveEvent(self, ev):
        self.cursore = ev.position()
        self.sotto = self._serie_vicina(self.cursore)
        self.setCursor(Qt.CursorShape.PointingHandCursor if self.sotto
                       else Qt.CursorShape.ArrowCursor)
        self.update()

    def leaveEvent(self, ev):
        self.cursore = None
        self.sotto = None
        self.update()

    def _serie_vicina(self, pos):
        u"""Quale linea e' stata cliccata: la piu' vicina al punto, in pixel."""
        a = self._area()
        if not a.contains(pos.toPoint()):
            return None
        quando = (self._inizio + (pos.x() - a.left())
                  / float(max(1, a.width())) * self.FINESTRA)
        migliore, dist = None, None
        for chiave, s in self._visibili():
            v = self.valore_a(s, quando)
            if v is None:
                continue
            basso, alto = self._scala(s["unita"], [x for _, x in s["punti"]])
            y = self._y((v - basso) / ((alto - basso) or 1.0))
            d = abs(y - pos.y())
            if dist is None or d < dist:
                migliore, dist = chiave, d
        return migliore if dist is not None and dist < 40 else None

    def mousePressEvent(self, ev):
        chiave = self._serie_vicina(ev.position())
        if chiave and self.apri_serie:
            self.apri_serie(chiave)


class GraficoSingolo(QWidget):
    u"""Una serie sola, con i numeri veri sugli assi.

    Nel grafico grande convivono cinque unita' di misura e nessuna puo' avere
    l'asse verticale con i suoi numeri: si legge tutto in proporzione. Qui la
    serie e' una sola, quindi l'asse verticale porta i VOLT, i WATT o i GRADI
    che sono, e l'orizzontale i secondi.

    La scala verticale si prende dai dati con un margine del dieci per cento
    sopra e sotto — qui e' giusto che insegua, perche' e' il posto dove si va a
    guardare una cosa da vicino.
    """

    def __init__(self, grafico, chiave, parent=None):
        super().__init__(parent)
        self.grafico = grafico
        self.chiave = chiave
        self.setMinimumSize(560, 320)
        self.setMouseTracking(True)
        self.cursore = None

    def _area(self):
        return QRect(66, 12, max(1, self.width() - 80), max(1, self.height() - 42))

    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.fillRect(self.rect(), FONDO)
        a = self._area()
        s = self.grafico.serie.get(self.chiave)
        p.setFont(QFont(self.font().family(), 8))
        if not s or not s["punti"]:
            p.setPen(QPen(OTTONE_SCURO, 1))
            p.drawText(a.left() + 10, a.center().y(),
                       L("ancora nessuna lettura", "no readings yet"))
            return
        valori = [v for _, v in s["punti"]]
        basso, alto = min(valori), max(valori)
        if alto - basso < 1e-9:
            basso, alto = basso - 1.0, alto + 1.0
        margine = (alto - basso) * 0.1
        basso, alto = basso - margine, alto + margine
        campo = alto - basso
        dec = {"C": 1, "%": 0, "rpm": 0, "W": 1, "V": 3}.get(s["unita"], 1)

        for i in range(0, 5):
            y = a.bottom() - a.height() * i / 4.0
            p.setPen(QPen(GRIGLIA, 1))
            p.drawLine(a.left(), int(y), a.right(), int(y))
            p.setPen(QPen(OTTONE_SCURO, 1))
            p.drawText(4, int(y) + 4, ("%." + str(dec) + "f") % (basso + campo * i / 4.0))
        fine = s["punti"][-1][0]
        inizio = fine - self.grafico.FINESTRA
        for i in range(0, 6):
            x = a.left() + a.width() * i / 5.0
            p.setPen(QPen(GRIGLIA, 1))
            p.drawLine(int(x), a.top(), int(x), a.bottom())
            p.setPen(QPen(OTTONE_SCURO, 1))
            sec = int(self.grafico.FINESTRA * (5 - i) / 5.0)
            p.drawText(int(x) - (16 if sec else 22), a.bottom() + 18,
                       L("adesso", "now") if sec == 0 else "-%d s" % sec)
        # ⚠️ L'unita' sta in basso a sinistra, sotto all'angolo degli assi, e
        # grande: e' l'informazione che dice cosa sono tutti gli altri numeri
        # del riquadro, e in piccolo in un angolo in alto non la leggeva nessuno.
        p.setPen(QPen(OTTONE, 1))
        p.setFont(QFont(self.font().family(), 13, QFont.Weight.Bold))
        p.drawText(6, self.height() - 8, s["unita"])
        p.setFont(QFont(self.font().family(), 8))

        cam = QPainterPath()
        primo = True
        for tempo, v in s["punti"]:
            if tempo < inizio:
                continue
            x = a.left() + (tempo - inizio) / float(self.grafico.FINESTRA) * a.width()
            y = a.bottom() - (v - basso) / campo * a.height()
            if primo:
                cam.moveTo(x, y)
                primo = False
            else:
                cam.lineTo(x, y)
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.setPen(QPen(s["colore"], 2))
        p.drawPath(cam)

        if self.cursore is not None and a.left() <= self.cursore <= a.right():
            quando = (inizio + (self.cursore - a.left())
                      / float(max(1, a.width())) * self.grafico.FINESTRA)
            v = self.grafico.valore_a(s, quando)
            if v is not None:
                y = a.bottom() - (v - basso) / campo * a.height()
                p.setPen(QPen(QColor(216, 168, 73, 140), 1, Qt.PenStyle.DashLine))
                p.drawLine(int(self.cursore), a.top(), int(self.cursore), a.bottom())
                p.setBrush(QBrush(s["colore"]))
                p.setPen(QPen(QColor("#15110d"), 1.5))
                p.drawEllipse(QPointF(self.cursore, y), 4, 4)
                p.setPen(QPen(s["colore"], 1))
                p.setFont(QFont(self.font().family(), 9, QFont.Weight.Bold))
                sec = int(round(fine - quando))
                p.drawText(int(self.cursore) + 8, int(y) - 8,
                           ("%." + str(dec) + "f %s  (%s)")
                           % (v, s["unita"],
                              L("adesso", "now") if sec <= 0 else "-%d s" % sec))

    def mouseMoveEvent(self, ev):
        self.cursore = ev.position().x()
        self.update()

    def leaveEvent(self, ev):
        self.cursore = None
        self.update()


class CurvaEditor(QWidget):
    u"""La curva: gradi in orizzontale, percento in verticale, punti trascinabili.

    Sta DENTRO al grafico grande, in un angolo. Copre un pezzo — non c'e' modo
    di evitarlo — ma e' anche l'unica cosa che si MODIFICA invece di guardarla,
    e tenerla dove si guarda ha senso.

    ⚠️ SI PUO' SPOSTARE. Qualunque angolo si scelga, un giorno ci passa sotto la
    linea che interessa: invece di indovinare l'angolo giusto per tutti, la si
    prende per la barretta in alto e la si mette dove serve. La posizione viene
    tenuta anche quando la finestra cambia dimensione, e resta comunque dentro
    ai bordi del grafico.

    ⚠️ GLI ASSI SONO FISSI, 20-100 gradi e 0-100%. Una scala che si adatta ai
    dati fa sembrare identiche due curve completamente diverse.
    """

    T_MIN, T_MAX = 20.0, 100.0
    RAGGIO = 5
    MANIGLIA = 17          # l'altezza della barretta per spostarla
    ANGOLO = 15            # il quadratino in basso a destra per ridimensionarla

    def __init__(self, parent=None):
        super().__init__(parent)
        self.punti = [list(p) for p in PRESET["equilibrato"]]
        self.vivo = None
        self.cambiata = None
        self.spostata = None       # richiamo verso il grafico che la contiene
        self._trascinato = -1
        self._presa = None         # da dove si sta spostando il riquadro
        self._tira = None          # da dove si sta ridimensionando
        self.ridimensionata = None
        self.setMouseTracking(True)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)

    def _area(self):
        return QRect(34, self.MANIGLIA + 6, max(1, self.width() - 46),
                     max(30, self.height() - self.MANIGLIA - 28))

    def _px(self, t, y):
        a = self._area()
        return QPointF(a.left() + (t - self.T_MIN) / (self.T_MAX - self.T_MIN) * a.width(),
                       a.bottom() - y / 100.0 * a.height())

    def _val(self, pos):
        a = self._area()
        t = self.T_MIN + (pos.x() - a.left()) / max(1, a.width()) * (self.T_MAX - self.T_MIN)
        y = (a.bottom() - pos.y()) / max(1, a.height()) * 100.0
        return max(self.T_MIN, min(self.T_MAX, t)), max(0.0, min(100.0, y))

    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        a = self._area()
        # ⚠️ Fondo pieno e bordo: sta SOPRA al grafico grande, e senza uno stacco
        # netto le linee che ci passano dietro sembrerebbero parte della curva.
        p.fillRect(self.rect(), QColor("#15110d"))
        p.setPen(QPen(OTTONE_SCURO, 1))
        p.drawRect(0, 0, self.width() - 1, self.height() - 1)

        # la barretta per spostarla, con i solchi che si vedono nelle maniglie
        p.fillRect(QRect(1, 1, self.width() - 2, self.MANIGLIA), QColor("#241f19"))
        p.setPen(QPen(OTTONE, 1))
        p.setFont(QFont(self.font().family(), 8, QFont.Weight.Bold))
        p.drawText(7, self.MANIGLIA - 4, L("Curva", "Curve"))
        p.setPen(QPen(OTTONE_SCURO, 1))
        cx = self.width() // 2
        for i in range(-3, 4):
            p.drawLine(cx + i * 4, 5, cx + i * 4, self.MANIGLIA - 5)

        # il quadratino per tirarla: tre trattini in diagonale, come si usa
        p.setPen(QPen(OTTONE_SCURO, 1))
        for i in range(3):
            d = 4 + i * 4
            p.drawLine(self.width() - 3, self.height() - 3 - d,
                       self.width() - 3 - d, self.height() - 3)

        p.setFont(QFont(self.font().family(), 7))
        for t in range(int(self.T_MIN), int(self.T_MAX) + 1, 10):
            x = self._px(t, 0).x()
            p.setPen(QPen(GRIGLIA, 1))
            p.drawLine(int(x), a.top(), int(x), a.bottom())
            if t % 20 == 0:
                p.setPen(QPen(OTTONE_SCURO, 1))
                p.drawText(int(x) - 8, a.bottom() + 13, "%d°" % t)
        # ⚠️ Le percentuali ogni dieci, non ogni cinquanta: e' l'asse su cui si
        # decide quanto gira la ventola, e con tre sole tacche si trascinava un
        # punto senza sapere se lo si stava mettendo al 55 o al 70.
        for y in range(0, 101, 10):
            yy = self._px(self.T_MIN, y).y()
            p.setPen(QPen(GRIGLIA if y % 20 else QColor("#4a4036"), 1))
            p.drawLine(a.left(), int(yy), a.right(), int(yy))
            if y % 20 == 0:
                p.setPen(QPen(OTTONE_SCURO, 1))
                p.drawText(4, int(yy) + 4, "%d%%" % y)
        if not self.punti:
            return
        cam = QPainterPath()
        cam.moveTo(a.left(), self._px(max(self.T_MIN, self.punti[0][0]), self.punti[0][1]).y())
        for t, y in self.punti:
            cam.lineTo(self._px(max(self.T_MIN, min(self.T_MAX, t)), y))
        cam.lineTo(a.right(), self._px(self.T_MAX, self.punti[-1][1]).y())
        sotto = QPainterPath(cam)
        sotto.lineTo(a.right(), a.bottom())
        sotto.lineTo(a.left(), a.bottom())
        sotto.closeSubpath()
        sf = QLinearGradient(0, a.top(), 0, a.bottom())
        sf.setColorAt(0.0, QColor(216, 168, 73, 80))
        sf.setColorAt(1.0, QColor(216, 168, 73, 12))
        p.fillPath(sotto, QBrush(sf))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.setPen(QPen(OTTONE, 2))
        p.drawPath(cam)
        p.setFont(QFont(self.font().family(), 7))
        for t, y in self.punti:
            c = self._px(max(self.T_MIN, min(self.T_MAX, t)), y)
            p.setPen(QPen(QColor("#2b241c"), 2))
            p.setBrush(QBrush(OTTONE))
            p.drawEllipse(c, self.RAGGIO, self.RAGGIO)
            # il valore accanto al punto: trascinandolo si vede dove si sta
            # mettendo, senza doverlo leggere sulla griglia
            p.setPen(QPen(QColor("#c9b184"), 1))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawText(int(c.x()) + 7, int(c.y()) - 6, "%d%%" % round(y))
        if self.vivo:
            c = self._px(max(self.T_MIN, min(self.T_MAX, self.vivo[0])), self.vivo[1])
            p.setBrush(QBrush(VIVO))
            p.setPen(QPen(QColor("#0d1a20"), 2))
            p.drawEllipse(c, 4.5, 4.5)

    def _vicino(self, pos):
        for i, (t, y) in enumerate(self.punti):
            c = self._px(max(self.T_MIN, min(self.T_MAX, t)), y)
            if (c.x() - pos.x()) ** 2 + (c.y() - pos.y()) ** 2 <= (self.RAGGIO + 7) ** 2:
                return i
        return -1

    def _nell_angolo(self, pos):
        return (pos.x() >= self.width() - self.ANGOLO
                and pos.y() >= self.height() - self.ANGOLO)

    def mousePressEvent(self, ev):
        if self._nell_angolo(ev.position()):
            self._tira = (ev.globalPosition().toPoint(), self.width(), self.height())
            return
        if ev.position().y() <= self.MANIGLIA:
            self._presa = ev.globalPosition().toPoint() - self.pos()
            return
        i = self._vicino(ev.position())
        if ev.button() == Qt.MouseButton.RightButton:
            # ⚠️ mai sotto due punti: con uno solo la curva non e' piu' una curva
            if i >= 0 and len(self.punti) > 2:
                del self.punti[i]
                self._fatto()
            return
        self._trascinato = i

    def mouseDoubleClickEvent(self, ev):
        if (ev.position().y() <= self.MANIGLIA or self._nell_angolo(ev.position())
                or self._vicino(ev.position()) >= 0):
            return
        t, y = self._val(ev.position())
        self.punti.append([round(t, 1), round(y)])
        self._fatto()

    def mouseMoveEvent(self, ev):
        if self._tira is not None:
            partenza, l0, h0 = self._tira
            d = ev.globalPosition().toPoint() - partenza
            if self.ridimensionata:
                self.ridimensionata(l0 + d.x(), h0 + d.y())
            return
        if self._presa is not None:
            if self.spostata:
                self.spostata(ev.globalPosition().toPoint() - self._presa)
            return
        if self._trascinato < 0:
            if self._nell_angolo(ev.position()):
                self.setCursor(Qt.CursorShape.SizeFDiagCursor)
            elif ev.position().y() <= self.MANIGLIA:
                self.setCursor(Qt.CursorShape.SizeAllCursor)
            else:
                self.setCursor(Qt.CursorShape.ArrowCursor)
            return
        t, y = self._val(ev.position())
        i = self._trascinato
        # non si scavalca il vicino: l'ordine dei punti non cambia trascinando
        if i > 0:
            t = max(t, self.punti[i - 1][0] + 0.5)
        if i < len(self.punti) - 1:
            t = min(t, self.punti[i + 1][0] - 0.5)
        self.punti[i] = [round(t, 1), round(y)]
        self.update()

    def mouseReleaseEvent(self, ev):
        self._presa = None
        self._tira = None
        if self._trascinato >= 0:
            self._trascinato = -1
            self._fatto()

    def _fatto(self):
        self.punti.sort()
        # non decrescente: un punto trascinato sotto il precedente e' quasi
        # sempre uno scivolone del mouse, e vorrebbe dire raffreddare di meno
        # mentre ci si scalda.
        for i in range(1, len(self.punti)):
            if self.punti[i][1] < self.punti[i - 1][1]:
                self.punti[i][1] = self.punti[i - 1][1]
        self.update()
        if self.cambiata:
            self.cambiata()

    def imposta(self, punti):
        self.punti = [list(p) for p in punti]
        self.update()

    def aggiorna_vivo(self, t, duty):
        self.vivo = None if t is None else (t, duty)
        self.update()


class Tessera(QFrame):
    u"""Un valore: pallino del colore della linea, nome, numero con l'unita'.

    Cliccandola si accende e si spegne la linea nel grafico; con un doppio clic
    si riscrive il nome. Le tessere SONO la legenda: tenerne una copia altrove
    vorrebbe dire due elenchi degli stessi numeri.
    """
    premuta = pyqtSignal(str)
    rinominata = pyqtSignal(str)

    def __init__(self, chiave, parent=None):
        super().__init__(parent)
        self.chiave = chiave
        self.setFrameShape(QFrame.Shape.StyledPanel)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        g = QVBoxLayout(self)
        g.setContentsMargins(8, 4, 8, 4)
        g.setSpacing(0)
        self.nome = QLabel("")
        self.nome.setStyleSheet("font-size: 10px;")
        self.valore = QLabel("")
        self.valore.setStyleSheet("font-size: 15px; font-weight: bold;")
        g.addWidget(self.nome)
        g.addWidget(self.valore)

    def aggiorna(self, s):
        col = s["colore"].name()
        acceso = s["visibile"]
        self.nome.setText(s["etichetta"])
        v = s["punti"][-1][1] if s["punti"] else None
        dec = {"C": 1, "%": 0, "rpm": 0, "W": 1, "V": 3}.get(s["unita"], 1)
        self.valore.setText("—" if v is None
                            else ("%." + str(dec) + "f %s") % (v, s["unita"]))
        self.nome.setStyleSheet("font-size:10px; color:%s;"
                                % (col if acceso else "#7a6c58"))
        self.valore.setStyleSheet("font-size:15px; font-weight:bold; color:%s;"
                                  % (col if acceso else "#8a7c68"))
        self.setStyleSheet("QFrame { border:1px solid %s; border-radius:4px; "
                           "background:%s; }"
                           % (col if acceso else "#3a322a",
                              "#241f19" if acceso else "#1b1713"))

    def mousePressEvent(self, ev):
        self.premuta.emit(self.chiave)

    def mouseDoubleClickEvent(self, ev):
        self.rinominata.emit(self.chiave)


# ---------- utilita' ----------
def leggi_json(percorso, ripiego):
    try:
        with io.open(percorso, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else ripiego
    except (IOError, OSError, ValueError):
        return ripiego


# Le linee FISSE: quelle che devono stare ferme sul loro valore, e su cui un
# allarme ha senso. Sono le uscite dell'alimentatore e i riferimenti del chip.
RAIL_FISSE = {"+12v": 12.0, "+5v": 5.0, "+3.3v": 3.3, "3vcc": 3.3,
              "avcc": 3.3, "avcc3": 3.3, "avsb": 3.3, "vcc": 3.3}

# ⚠️ QUESTE NON SI SORVEGLIANO, e non e' una dimenticanza.
#
# vddgfx e vddnb sono le tensioni interne dell'APU: SI MUOVONO PER PROGETTO,
# perche' il silicio le alza e le abbassa insieme alla frequenza. La prima
# versione le trattava come le altre e sullo schermo compariva
# «vddnb: 0.743 V invece di 1.09 V» a macchina ferma e sana. Un allarme che si
# accende quando va tutto bene e' peggio di nessun allarme: si impara a
# ignorarlo, e il giorno che ha ragione non lo guarda nessuno.
#
# VBat e' il caso opposto: fermo davvero, ma il chip lo legge attraverso un
# partitore suo e su questa scheda dichiara 2,03 V per una pila da 3 V. Il
# valore «giusto» dipende dalla scheda e non lo sappiamo, quindi si mostra e
# basta.
#
# Restano visibili tutte: mostrare senza allarmare e' diverso da nascondere.
DINAMICHE = ("vddgfx", "vddnb", "vcore", "cpu vcore", "cpu soc", "cpu vddp",
             "cpu sa", "cpu 1p8", "dram", "chipset", "vbat", "vid", "vtt")

# Quanti campioni prima di fidarsi del valore di riposo imparato. Uno solo
# sarebbe un colpo di fortuna: se capita durante un picco, quello diventa il
# riferimento e tutto il resto sembra sbagliato.
CAMPIONI_RIPOSO = 20


def nominale(etichetta):
    u"""Il valore atteso di una linea, se e' una linea fissa che conosciamo."""
    e = (etichetta or "").strip().lower()
    if any(d in e for d in DINAMICHE):
        return "dinamica"
    return RAIL_FISSE.get(e)


class Prova(QThread):
    u"""La prova del PWM gira in un filo suo: dura mezzo minuto.

    Nella finestra principale bloccherebbe tutto — niente aggiornamento delle
    temperature proprio mentre la ventola va al massimo, che e' l'unico momento
    in cui uno vorrebbe guardarle."""
    finita = pyqtSignal(bool, str)

    def __init__(self, pwm, fan, parent=None):
        super().__init__(parent)
        self.pwm, self.fan = pwm, fan

    def run(self):
        try:
            p = subprocess.run(["pkexec", HELPER, "prova"],
                               input=json.dumps({"pwm": self.pwm, "fan": self.fan}),
                               capture_output=True, text=True, timeout=180)
        except Exception as e:
            self.finita.emit(False, str(e))
            return
        if p.returncode != 0:
            self.finita.emit(False, (p.stderr or p.stdout or "").strip())
            return
        try:
            d = json.loads(p.stdout)
        except ValueError:
            self.finita.emit(False, p.stdout[:200])
            return
        giri = ", ".join("%s%% -> %s" % (round(x["pwm"] * 100 / 255), x["rpm"])
                         for x in d.get("letture", []))
        self.finita.emit(bool(d.get("risponde")), giri)


class Pannello(QDialog):
    u"""Un riquadro che si apre quando serve, e per il resto non c'e'.

    LO STANDARD DELLE NOSTRE APPLICAZIONI: la finestra principale mostra quello
    che si guarda, e le regolazioni si aprono a richiesta. Qui la differenza e'
    grossa — sorgente, anticipo e freni sono tre gruppi di comandi che si
    toccano una volta e poi restano fermi per mesi, e tenerli sempre a schermo
    voleva dire una colonna alta quanto la finestra accanto alla cosa che invece
    si guarda davvero, cioe' il grafico.

    ⚠️ Non e' modale: si puo' regolare l'anticipo e intanto guardare il grafico
    che risponde. Un pannello modale che copre il grafico mentre si regola il
    grafico non serve a niente.

    ⚠️ Il contenuto NON si ricostruisce a ogni apertura: e' sempre lo stesso
    widget, che vive anche a pannello chiuso. Cosi' i valori restano quelli che
    si stavano scrivendo, e chi aggiorna le letture non deve sapere se qualcuno
    sta guardando.
    """

    def __init__(self, titolo, contenuto, parent=None):
        super().__init__(parent)
        self.setWindowTitle(titolo)
        self.setModal(False)
        v = QVBoxLayout(self)
        v.setContentsMargins(10, 10, 10, 10)
        v.addWidget(contenuto)
        riga = QHBoxLayout()
        riga.addStretch(1)
        b = QPushButton(L("Chiudi", "Close"))
        b.clicked.connect(self.hide)
        riga.addWidget(b)
        v.addLayout(riga)

    def mostra(self):
        self.show()
        self.raise_()
        self.activateWindow()


# ---------- la finestra ----------
class Finestra(QMainWindow):

    def __init__(self):
        super().__init__()
        self.setWindowTitle(L("SkillFishOS Ventola", "SkillFishOS Fan Control"))
        if os.path.exists(ICON):
            self.setWindowIcon(QIcon(ICON))
        self.conf = leggi_json(CONF, {})
        self.stato = leggi_json(STATO, {})
        self.etichette = leggi_json(ETICHETTE, {})
        self.riposo = {}          # tensione -> valore di riposo imparato
        self.caselle_sorgente = {}
        self.tessere = {}
        self.pannelli_serie = {}

        centro = QWidget()
        self.setCentralWidget(centro)
        fuori = QVBoxLayout(centro)
        fuori.setContentsMargins(10, 10, 10, 10)
        fuori.setSpacing(8)

        # LA DISPOSIZIONE
        #   a sinistra   le tessere: temperature, ventola, giri, watt, tensioni;
        #   a destra     UN SOLO grafico, che scorre nel tempo;
        #   in basso     la curva, i preset e i pulsanti.
        #
        # ⚠️ Le tessere SONO la legenda e sono anche i valori: si accendono e si
        # spengono cliccandole, e con un doppio clic si riscrive il nome. Prima
        # c'erano una legenda sotto al grafico E una sezione con gli stessi
        # numeri: due elenchi delle stesse cose.
        corpo = QHBoxLayout()
        corpo.setSpacing(10)
        fuori.addLayout(corpo, 1)

        lato = QScrollArea()
        lato.setWidgetResizable(True)
        lato.setFrameShape(QFrame.Shape.NoFrame)
        lato.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        # ⚠️ Anche quella verticale sparisce: la rotellina continua a funzionare
        # lo stesso, e una barra di scorrimento accanto ai numeri ruba spazio e
        # attira l'occhio su niente. Stessa scelta della pagina web, cosi' le due
        # si somigliano davvero invece che quasi.
        lato.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        lato.setFixedWidth(LARGHEZZA_TESSERE)
        gabbia = QWidget()
        self.tessere_lato = QVBoxLayout(gabbia)
        self.tessere_lato.setContentsMargins(0, 0, 4, 0)
        self.tessere_lato.setSpacing(5)
        self.tessere_lato.addStretch(1)
        lato.setWidget(gabbia)
        corpo.addWidget(lato, 0)

        destra = QVBoxLayout()
        destra.setSpacing(6)
        corpo.addLayout(destra, 1)

        cima = QHBoxLayout()
        cima.addWidget(QLabel("<b>%s</b>" % L("Ultimi 5 minuti", "Last 5 minutes")))
        cima.addStretch(1)
        self.et_motivo = QLabel("")
        self.et_motivo.setStyleSheet("color: #9a8a70;")
        cima.addWidget(self.et_motivo)
        cima.addStretch(1)
        cima.addWidget(QLabel(L("Aggiornamento", "Refresh")))
        self.intervallo = QComboBox()
        # ⚠️ Rallentare non impoverisce piu' il grafico: i campioni li prende
        # il demone, sempre una volta al secondo. Questo e' solo il ritmo con
        # cui la finestra RIDISEGNA, e sopra i cinque secondi si sente: mentre
        # giochi, ridisegnare dodici linee lo paghi sui fotogrammi.
        for testo, ms in (("1 s", 1000), ("2 s", 2000), ("5 s", 5000),
                          ("10 s", 10000), ("15 s", 15000), ("30 s", 30000)):
            self.intervallo.addItem(testo, ms)
        self.intervallo.currentIndexChanged.connect(self._cambia_intervallo)
        cima.addWidget(self.intervallo)
        cima.addWidget(_aiuto("grafico", self))
        destra.addLayout(cima)

        self.grafico = Grafico()
        self.grafico.nuova_serie = self._rifai_tessere
        self.grafico.apri_serie = self._apri_serie
        destra.addWidget(self.grafico, 1)

        self.et_allarme = QLabel("")
        self.et_allarme.setWordWrap(True)
        self.et_allarme.setStyleSheet("color:#e0703a; font-weight:bold;")
        destra.addWidget(self.et_allarme)

        # -- la striscia in basso: curva, preset, pulsanti --------------------
        basso = QHBoxLayout()
        basso.setSpacing(10)
        fuori.addLayout(basso, 0)

        # ⚠️ La curva non e' qui: sta nell'angolo in basso a sinistra DENTRO al
        # grafico. Qui restano i preset, che sono la cosa che la cambia.
        self.curva = self.grafico.inserto
        self.curva.cambiata = self._curva_toccata
        self.curva.imposta(self.conf.get("curva") or PRESET["equilibrato"])
        gc = QVBoxLayout()
        gc.setSpacing(2)
        intest = QHBoxLayout()
        intest.addWidget(QLabel("<b>%s</b>" % L("Curva", "Curve")))
        intest.addWidget(_aiuto("curva", self))
        intest.addStretch(1)
        gc.addLayout(intest)
        gc.addLayout(self._preset())
        basso.addLayout(gc)

        pulsanti = QVBoxLayout()
        pulsanti.setSpacing(4)
        # ⚠️ Sorgente, anticipo e freni si aprono a richiesta: sono comandi che
        # si toccano una volta e poi restano fermi per mesi, e tenerli sempre a
        # schermo ruba spazio alla cosa che invece si guarda.
        self.pannelli = {}
        for nome, titolo, costruisci in (
                ("sorgente", L("Sorgente", "Source"), self._sez_sorgente),
                ("anticipo", L("Anticipo", "Lead"), self._sez_anticipo),
                ("sicurezza", L("Sicurezza", "Safety"), self._sez_sicurezza)):
            self.pannelli[nome] = Pannello(titolo, costruisci(), self)
            b = QPushButton(titolo)
            b.clicked.connect(lambda _c=False, k=nome: self.pannelli[k].mostra())
            pulsanti.addWidget(b)
        basso.addLayout(pulsanti)

        basso.addStretch(1)

        fine = QVBoxLayout()
        fine.addStretch(1)
        self.interruttore = QCheckBox(L("Controllo", "Control"))
        self.interruttore.setToolTip(L(
            "Se e' spento la ventola resta al firmware e la curva non ha effetto.",
            "With this off the fan stays with the firmware and the curve does nothing."))
        self.interruttore.setChecked(bool(self.conf.get("attivo")))
        # ⚠️ Accorciare la voce a una parola l'ha resa ambigua: «Controllo» non
        # dice che spegnendolo si perde anche l'emergenza termica. La parola
        # resta corta e la spiegazione va dietro al «?», come nel resto delle
        # nostre applicazioni.
        ri = QHBoxLayout()
        ri.setSpacing(4)
        ri.addWidget(self.interruttore)
        ri.addWidget(_aiuto("controllo", self))
        ri.addStretch(1)
        fine.addLayout(ri)
        self.etichetta_salva = QLabel("")
        self.etichetta_salva.setStyleSheet("color:#9a8a70;")
        self.etichetta_salva.setWordWrap(True)
        fine.addWidget(self.etichetta_salva)
        b = QPushButton(L("Applica", "Apply"))
        b.setMinimumHeight(34)
        b.clicked.connect(self.salva)
        fine.addWidget(b)
        basso.addLayout(fine)

        self._adatta_allo_schermo()

        self.orologio = QTimer(self)
        self.orologio.timeout.connect(self.aggiorna)
        self.orologio.start(1000)
        self.aggiorna()

    def _adatta_allo_schermo(self):
        u"""Grande quanto ci sta.

        ⚠️ Qui non si stringe piu' sull'altezza del contenuto: adesso il
        contenuto principale e' il grafico, che si allarga a riempire quello che
        gli si da'. Stringere vorrebbe dire rimpicciolire la cosa che si guarda.
        """
        sc = QApplication.primaryScreen()
        d = sc.availableGeometry() if sc else QRect(0, 0, 1280, 800)
        larg = min(1700, max(940, int(d.width() * 0.84)))
        alt = min(1050, max(600, int(d.height() * 0.86)))
        self.resize(larg, alt)
        self.move(d.left() + max(0, (d.width() - larg) // 2),
                  d.top() + max(0, (d.height() - alt) // 2))

    def _aggiorna_grafico(self, s, t):
        u"""Porta al grafico tutto quello che il demone ha appena pubblicato.

        Le letture arrivano gia' pronte in /run/skillfish/ventola.json: qui si
        traducono in serie, una per canale, piu' la ventola in percento che il
        demone non e' un sensore ma e' la cosa che si vuole confrontare con
        tutto il resto.
        """
        adesso = float(s.get("aggiornato") or 0) or 0.0
        if not adesso:
            return
        letture = []
        for x in s.get("sensori") or []:
            if x.get("value") is None:
                continue
            letture.append((x["key"], x.get("label") or x["key"],
                            x.get("unit") or "", x["value"]))
        duty = s.get("duty")
        if duty is not None:
            letture.append(("__ventola__", L("Ventola", "Fan"), "%", float(duty)))
        self.grafico.campiona(adesso, t, letture)
        self.legenda.aggiorna_valori()
        self.grafico.aggiorna_vivo(t, float(duty or 0))


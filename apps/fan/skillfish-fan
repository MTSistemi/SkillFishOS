# ---------- i18n ----------
def _detect_lang():
    # Ordine standard dei locale: LC_ALL batte LC_MESSAGES batte LANG.
    val = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
           or os.environ.get("LANG") or os.environ.get("LANGUAGE") or "")
    v = val.lower()
    if v.startswith("it"):
        return "it"
    # "uk" e' il codice della lingua ucraina; "ua" e' quello del PAESE e non
    # dovrebbe comparire, ma nei locale scritti a mano capita.
    if v.startswith("ua"):
        return "uk"
    codice = v.replace("-", "_").split(".")[0].split("@")[0].split("_")[0].strip()
    if len(codice) == 2 and codice.isalpha():
        return codice
    return "en"


LANG = _detect_lang()

# ⚠️ Il dizionario condiviso non deve mai impedire alla finestra di aprirsi.
try:
    sys.path.insert(0, "/usr/share/skillfish")
    from i18n import traduttore as _traduttore
    _TR = _traduttore(LANG)
except Exception:
    def _TR(en):
        return en


def L(it, en):
    u"""La stringa in italiano o quella tradotta dal dizionario condiviso.

    ⚠️ TUTTO CIO' CHE CHIAMA L() DEVE STARE SOTTO QUESTA RIGA. Nel pannello AI
    una costante che chiamava L() era finita venti righe piu' in su della sua
    definizione: il corpo del modulo si esegue dall'alto in basso, quindi la
    chiamata avveniva prima che la funzione esistesse e la finestra non si
    apriva affatto. py_compile passava, perche' e' un errore di esecuzione, non
    di sintassi."""
    return it if LANG == "it" else _TR(en)



def L(it, en):
    u"""La stringa in italiano o quella tradotta dal dizionario condiviso.

    ⚠️ TUTTO CIO' CHE CHIAMA L() DEVE STARE SOTTO QUESTA RIGA. Nel pannello AI
    una costante che chiamava L() era finita venti righe piu' in su della sua
    definizione: il corpo del modulo si esegue dall'alto in basso, quindi la
    chiamata avveniva prima che la funzione esistesse e la finestra non si
    apriva affatto. py_compile passava, perche' e' un errore di esecuzione, non
    di sintassi."""
    return it if LANG == "it" else _TR(en)



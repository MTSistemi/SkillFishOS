def leggi_json(percorso, ripiego):
    try:
        with io.open(percorso, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else ripiego
    except (IOError, OSError, ValueError):
        return ripiego


# Le linee FISSE: quelle che devono stare ferme sul loro valore, e su cui un
# allarme ha senso. Sono le uscite dell'alimentatore e i riferimenti del chip.
RAIL_FISSE = {"+12v": 12.0, "+5v": 5.0, "+3.3v": 3.3, "3vcc": 3.3,
              "avcc": 3.3, "avcc3": 3.3, "avsb": 3.3, "vcc": 3.3}

# ⚠️ QUESTE NON SI SORVEGLIANO, e non e' una dimenticanza.
#
# vddgfx e vddnb sono le tensioni interne dell'APU: SI MUOVONO PER PROGETTO,
# perche' il silicio le alza e le abbassa insieme alla frequenza. La prima
# versione le trattava come le altre e sullo schermo compariva
# «vddnb: 0.743 V invece di 1.09 V» a macchina ferma e sana. Un allarme che si
# accende quando va tutto bene e' peggio di nessun allarme: si impara a
# ignorarlo, e il giorno che ha ragione non lo guarda nessuno.
#
# VBat e' il caso opposto: fermo davvero, ma il chip lo legge attraverso un
# partitore suo e su questa scheda dichiara 2,03 V per una pila da 3 V. Il
# valore «giusto» dipende dalla scheda e non lo sappiamo, quindi si mostra e
# basta.
#
# Restano visibili tutte: mostrare senza allarmare e' diverso da nascondere.
DINAMICHE = ("vddgfx", "vddnb", "vcore", "cpu vcore", "cpu soc", "cpu vddp",
             "cpu sa", "cpu 1p8", "dram", "chipset", "vbat", "vid", "vtt")

# Quanti campioni prima di fidarsi del valore di riposo imparato. Uno solo
# sarebbe un colpo di fortuna: se capita durante un picco, quello diventa il
# riferimento e tutto il resto sembra sbagliato.
CAMPIONI_RIPOSO = 20


def nominale(etichetta):
    u"""Il valore atteso di una linea, se e' una linea fissa che conosciamo."""
    e = (etichetta or "").strip().lower()
    if any(d in e for d in DINAMICHE):
        return "dinamica"
    return RAIL_FISSE.get(e)


class Prova(QThread):
    u"""La prova del PWM gira in un filo suo: dura mezzo minuto.

    Nella finestra principale bloccherebbe tutto — niente aggiornamento delle
    temperature proprio mentre la ventola va al massimo, che e' l'unico momento
    in cui uno vorrebbe guardarle."""
    finita = pyqtSignal(bool, str)

    def __init__(self, pwm, fan, parent=None):
        super().__init__(parent)
        self.pwm, self.fan = pwm, fan

    def run(self):
        try:
            p = subprocess.run(["pkexec", HELPER, "prova"],
                               input=json.dumps({"pwm": self.pwm, "fan": self.fan}),
                               capture_output=True, text=True, timeout=180)
        except Exception as e:
            self.finita.emit(False, str(e))
            return
        if p.returncode != 0:
            self.finita.emit(False, (p.stderr or p.stdout or "").strip())
            return
        try:
            d = json.loads(p.stdout)
        except ValueError:
            self.finita.emit(False, p.stdout[:200])
            return
        giri = ", ".join("%s%% -> %s" % (round(x["pwm"] * 100 / 255), x["rpm"])
                         for x in d.get("letture", []))
        self.finita.emit(bool(d.get("risponde")), giri)


class Pannello(QDialog):
    u"""Un riquadro che si apre quando serve, e per il resto non c'e'.

    LO STANDARD DELLE NOSTRE APPLICAZIONI: la finestra principale mostra quello
    che si guarda, e le regolazioni si aprono a richiesta. Qui la differenza e'
    grossa — sorgente, anticipo e freni sono tre gruppi di comandi che si
    toccano una volta e poi restano fermi per mesi, e tenerli sempre a schermo
    voleva dire una colonna alta quanto la finestra accanto alla cosa che invece
    si guarda davvero, cioe' il grafico.

    ⚠️ Non e' modale: si puo' regolare l'anticipo e intanto guardare il grafico
    che risponde. Un pannello modale che copre il grafico mentre si regola il
    grafico non serve a niente.

    ⚠️ Il contenuto NON si ricostruisce a ogni apertura: e' sempre lo stesso
    widget, che vive anche a pannello chiuso. Cosi' i valori restano quelli che
    si stavano scrivendo, e chi aggiorna le letture non deve sapere se qualcuno
    sta guardando.
    """

    def __init__(self, titolo, contenuto, parent=None):
        super().__init__(parent)
        self.setWindowTitle(titolo)
        self.setModal(False)
        v = QVBoxLayout(self)
        v.setContentsMargins(10, 10, 10, 10)
        v.addWidget(contenuto)
        riga = QHBoxLayout()
        riga.addStretch(1)
        b = QPushButton(L("Chiudi", "Close"))
        b.clicked.connect(self.hide)
        riga.addWidget(b)
        v.addLayout(riga)

    def mostra(self):
        self.show()
        self.raise_()
        self.activateWindow()



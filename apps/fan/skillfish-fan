                "non cambiano — su questa macchina la ventola la governa il firmware, "
                "e la curva non ha effetto.",
                "Tested: the fan does NOT respond. The value is accepted and the speed "
                "does not change — on this machine the firmware keeps the fan to "
                "itself, and the curve has no effect."))

    def _prova_uscita(self):
        sensori = (self.stato or {}).get("sensori") or []
        ventole = [x for x in sensori if x.get("type") == "fan" and x.get("value")]
        pwm = self.conf.get("pwm") or self._scegli_pwm()
        if not ventole or not pwm:
            QMessageBox.information(self, L("Non si puo' provare", "Cannot test"), L(
                "Serve un'uscita PWM e una ventola che dia i giri. Su questa macchina "
                "manca almeno una delle due.",
                "This needs a PWM output and a fan that reports its speed. At least one "
                "of the two is missing on this machine."))
            return
        self.bottone_prova.setEnabled(False)
        self.et_prova.setStyleSheet("color:#9a8a70;")
        self.et_prova.setText(L("Prova in corso, una trentina di secondi. Si sente.",
                                "Testing, about thirty seconds. You will hear it."))
        self._filo = Prova(pwm, ventole[0]["key"], self)
        self._filo.finita.connect(self._prova_finita)
        self._filo.start()

    def _prova_finita(self, risponde, dettaglio):
        self.bottone_prova.setEnabled(True)
        self._mostra_prova(leggi_json(PROVA, {}) or {"risponde": risponde})
        if dettaglio:
            self.et_prova.setText(self.et_prova.text() + chr(10) + dettaglio)

    def _curva_toccata(self):
        u"""Trascinare un punto vuol dire «personalizzata»: nessun preset e'
        piu' quello scelto, e dirlo subito evita che si prema Usa credendo di
        confermare la curva che si ha davanti."""
        for b in self.gruppo.buttons():
            self.gruppo.setExclusive(False)
            b.setChecked(False)
            self.gruppo.setExclusive(True)
        self.etichetta_salva.setText(L("modificata, non ancora applicata",
                                       "changed, not applied yet"))

    def _preset_scelto(self):
        for b in self.gruppo.buttons():
            if b.isChecked():
                return b.chiave
        return "personalizzata"

    def _svuota(self, layout):
        while layout.count():
            v = layout.takeAt(0)
            w = v.widget()
            if w:
                w.deleteLater()
            elif v.layout():
                self._svuota(v.layout())

    # -- vita ---------------------------------------------------------------
    def _cambia_intervallo(self):
        u"""Ogni quanto la finestra rilegge e ridisegna.

        ⚠️ Il demone campiona una volta al secondo e non cambia ritmo: questo e'
        il ritmo della FINESTRA. Sotto il secondo non ci sarebbe niente di nuovo
        da mostrare, quindi la scelta parte da un secondo. Rallentare serve su
        una macchina carica: ridisegnare un grafico con dodici linee costa, e
        mentre si gioca quel costo lo si paga sui fotogrammi."""
        # ⚠️ currentIndexChanged scatta gia' aggiungendo la prima voce, mentre
        # la finestra si sta ancora costruendo e l'orologio non c'e'. L'errore
        # sarebbe finito dentro a uno slot Qt: scritto su stderr e ingoiato.
        if not hasattr(self, "orologio"):
            return
        self.orologio.setInterval(self.intervallo.currentData() or 1000)

    def _apri_serie(self, chiave):
        u"""Un clic sul grafico apre quella linea da sola.

        Nel grafico grande le unita' convivono in proporzione e l'asse verticale
        non puo' portare i numeri di nessuna. Qui la serie e' una sola, quindi
        l'asse ha i suoi volt, i suoi watt o i suoi gradi.

        ⚠️ Un pannello per serie, e si riusa: cliccando due volte sulla stessa
        linea non si aprono due finestre uguali."""
        s = self.grafico.serie.get(chiave)
        if not s:
            return
        p = self.pannelli_serie.get(chiave)
        if p is None:
            g = GraficoSingolo(self.grafico, chiave)
            p = Pannello(s["etichetta"], g, self)
            p.resize(700, 400)
            self.pannelli_serie[chiave] = p
        p.setWindowTitle(s["etichetta"])
        p.mostra()

    def _tessera(self, chiave):
        t = self.tessere.get(chiave)
        if t is None:
            t = Tessera(chiave)
            t.premuta.connect(self._accendi_serie)
            t.rinominata.connect(self._rinomina_serie)
            self.tessere[chiave] = t
        return t

    def _rifai_tessere(self):
        u"""Le tessere: quattro sopra, il resto nella colonna a destra.

        Sopra vanno i quattro numeri che si guardano sempre — la temperatura che
        comanda, la ventola, i giri, i watt — e sono grossi. Le altre stanno di
        lato. Nessuna compare due volte: erano due elenchi degli stessi numeri e
        il secondo non serviva a niente.
        """
        # ⚠️ In cima vanno i quattro numeri che si guardano sempre — la
        # temperatura che comanda, la ventola, i giri, i watt — e poi tutti gli
        # altri. Nessuno compare due volte.
        elenco = self.grafico.elenco()
        primi = ["__temperatura__", "__ventola__"]
        for unita in ("rpm", "W"):
            for k, s in elenco:
                if s["unita"] == unita:
                    primi.append(k)
                    break
        while self.tessere_lato.count():
            v = self.tessere_lato.takeAt(0)
            if v.widget():
                v.widget().setParent(None)
        for k in primi:
            if k in self.grafico.serie:
                self.tessere_lato.addWidget(self._tessera(k))
        for k, s in elenco:
            if k not in primi:
                self.tessere_lato.addWidget(self._tessera(k))
        self.tessere_lato.addStretch(1)

    def _accendi_serie(self, chiave):
        s = self.grafico.serie.get(chiave)
        if s:
            s["visibile"] = not s["visibile"]
            self.grafico.update()
            self._tessera(chiave).aggiorna(s)

    def _rinomina_serie(self, chiave):
        s = self.grafico.serie.get(chiave)
        if not s or chiave.startswith("__"):
            return
        nuovo, ok = QInputDialog.getText(
            self, L("Nome del sensore", "Sensor name"),
            L("Come si chiama davvero questo sensore?",
              "What is this sensor really called?"), text=s["etichetta"])
        if not ok or not nuovo.strip():
            return
        self.etichette[chiave] = nuovo.strip()[:40]
        s["etichetta"] = nuovo.strip()[:40]
        self._tessera(chiave).aggiorna(s)
        self._helper("etichette", self.etichette)

    def aggiorna(self):
        self.stato = leggi_json(STATO, {})
        s = self.stato
        if not s:
            self.et_motivo.setText(L(
                "Il controllo della ventola non sta girando. Premi Applica per accenderlo.",
                "The fan controller is not running. Press Apply to start it."))
            return

        t = s.get("temperatura")
        motivo = (s.get("motivo") or "")
        testo = {
            "curve": L("segue la curva", "following the curve"),
            "no temperature: full speed": L(
                "nessuna temperatura leggibile: al massimo per sicurezza",
                "no readable temperature: full speed, to be safe"),
        }.get(motivo, motivo)
        if motivo.startswith("emergency"):
            testo = L("EMERGENZA: al massimo", "EMERGENCY: full speed")
        elif motivo.startswith("anticipating"):
            testo = L("sta anticipando la salita", "anticipating the rise")
        elif motivo.startswith("pre-cooling"):
            testo = L("pre-raffredda per %s", "pre-cooling for %s") % (s.get("gioco") or "")
        if not s.get("in_controllo"):
            testo = L("la ventola e' ancora del firmware: la curva non e' attiva",
                      "the fan still belongs to the firmware: the curve is not in charge")
        self.et_motivo.setText(testo)

        sensori = s.get("sensori") or []
        self._riempi_sorgente(sensori)
        self._allarmi(sensori)

        meta = {x["key"]: (x.get("label") or x["key"], x.get("unit") or "")
                for x in sensori}
        meta["__ventola__"] = (L("Ventola", "Fan"), "%")
        meta["__temperatura__"] = (L("Temperatura", "Temperature"), "C")
        self.grafico.carica(s.get("storia") or {}, meta)
        for chiave, serie in self.grafico.elenco():
            w = self.tessere.get(chiave)
            if w is not None:
                w.aggiorna(serie)
        self.curva.aggiorna_vivo(t, float(s.get("duty") or 0))
        if s.get("gioco"):
            self.et_gioco.setText(L("Ultimo riconosciuto: %s", "Last recognised: %s")
                                  % s["gioco"])

    def _allarmi(self, sensori):
        u"""Le tensioni fuori posto, dette una volta sola e in un posto solo."""
        allarmi = []
        for x in sensori:
            if x.get("type") != "in" or x.get("value") is None:
                continue
            v = x["value"]
            atteso = nominale(x.get("label"))
            if atteso == "dinamica":
                continue           # si muove per progetto: si mostra, non si allarma
            if atteso is None:
                storia = self.riposo.setdefault(x["key"], [])
                if len(storia) < CAMPIONI_RIPOSO:
                    storia.append(v)
                    continue
                o = sorted(storia)
                atteso = o[len(o) // 2]
                tolleranza = 0.10
            else:
                tolleranza = 0.05
            if atteso and abs(v - atteso) / atteso > tolleranza:
                allarmi.append(L("%s: %.3f V invece di %.2f V",
                                 "%s: %.3f V instead of %.2f V")
                               % (x.get("label") or x["key"], v, atteso))
        self.et_allarme.setText("\n".join(allarmi[:3]))

    def _riempi_sorgente(self, sensori):
        temp = [x for x in sensori if x.get("type") == "temp"]
        chiavi = [x["key"] for x in temp]
        if set(chiavi) != set(self.caselle_sorgente):
            self._svuota(self.contenitore_sorgente)
            self.caselle_sorgente = {}
            scelte = set(self.conf.get("sorgente") or [])
            for x in temp:
                c = QCheckBox(x["label"])
                c.setChecked(x["key"] in scelte)
                self.caselle_sorgente[x["key"]] = c
                h = QHBoxLayout()
                h.addWidget(c)
                h.addStretch(1)
                val = QLabel("")
                val.setStyleSheet("color:#d8a849;")
                h.addWidget(val)
                c.valore = val
                self.contenitore_sorgente.addLayout(h)
        for x in temp:
            c = self.caselle_sorgente.get(x["key"])
            if c is not None and x.get("value") is not None:
                c.valore.setText("%.1f °C" % x["value"])

    # -- salvataggio --------------------------------------------------------
    def salva(self):
        sorgenti = [k for k, c in self.caselle_sorgente.items() if c.isChecked()]
        pwm = self.conf.get("pwm") or self._scegli_pwm()
        if self.interruttore.isChecked() and not sorgenti:
            QMessageBox.warning(self, L("Manca la sorgente", "No source chosen"), L(
                "Scegli almeno una temperatura da usare come sorgente della curva.",
                "Pick at least one temperature for the curve to follow."))
            return
        if self.interruttore.isChecked() and not pwm:
            QMessageBox.warning(self, L("Nessuna uscita", "No output"), L(
                "Su questa macchina non ho trovato un'uscita PWM che si possa comandare.",
                "I could not find a controllable PWM output on this machine."))
            return

        conf = {
            "attivo": self.interruttore.isChecked(),
            "pwm": pwm,
            "sorgente": sorgenti,
            "curva": self.curva.punti,
            "minimo": self.minimo.value(),
            "isteresi": self.isteresi.value(),
            "emergenza": self.emergenza.value(),
            "preset": self._preset_scelto(),
            "predittivo": {
                "attivo": self.pred_attivo.isChecked(),
                "guadagno": self.guadagno.value(),
                "finestra": self.finestra.value(),
                "preraffredda": self.preraffredda.value(),
            },
        }
        ok, msg = self._helper("scrivi", conf)
        if ok:
            self.conf = conf
            self.etichetta_salva.setText(L("applicata", "applied"))
        else:
            QMessageBox.critical(self, L("Non riesco a salvare", "Could not save"), msg)

    def _scegli_pwm(self):
        u"""L'uscita da comandare, se non e' gia' scelta.

        Si prende quella gia' in modo manuale sullo stesso chip della ventola
        che legge: sulla BC-250 e' pwm2, l'unica che non e' governata dal chip.
        Non e' un indovinello — e' l'unica configurazione coerente possibile
        quando c'e' una sola ventola vera."""
        sensori = (self.stato or {}).get("sensori") or []
        ventole = [x for x in sensori if x.get("type") == "fan" and x.get("value")]
        chip = ventole[0]["key"].split(":")[0] if ventole else ""
        try:
            sys.path.insert(0, "/usr/share/skillfish")
            import hwmon
            _, pwm = hwmon.elenca()
        except Exception:
            return ""
        candidate = [p for p in pwm if p.modo is not None and p.modo >= 0]
        if chip:
            stesso = [p for p in candidate if p.chiave.split(":")[0] == chip]
            candidate = stesso or candidate
        for p in candidate:
            if p.modo == 1:
                return p.chiave
        return candidate[0].chiave if candidate else ""

    @staticmethod
    def _helper(azione, dati):
        try:
            p = subprocess.run(["pkexec", HELPER, azione],
                               input=json.dumps(dati), capture_output=True,
                               text=True, timeout=120)
        except Exception as e:
            return False, str(e)
        if p.returncode == 0:
            return True, ""
        msg = (p.stderr or p.stdout or "").strip()
        if p.returncode == 126:
            msg = L("Autenticazione annullata.", "Authentication cancelled.")
        return False, msg or L("errore sconosciuto", "unknown error")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("SkillFishOS Fan Control")
    # ⚠️ SENZA QUESTA RIGA la barra delle applicazioni scrive «python3».
    # KDE lega la finestra al file .desktop attraverso questo nome, e senza il
    # legame ripiega sul nome dell'eseguibile — che per una applicazione Python
    # e' l'interprete. Il suggerimento diceva «python3», e con lui se ne andava
    # anche l'icona giusta. Le altre sette applicazioni ce l'avevano gia': era
    # rimasta indietro solo questa.
    app.setDesktopFileName("os.skillfish.fan")
    if os.path.exists(ICON):
        app.setWindowIcon(QIcon(ICON))
    f = Finestra()
    f.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())

    def _adatta_allo_schermo(self):
        u"""Grande quanto ci sta, senza uscire dallo spazio utile."""
        sc = QApplication.primaryScreen()
        d = sc.availableGeometry() if sc else QRect(0, 0, 1280, 800)
        larg = min(1500, max(760, int(d.width() * 0.82)))
        alt = min(int(d.height() * 0.92), max(560, self.sizeHint().height()))
        self.resize(larg, alt)
        self.move(d.left() + (d.width() - larg) // 2,
                  d.top() + max(0, (d.height() - alt) // 2))

    def showEvent(self, ev):
        # ⚠️ La prima misura non vale: le sezioni scorrono in colonne e quante
        # colonne siano dipende dalla larghezza, che a __init__ non e' ancora
        # decisa. Alla prima comparsa il conto e' fatto davvero, e la finestra
        # si stringe sull'altezza che serve invece di restare alta quanto lo
        # schermo con meta' vuota sotto.
        super().showEvent(ev)
        if getattr(self, "_gia_stretta", False):
            return
        self._gia_stretta = True
        sc = QApplication.primaryScreen()
        d = sc.availableGeometry() if sc else QRect(0, 0, 1280, 800)
        # ⚠️ Non sizeHint() del contenitore: per un QLayout che dispone a
        # colonne quel numero non vuol dire niente (la minima ha altezza zero,
        # perche' l'altezza dipende da quante colonne ci stanno). Si chiede al
        # layout la sola cosa che sa rispondere: quanto e' alto SE gli si da'
        # questa larghezza. Col conto sbagliato la finestra si stringeva troppo
        # e le tensioni finivano sotto il bordo.
        largh = max(400, self.centralWidget().width() - 24)
        serve = self.colonne.heightForWidth(largh) + self.barra_bassa + 40
        alt = min(int(d.height() * 0.92), max(520, serve))
        if abs(alt - self.height()) > 30:
            self.resize(self.width(), alt)
            self.move(self.x(), d.top() + max(0, (d.height() - alt) // 2))


        if chiave_aiuto:
            intest.addWidget(_aiuto(chiave_aiuto, g))
        v.addLayout(intest)
        return g, v

    def _preset(self):
        u"""I preset, e la curva che cambia SUBITO quando ne scegli uno.

        ⚠️ Prima bisognava premere «Usa» per vedere che forma avesse il preset:
        si sceglieva alla cieca, e il nome da solo non dice quanto sale la
        ventola ne' a che temperatura. Adesso la curva nel riquadro accanto si
        ridisegna nell'istante in cui si spunta il pallino — si guarda, e se non
        piace se ne spunta un altro. Sulla ventola non cambia niente finche' non
        si preme Applica, che e' l'unico pulsante che tocca la macchina.
        """
        v = QVBoxLayout()
        v.setSpacing(2)
        self.gruppo = QButtonGroup(self)
        for chiave in ("silenzioso", "equilibrato", "prestazioni", "massimo"):
            r = QRadioButton(nome_preset(chiave))
            r.chiave = chiave
            self.gruppo.addButton(r)
            h = QHBoxLayout()
            h.setSpacing(2)
            h.addWidget(r)
            h.addWidget(Aiuto(aiuto_preset(chiave), nome_preset(chiave), self))
            h.addStretch(1)
            v.addLayout(h)
            if self.conf.get("preset") == chiave:
                r.setChecked(True)
        self.gruppo.buttonClicked.connect(self._prova_preset)
        v.addStretch(1)
        return v


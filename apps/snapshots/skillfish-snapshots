#!/usr/bin/env python3
# SkillFishOS Snapshot — le fotografie del sistema in una finestra: guardarle,
# farne una, tornare indietro. PyQt6, tema ottone/steampunk come le altre.
#
# PERCHE' NON BASTAVA BTRFS ASSISTANT
# Btrfs Assistant c'e' gia' ed e' un buon programma, ma parla la lingua del
# filesystem: sottovolumi, qgroup, configurazioni di snapper, schede diverse per
# btrfs-maintenance e per snapper. Chi vuole solo tornare a ieri sera perche'
# un aggiornamento ha rotto qualcosa deve prima imparare tutto quello.
#
# Qui si risponde a tre domande e basta:
#   - che fotografie ho?              -> l'elenco, con date leggibili
#   - me ne faccio una adesso         -> un bottone
#   - torno a quella                  -> un bottone e un riavvio
# Btrfs Assistant resta installato per chi vuole entrare nel dettaglio.
#
# COSA GIRA CON I PRIVILEGI E COSA NO
# La finestra gira da utente normale. /.snapshots pero' e' leggibile solo da
# root, quindi anche il semplice elenco passa da un programma a parte
# (skillfish-snapshots-read, senza password) e le operazioni che cambiano
# qualcosa da un secondo (skillfish-snapshots-helper, con password). Vedi la
# regola polkit os.skillfish.snapshots.policy.
import os
import subprocess
import sys
from datetime import datetime, timezone

from PyQt6.QtCore import Qt, QLocale, QDateTime
from PyQt6.QtGui import QIcon, QPixmap
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
                             QLabel, QGroupBox, QPushButton, QRadioButton, QButtonGroup,
                             QMessageBox, QFrame, QScrollArea, QInputDialog, QLineEdit)


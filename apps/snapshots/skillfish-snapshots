def L(it, en):
    """La stringa in italiano o in inglese, o quella del dizionario condiviso.

    Le due stringhe devono essere COSTANTI: se il testo viene formattato prima
    (una f-string, o un "%s" % x), la chiave cercata nel dizionario contiene
    gia' il valore e non la si trova mai. Il segnaposto va lasciato dentro e
    riempito dopo: L("Snapshot %s", "Snapshot %s") % n.
    """
    if LANG == "it":
        return it
    return _TR(en)


def sh(cmd, t=60):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=t)
        return r.returncode, (r.stdout or "").strip(), (r.stderr or "").strip()
    except Exception as e:
        return 1, "", str(e)



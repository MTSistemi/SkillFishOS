def bytes_leggibili(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return "?"
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or u == "TiB":
            return ("%.0f %s" % (n, u)) if u in ("B", "KiB") else ("%.1f %s" % (n, u))
        n /= 1024.0
    return "?"


# ---------- lettura ----------
class Snapshot:
    def __init__(self, num, data_utc, tipo, pre, descrizione):
        self.num = num
        self.tipo = tipo
        self.pre = pre
        self.descrizione = descrizione
        self.quando = self._locale(data_utc)

    @staticmethod
    def _locale(s):
        """La data di info.xml e' in UTC: va portata all'ora della macchina.

        ⚠️ Senza questa conversione gli orari escono sbagliati di quanto vale il
        fuso - due ore, in Italia d'estate - e uno snapshot fatto adesso
        sembrerebbe di due ore fa. `snapper list` la converte, info.xml no.
        """
        if not s:
            return None
        try:
            d = datetime.strptime(s.strip(), "%Y-%m-%d %H:%M:%S")
        except ValueError:
            return None
        return d.replace(tzinfo=timezone.utc).astimezone()

    def data_scritta(self):
        if self.quando is None:
            return L("data sconosciuta", "unknown date")
        q = QDateTime.fromSecsSinceEpoch(int(self.quando.timestamp()))
        return QLocale().toString(q, QLocale.FormatType.ShortFormat)

    def quanto_fa(self):
        if self.quando is None:
            return ""
        s = (datetime.now(timezone.utc) - self.quando.astimezone(timezone.utc)).total_seconds()
        if s < 90:
            return L("adesso", "just now")
        # ⚠️ Il singolare va scritto a parte. Con il solo plurale usciva
        # «1 minuti fa» — visto nella finestra, non dedotto: e' il tipo di cosa
        # che nel codice sembra a posto e sullo schermo no.
        if s < 5400:
            n = int(s // 60)
            return L("un minuto fa", "one minute ago") if n == 1 else \
                L("%d minuti fa", "%d minutes ago") % n
        if s < 172800:
            n = int(s // 3600)
            return L("un'ora fa", "one hour ago") if n == 1 else \
                L("%d ore fa", "%d hours ago") % n
        n = int(s // 86400)
        return L("un giorno fa", "one day ago") if n == 1 else \
            L("%d giorni fa", "%d days ago") % n

    def in_parole(self):
        """La descrizione di snapper detta in italiano corrente.

        snapper scrive «apt» e «pre»/«post», che dicono tutto a chi sa gia' come
        funziona e niente a tutti gli altri. Le descrizioni scritte da chi usa il
        programma si mostrano invece com'e' stato scritto, senza toccarle.
        """
        d = (self.descrizione or "").strip()
        if d in ("apt", "zypp(apt)"):
            if self.tipo == "pre":
                return L("prima di installare o aggiornare programmi",
                         "before installing or updating software")
            return L("dopo aver installato o aggiornato programmi",
                     "after installing or updating software")
        if d == "timeline":
            return L("snapshot periodico", "scheduled snapshot")
        if d in ("manual snapshot", ""):
            return L("fatto da te", "made by you")
        # ⚠️ «boot» e «clean install» li scrivono i nostri ganci, e restavano
        # cosi' com'erano: sulla Generic l'elenco diceva "boot" tre volte su
        # quattro. Sono le due descrizioni piu' frequenti in assoluto — quelle
        # che uno vede sempre - e sono proprio quelle che non dicevano niente.
        b = d.lower()
        if b == "boot":
            return L("all'avvio del sistema", "at system startup")
        if "clean install" in b or ("first" in b and "boot" in b):
            return L("appena installato il sistema", "right after installing the system")
        return d


class Bersaglio:
    """Un sistema installato su disco, visto dalla live."""

    def __init__(self, dev, sottovol, nome):
        self.dev = dev
        self.sottovol = sottovol
        self.nome = nome or "SkillFishOS"
        self.snap = []
        self.daparte = []
        self.spazio = None     # (libero, totale) del disco che si ripara

    def etichetta(self):
        return "%s  —  %s" % (self.nome, self.dev)


def leggi_tutto():
    """Chiede l'elenco al programma di sola lettura. Torna (snapshot, spazio, daparte)."""
    rc, out, err = sh(["pkexec", LEGGI], 60)
    if rc != 0:
        # ⚠️ Il messaggio grezzo di pkexec NON va mostrato: e' in inglese
        # qualunque lingua parli la finestra, ed e' scritto per chi sviluppa.
        # Visto sulla Generic aprendo l'app in tedesco: sotto un elenco vuoto
        # compariva «Error creating textual authentication agent: Error opening
        # current controlling terminal for the process ('/dev/tty')». Chi legge
        # non ne ricava niente, e nemmeno capisce che ha solo negato il permesso.
        #
        # 126 e 127 sono i codici con cui pkexec dice «non autorizzato» oppure
        # «non sono nemmeno riuscito a chiedere»: da' quasi sempre su chi ha
        # premuto Annulla, e non e' un guasto.
        # ⚠️ Stesso numero di valori degli altri ritorni, o chi scompatta
        # esplode con "not enough values to unpack" proprio quando qualcosa e'
        # gia' andato storto.
        if rc in (126, 127):
            return (None, None, None,
                    L("operazione annullata", "operation cancelled"), {}, None, None, [])
        # ⚠️ Stesso numero di valori del ritorno buono, o chi scompatta esplode
        # con "not enough values to unpack" proprio quando qualcosa e' andato
        # storto: l'errore vero sparirebbe dietro a un errore di programmazione.
        return (None, None, None,
                L("Non riesco a leggere gli snapshot.", "cannot read the snapshots"),
                {}, None, None, [])
    snap, spazio, daparte = [], None, []
    manutenzione, disco, verifica = {}, None, None
    bersagli = []          # i sistemi installati, quando si gira dalla live
    for riga in out.splitlines():
        p = riga.split("\t")
        # ⚠️ L'ULTIMA riga perde i campi vuoti in coda: l'output arriva da sh(),
        # che fa .strip(), e lo strip si porta via anche il tabulatore finale.
        # Cosi' la riga VERIFICA — che e' l'ultima — usciva con 4 campi invece
        # di 5, il controllo sulla lunghezza la scartava, e nella finestra
        # mancava l'esito dell'ultima verifica. Senza un errore, ovviamente.
        #
        # Si riempie fino alla lunghezza massima invece di contare i campi: un
        # dato in meno vale come vuoto, che e' esattamente quello che era.
        p += [""] * (8 - len(p))
        if p[0] == "SNAP" and p[1]:
            snap.append(Snapshot(p[1], p[2], p[3], p[4], p[5]))
        elif p[0] == "SPAZIO" and p[1]:
            spazio = (p[1], p[2])
        elif p[0] == "DAPARTE" and p[1]:
            daparte.append(p[1])
        # Le tre righe dei sistemi installati su disco. Le manda il lettore solo
        # quando si gira dalla live; sul sistema normale non arrivano mai, e
        # questo ramo non fa niente.
        elif p[0] == "BERSAGLIO" and p[1]:
            bersagli.append(Bersaglio(p[1], p[2], p[4]))
        elif p[0] == "SNAPB" and p[1] and bersagli:
            # ⚠️ Si attacca all'ULTIMO bersaglio annunciato: il lettore stampa
            # prima la riga BERSAGLIO e poi i suoi snapshot. Cercare il disco
            # nell'elenco a ogni riga costerebbe uguale e si romperebbe se un
            # giorno il lettore cambiasse ordine; qui si romperebbe subito e in
            # modo visibile, che e' meglio.
            for b in bersagli:
                if b.dev == p[1]:
                    b.snap.append(Snapshot(p[2], p[3], p[4], p[5], p[6]))
                    break
        elif p[0] == "SPAZIOB" and p[1]:
            for b in bersagli:
                if b.dev == p[1]:
                    b.spazio = (p[2], p[3])
                    break
        elif p[0] == "DAPARTEB" and p[1]:
            for b in bersagli:
                if b.dev == p[1]:
                    b.daparte.append(p[2])
                    break
        # ⚠️ I campi si contano PRIMA di leggerli: una riga piu' corta del
        # previsto — un lavoro spento, un systemctl che non risponde — manderebbe
        # in errore la finestra invece di mostrare quello che c'e'.
        elif p[0] == "LAVORO" and p[1]:
            manutenzione[p[1]] = {"periodo": p[2], "ora": p[3], "attivo": p[4],
                                  "prossima": p[5], "ultima": p[6], "esito": p[7]}
        elif p[0] == "DISCO" and p[1]:
            disco = (p[1], p[2], p[3])
        elif p[0] == "VERIFICA":
            verifica = (p[1], p[2], p[3], p[4])
    snap.sort(key=lambda s: int(s.num), reverse=True)   # i piu' recenti in cima
    for b in bersagli:
        b.snap.sort(key=lambda s: int(s.num), reverse=True)
    return snap, spazio, daparte, None, manutenzione, disco, verifica, bersagli



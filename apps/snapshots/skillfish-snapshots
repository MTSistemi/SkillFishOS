    def mostra_manutenzione(self):
        """Riempie la scheda con quello che ha detto il programma di lettura."""
        for chiave, r in self.m_righe.items():
            d = self.manutenzione.get(chiave)
            if d is None:
                r["stato"].setText(L("stato sconosciuto", "state unknown"))
                continue
            # il periodo
            i = r["quando"].findData(d["periodo"])
            r["quando"].setCurrentIndex(i if i >= 0 else 0)
            # l'ora: se non l'abbiamo scelta noi, il timer parte a mezzanotte
            hh, mm = (d["ora"] or "03:00").split(":")[:2] if d["ora"] else ("00", "00")
            r["ora"].setTime(QTime(int(hh), int(mm)))
            r["attiva"]()

            pezzi = []
            if d["prossima"]:
                pezzi.append(L("prossima volta: %s", "next time: %s") % d["prossima"])
            elif d["periodo"] == "mai":
                pezzi.append(L("non programmata", "not scheduled"))
            if d["ultima"]:
                pezzi.append(L("ultima: %s", "last: %s") % d["ultima"])
            # Il dato che riguarda QUESTO lavoro sta sotto questo lavoro, non in
            # un paragrafo in cima alla pagina: cosi' si legge accanto al
            # comando che lo cambia.
            if chiave == "spazio" and self.disco:
                _libero, allocato, usato = self.disco
                try:
                    sprecato = int(allocato) - int(usato)
                except (TypeError, ValueError):
                    sprecato = 0
                if sprecato > 1 << 30:
                    pezzi.insert(0, L("da recuperare: %s", "to reclaim: %s")
                                 % bytes_leggibili(sprecato))
            if chiave == "verifica" and self.verifica:
                _q, _d, errori, _s = self.verifica
                if errori == "no errors found":
                    pezzi.insert(0, L("nessun errore", "no errors"))
                elif errori:
                    pezzi.insert(0, errori)
            r["stato"].setText("   ·   ".join(pezzi))

        t = []
        if self.disco:
            libero, allocato, usato = self.disco
            t.append(L("Spazio libero: %s.", "Free space: %s.") % bytes_leggibili(libero))
        # ⚠️ In cima resta SOLO il dato. Prima qui c'erano tre frasi di fila —
        # spazio libero, cos'e' lo spazio tenuto da parte, esito dell'ultima
        # verifica — ed erano la prima cosa che si leggeva ogni volta che si
        # apriva la pagina. Quello che riguarda un singolo lavoro e' finito
        # sotto quel lavoro, e il perche' dietro al suo «?».
        self.m_testa.setText(" ".join(t))

    def salva_manutenzione(self):
        # Solo cio' che e' cambiato davvero: riscrivere un lavoro che sta gia'
        # cosi' vuol dire rigenerare i timer per niente.
        da_fare = []
        for chiave, r in self.m_righe.items():
            periodo = r["quando"].currentData()
            ora = r["ora"].time().toString("HH:mm")
            d = self.manutenzione.get(chiave) or {}
            if periodo == d.get("periodo") and (periodo == "mai" or ora == (d.get("ora") or "")):
                continue
            da_fare.append((chiave, periodo, ora))

        if not da_fare:
            self.m_stato.setText(L("Non hai cambiato niente.", "Nothing has changed."))
            self.m_stato.setStyleSheet("color:#b9a07a;")
            return

        # ⚠️ La deframmentazione si accende solo dopo aver detto per esteso cosa
        # comporta. E' l'unico lavoro che puo' far crescere lo spazio occupato
        # invece di ridurlo, e chi la accende di solito si aspetta il contrario.
        for chiave, periodo, _ora in da_fare:
            if chiave == "deframmenta" and periodo != "mai":
                r = QMessageBox.question(
                    self, L("Accendere la deframmentazione?", "Turn defragmentation on?"),
                    L("Su un sistema con gli snapshot questa operazione fa CRESCERE lo "
                      "spazio occupato: i dati che uno snapshot condivide con il sistema "
                      "vengono riscritti e smettono di essere condivisi.\n\n"
                      "Su un disco pieno per metà di snapshot possono essere decine di "
                      "gigabyte, in una notte sola.\n\nLa accendo lo stesso?",
                      "On a system with snapshots this makes used space GROW: data a "
                      "snapshot shares with the live system gets rewritten and stops being "
                      "shared.\n\nOn a disk half full of snapshots that can be tens of "
                      "gigabytes, in a single night.\n\nTurn it on anyway?"))
                if r != QMessageBox.StandardButton.Yes:
                    return

        self.m_stato.setText(L("Sto programmando…", "Setting the schedule…"))
        QApplication.processEvents()
        errore = None
        for chiave, periodo, ora in da_fare:
            rc, out, err = self.esegui(["manutenzione", chiave, periodo, ora], 300)
            if rc != 0:
                errore = err or out
                break
        self.ricarica()
        if errore:
            self.m_stato.setText(self.spiega(errore))
            self.m_stato.setStyleSheet("color:#cf8a6a;")
        else:
            self.m_stato.setText(L("Programmazione salvata.", "Schedule saved.")
                                 if len(da_fare) > 1 else
                                 L("Programmazione salvata.", "Schedule saved."))
            self.m_stato.setStyleSheet("color:#9ccf6a;font-weight:600;")

    # ---- elenco ----
    def ricarica(self):
        for btn in list(self.grp.buttons()):
            self.grp.removeButton(btn)
        while self.listlay.count():
            it = self.listlay.takeAt(0)
            if it.widget():
                it.widget().deleteLater()

        (self.snap, spazio, self.daparte, errore,
         self.manutenzione, self.disco, self.verifica,
         self.bersagli) = leggi_tutto()

        # Dalla chiavetta: si mostra il selettore e si lavora sul sistema
        # scelto. Il primo si sceglie da solo, che nel caso normale — un disco,
        # un sistema — vuol dire che non c'e' niente da scegliere.
        if self.bersagli:
            vecchio = self.bersaglio.dev if self.bersaglio else None
            self.scelta_bersaglio.blockSignals(True)
            self.scelta_bersaglio.clear()
            for b in self.bersagli:
                self.scelta_bersaglio.addItem(b.etichetta(), b.dev)
            i = 0
            for n, b in enumerate(self.bersagli):
                if b.dev == vecchio:
                    i = n
                    break
            self.scelta_bersaglio.setCurrentIndex(i)
            self.scelta_bersaglio.blockSignals(False)
            self.bersaglio = self.bersagli[i]
            self.riga_bersaglio.show()
            self.snap = self.bersaglio.snap
            self.daparte = self.bersaglio.daparte
            # lo spazio che conta e' quello del disco che si ripara
            if self.bersaglio.spazio:
                spazio = self.bersaglio.spazio
            self.sub.setText(
                L("Stai lavorando dalla chiavetta su un sistema installato: "
                  "puoi riportarlo indietro, non farci snapshot nuovi.",
                  "You are working from the live image on an installed system: "
                  "you can take it back, not make new snapshots on it."))
        else:
            self.bersaglio = None
            self.riga_bersaglio.hide()
        if errore:
            # ⚠️ Se l'utente annulla la richiesta di autorizzazione finiamo qui:
            # non e' un guasto, e non va detto come se lo fosse.
            self.stato.setText(errore)
            self.stato.setStyleSheet("color:#cf8a6a;")
            self.snap = []
            return

        # ⚠️ Lo spazio libero NON va nel sottotitolo: quello dice a cosa serve la
        # finestra, ed e' la prima cosa che legge chi la apre la prima volta.
        # Scrivendocelo sopra si perdeva la spiegazione per un numero che sta
        # benissimo in fondo, accanto al conteggio.
        self.spazio = spazio
        if self.daparte:
            self.avviso_testo.setText(
                L("C'è un sistema messo da parte da un ripristino: %s. "
                  "Finché resta, puoi tornare com'eri prima.",
                  "There is a system set aside by a restore: %s. "
                  "While it is there, you can go back to how you were.")
                % self.daparte[0])
            self.avviso.show()
        else:
            self.avviso.hide()

        if not self.snap:
            # ⚠️ Due elenchi vuoti che sembrano uguali e non lo sono affatto.
            #
            # Dopo un ripristino la cronologia non e' persa: SEGUE il sistema
            # nuovo, e quello parte al riavvio. Fino ad allora questa finestra
            # gira sul sistema vecchio, dove /.snapshots non c'e' piu' — e
            # scrivere «non c'e' ancora nessuna fotografia» proprio a chi ha
            # appena ripristinato vorrebbe dire annunciargli di avergli perso
            # tutto. Visto sulla Generic subito dopo un ripristino vero.
            if self.daparte:
                testo = L("Hai appena ripristinato. Gli snapshot sono nel sistema "
                          "che parte al prossimo riavvio: riappariranno tutti da lì.",
                          "You have just restored. The snapshots are in the system that "
                          "boots on the next restart: they will all be there again.")
            else:
                testo = L("Non c'è ancora nessuno snapshot. Il sistema ne fa uno da solo prima di ogni installazione o aggiornamento.",
                          "There are no snapshots yet. The system takes one by itself "
                          "before every install or update.")
            vuoto = QLabel(testo)
            vuoto.setWordWrap(True)
            vuoto.setStyleSheet("color:#b9a07a;")
            self.listlay.addWidget(vuoto)
            self.listlay.addStretch(1)
            self.aggiorna_bottoni()
            # ⚠️ anche qui: senza elenco la scheda della manutenzione resterebbe
            # vuota, e non c'entra niente col fatto che non ci siano fotografie.
            self.mostra_manutenzione()
            return

        for i, s in enumerate(self.snap):
            riga = QWidget()
            rv = QHBoxLayout(riga)
            rv.setContentsMargins(2, 2, 2, 2)
            rb = QRadioButton()
            rb.setProperty("num", s.num)
            self.grp.addButton(rb)
            rb.toggled.connect(self.aggiorna_bottoni)
            if i == 0:
                rb.setChecked(True)
            rv.addWidget(rb)

            col = QVBoxLayout()
            col.setSpacing(0)
            nm = QLabel("%s   %s" % (s.data_scritta(), s.quanto_fa()))
            nm.setStyleSheet("font-weight:700;color:#f1e3c6;")
            meta = QLabel(s.in_parole())
            meta.setStyleSheet("color:#b9a07a;")
            col.addWidget(nm)
            col.addWidget(meta)
            rv.addLayout(col, 1)
            self.listlay.addWidget(riga)
        self.listlay.addStretch(1)
        self.stato.setText(self.riga_conteggio())
        self.stato.setStyleSheet("color:#b9a07a;")
        self.aggiorna_bottoni()
        self.mostra_manutenzione()

    def riga_conteggio(self):
        n = len(self.snap)
        t = L("uno snapshot.", "one snapshot.") if n == 1 else \
            L("%d snapshot.", "%d snapshots.") % n
        if self.spazio:
            t += "   " + L("Spazio libero: %s su %s",
                           "Free space: %s of %s") % (bytes_leggibili(self.spazio[0]),
                                                      bytes_leggibili(self.spazio[1]))
        return t

    def scelto(self):
        for btn in self.grp.buttons():
            if btn.isChecked():
                return btn.property("num")
        return None

    def scelto_snap(self):
        n = self.scelto()
        for s in self.snap:
            if s.num == n:
                return s
        return None

    def aggiorna_bottoni(self):
        c = self.scelto() is not None
        # Su un altro disco si RIPARA e basta: creare o cancellare uno snapshot
        # passa da snapper, che lavora sulla configurazione del sistema in
        # funzione. Spenti invece che nascosti, cosi' si vede che ci sono.
        altrove = self.bersaglio is not None
        self.bcancella.setEnabled(c and not altrove)
        self.bripristina.setEnabled(c)
        self.bcrea.setEnabled(not altrove)
        if altrove:
            fuori = L("Dalla chiavetta puoi riportare indietro il sistema, "
                      "non fargli snapshot nuovi.",
                      "From the live image you can take the system back, "
                      "not make new snapshots on it.")
            self.bcrea.setToolTip(fuori)
            self.bcancella.setToolTip(fuori)

    # ---- azioni ----
    def cambia_bersaglio(self, i):
        if 0 <= i < len(self.bersagli):
            self.bersaglio = self.bersagli[i]
            self.ricarica()

    def esegui(self, argomenti, attesa=600):
        # ⚠️ Il disco si mette PRIMA dell'azione: l'aiutante lo legge come primo
        # argomento e poi scorre. Metterlo in coda lo farebbe scambiare per il
        # numero di uno snapshot.
        if self.bersaglio:
            argomenti = ["--disco", self.bersaglio.dev] + list(argomenti)
        rc, out, err = sh(["pkexec", HELPER] + argomenti, attesa)
        return rc, out, err

    @staticmethod
    def spiega(testo):
        """Traduce i messaggi dell'aiutante, che parla inglese con un'etichetta.

        L'aiutante e' un programma a se': gira da root, e lo si puo' chiamare
        anche da terminale. Non puo' sapere in che lingua sta la finestra, e
        scrivere italiano li' dentro vorrebbe dire mostrarlo pari pari a un
        tedesco. Quindi manda «ERR:zero snapshot 0 is the running system…» e la
        traduzione la mette qui chi la lingua la conosce.

        ⚠️ L'etichetta sconosciuta NON si scarta: si mostra il testo inglese che
        l'accompagna. Se un giorno l'aiutante e' piu' nuovo dell'applicazione —
        succede, sono due pacchetti — chi guarda legge comunque qualcosa di
        sensato invece di una riga vuota.
        """
        t = (testo or "").strip()
        if not t.startswith("ERR:"):
            return t
        etichetta, _, resto = t[4:].partition(" ")
        frasi = {
            "zero": L("Lo snapshot 0 è il sistema in funzione, non è uno snapshot vero.",
                      "Snapshot 0 is the running system, not a snapshot."),
            "non-numero": L("Non è un numero di snapshot.",
                            "That is not a snapshot number."),
            "inesistente": L("Quello snapshot non esiste più.",
                             "That snapshot no longer exists."),
            "in-uso": L("Non si può: il sistema in funzione è partito da questo snapshot.",
                        "Not possible: the running system booted from this snapshot."),
            "vuoto": L("Non hai scelto niente da cancellare.",
                       "You have not chosen anything to delete."),
            "cancellazione": L("Non sono riuscito a cancellare uno degli snapshot.",
                               "One of the snapshots could not be deleted."),
            "argomenti": L("Richiesta non valida.", "Invalid request."),
            "uso": L("Richiesta non valida.", "Invalid request."),
        }
        return frasi.get(etichetta, resto or t)

    def crea(self):
        testo, ok = QInputDialog.getText(
            self, L("Fai uno snapshot", "Take a snapshot"),
            L("A cosa ti serve? (per ritrovarla dopo)",
              "What is it for? (so you can find it later)"),
            QLineEdit.EchoMode.Normal,
            L("prima di una prova", "before trying something"))
        if not ok:
            return
        self.stato.setText(L("Sto facendo lo snapshot…", "Taking the snapshot…"))
        QApplication.processEvents()
        rc, out, err = self.esegui(["crea", testo.strip()], 300)
        self.ricarica()          # prima l'elenco, poi l'esito: al contrario
                                 # la ricarica cancellava il messaggio
        if rc == 0:
            self.bene(L("Fatto.", "Done."))
        else:
            self.male(self.spiega(err or out))

    def cancella(self):
        s = self.scelto_snap()
        if s is None:
            return
        r = QMessageBox.question(
            self, L("Cancellare?", "Delete?"),
            L("Cancello lo snapshot del %s (%s)?\n\n"
              "Sparisce solo lo snapshot: il sistema di adesso non cambia.",
              "Delete the snapshot from %s (%s)?\n\n"
              "Only the snapshot goes: your current system does not change.")
            % (s.data_scritta(), s.in_parole()))
        if r != QMessageBox.StandardButton.Yes:
            return
        rc, out, err = self.esegui(["cancella", s.num], 300)
        self.ricarica()          # prima l'elenco, poi l'esito: al contrario
                                 # la ricarica cancellava il messaggio
        if rc == 0:
            self.bene(L("Cancellato.", "Deleted."))
        else:
            self.male(self.spiega(err or out))

    # ---- la pulizia ----
    # Quante fotografie recenti restano comunque. Tre e' il numero che snapper
    # tiene gia' per conto suo (NUMBER_LIMIT), quindi non introduce una regola
    # nuova da spiegare: e' la stessa che il sistema applica da solo.
    TIENE = 3

    def da_buttare(self):
        """Quali si propone di cancellare, e quali restano. Mai a indovinare.

        Restano sempre, oltre alle piu' recenti:
          - quella dell'installazione, che e' l'unico punto di ritorno al
            sistema com'era appena uscito dalla ISO, e non si rifa' piu';
          - quella da cui il sistema e' partito, se ci si e' dentro (l'aiutante
            rifiuterebbe comunque, ma proporla e poi fallire sarebbe scortese).
        """
        radice = sh(["findmnt", "-no", "SOURCE", "/"], 10)[1]
        tieni, butta = [], []
        for i, s in enumerate(self.snap):        # gia' ordinati, i piu' recenti in cima
            d = (s.descrizione or "").lower()
            protetta = (i < self.TIENE
                        or "clean install" in d
                        or ("first" in d and "boot" in d)
                        or ("/.snapshots/%s/snapshot" % s.num) in radice)
            (tieni if protetta else butta).append(s)
        return butta, tieni

    def pulizia(self):
        butta, tieni = self.da_buttare()
        if not butta:
            self.stato.setText(
                L("Non c'è niente da buttare: ci sono solo snapshot da tenere.",
                  "Nothing to clean up: only snapshots worth keeping are here."))
            self.stato.setStyleSheet("color:#b9a07a;")
            return

        elenco = "\n".join("   • %s   %s" % (s.data_scritta(), s.in_parole()) for s in butta)
        resta = "\n".join("   • %s   %s" % (s.data_scritta(), s.in_parole()) for s in tieni)

        # PRIMA conferma: cosa succede, per esteso. Qui si legge.
        # ⚠️ Non si promette un numero di gigabyte liberati: le quote btrfs sono
        # spente, e con gli snapshot lo spazio recuperato dipende da quanto
        # ciascuno condivide con gli altri. Dire una cifra inventata sarebbe
        # peggio che non dirla.
        d1 = QMessageBox(self)
        d1.setWindowTitle(L("Fare pulizia?", "Clean up?"))
        d1.setText(L("Butto %d snapshot e ne tengo %d.",
                     "I will remove %d snapshots and keep %d.") % (len(butta), len(tieni)))
        d1.setInformativeText(
            L("VANNO VIA:\n%s\n\nRESTANO:\n%s\n\n"
              "Lo spazio che si libera non si può dire in anticipo: gli snapshot "
              "condividono i dati fra loro.",
              "GOING:\n%s\n\nSTAYING:\n%s\n\n"
              "How much space is freed cannot be known in advance: snapshots share "
              "their data with each other.") % (elenco, resta))
        d1.setStandardButtons(QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        d1.setDefaultButton(QMessageBox.StandardButton.No)
        if d1.exec() != QMessageBox.StandardButton.Yes:
            return

        # SECONDA conferma: corta, secca, e con il No gia' selezionato. Serve a
        # spezzare il doppio clic distratto sul primo «Sì».
        d2 = QMessageBox(self)
        d2.setIcon(QMessageBox.Icon.Warning)
        d2.setWindowTitle(L("Sicuro?", "Are you sure?"))
        d2.setText(L("Cancello per sempre %d snapshot.",
                     "I will permanently delete %d snapshots.") % len(butta))
        d2.setInformativeText(
            L("Non si torna indietro: uno snapshot cancellato non si recupera. Il sistema di adesso non viene toccato.",
              "There is no undo: a deleted snapshot cannot be recovered. "
              "Your current system is not touched."))
        d2.setStandardButtons(QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        d2.setDefaultButton(QMessageBox.StandardButton.No)
        if d2.exec() != QMessageBox.StandardButton.Yes:
            return

        self.stato.setText(L("Sto facendo pulizia…", "Cleaning up…"))
        QApplication.processEvents()
        rc, out, err = self.esegui(["cancella-molti", ",".join(s.num for s in butta)], 900)
        self.ricarica()
        if rc == 0:
            self.bene(L("Buttati %d snapshot.", "Removed %d snapshots.") % len(butta))
        else:
            self.male(self.spiega(err or out))

    def ripristina(self):
        s = self.scelto_snap()
        if s is None:
            return
        r = QMessageBox.question(
            self, L("Tornare indietro?", "Go back?"),
            L("Riporto il sistema a com'era il %s (%s).\n\n"
              "• I tuoi file personali NON vengono toccati: torna indietro il sistema, "
              "i documenti restano quelli di adesso.\n"
              "• Il sistema di adesso non viene cancellato: resta da parte e puoi tornarci.\n"
              "• Ha effetto al prossimo riavvio.\n\nProcedo?",
              "I will put the system back to how it was on %s (%s).\n\n"
              "• Your personal files are NOT touched: the system goes back, your "
              "documents stay as they are now.\n"
              "• The current system is not deleted: it stays aside and you can return to it.\n"
              "• It takes effect on the next restart.\n\nShall I go ahead?")
            % (s.data_scritta(), s.in_parole()))
        if r != QMessageBox.StandardButton.Yes:
            return
        self.stato.setText(L("Sto tornando indietro…", "Going back…"))
        QApplication.processEvents()
        rc, out, err = self.esegui(["ripristina", s.num], 900)
        # anche qui: prima l'elenco, poi l'esito, o la ricarica lo cancella
        self.ricarica()
        if rc != 0:
            self.male(self.spiega(err or out))
            return
        # ⚠️ Riparando un ALTRO disco dalla chiavetta, «riavvia adesso» sarebbe
        # un consiglio sbagliato: riavviando si torna nella chiavetta, non nel
        # sistema riparato. Chi lo seguisse non troverebbe niente di cambiato e
        # concluderebbe che il ripristino non ha funzionato. Qui si dice invece
        # l'unica cosa che serve fare: togliere la chiavetta e avviare da disco.
        if self.bersaglio:
            self.bene(L("Fatto. Togli la chiavetta e avvia da disco: "
                        "partirà il sistema di quella data.",
                        "Done. Remove the live media and start from the disk: "
                        "the system from that date will boot."))
            return

        self.bene(L("Fatto. Al prossimo riavvio parte il sistema di quella data.",
                    "Done. On the next restart the system from that date will boot."))
        # ⚠️ Titolo e corpo non possono essere la stessa chiave inglese con due
        # italiani diversi: nel dizionario condiviso la chiave e' la stringa
        # inglese, quindi una delle due traduzioni scaccerebbe l'altra.
        if QMessageBox.question(
                self, L("Riavviare adesso?", "Restart now?"),
                L("Al ritorno troverai il sistema di quella data.",
                  "When it comes back you will have the system from that date.")
        ) == QMessageBox.StandardButton.Yes:
            sh(["pkexec", "systemctl", "reboot"], 30)

    def annulla(self):
        r = QMessageBox.question(
            self, L("Tornare com'eri?", "Back to how you were?"),
            L("Rimetto il sistema com'era prima del ripristino. Ha effetto al riavvio.",
              "I will put back the system as it was before the restore. "
              "It takes effect on restart."))
        if r != QMessageBox.StandardButton.Yes:
            return
        rc, out, err = self.esegui(["annulla"], 600)
        self.ricarica()          # prima l'elenco, poi l'esito: al contrario
                                 # la ricarica cancellava il messaggio
        if rc == 0:
            self.bene(L("Fatto. Riavvia per tornare al sistema di prima.",
                        "Done. Restart to go back to the previous system."))
        else:
            self.male(self.spiega(err or out))

    def pulisci(self):
        r = QMessageBox.question(
            self, L("Buttare il vecchio sistema?", "Discard the old system?"),
            L("Cancello per sempre il sistema messo da parte dal ripristino. "
              "Dopo, «Torna indietro» non sarà più possibile.\n\nLo spazio torna libero.",
              "I will permanently delete the system set aside by the restore. "
              "After that, «Go back» will no longer be possible.\n\nThe space is freed."))
        if r != QMessageBox.StandardButton.Yes:
            return
        rc, out, err = self.esegui(["pulisci"], 600)
        self.ricarica()          # prima l'elenco, poi l'esito: al contrario
                                 # la ricarica cancellava il messaggio
        if rc == 0:
            self.bene(L("Spazio liberato.", "Space freed."))
        else:
            self.male(self.spiega(err or out))

    # ---- esito ----
    def bene(self, msg):
        self.stato.setText(msg)
        self.stato.setStyleSheet("color:#9ccf6a;font-weight:600;")

    def male(self, msg):
        # pkexec esce con 126 quando l'autorizzazione viene negata o annullata:
        # non e' un guasto del programma e non va scritto come tale.
        if not msg:
            msg = L("operazione annullata", "operation cancelled")
        self.stato.setText(msg)
        self.stato.setStyleSheet("color:#cf8a6a;")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("SkillFishOS Snapshots")
    app.setDesktopFileName("os.skillfish.snapshots")
    app.setWindowIcon(QIcon(ICON))
    w = Snapshots()
    w.show()
    w.raise_()
    w.activateWindow()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

    def _share_silicon(self, cpu=None, gpu=None, validation=""):
        """Open the GitHub silicon-lottery report prefilled with the validated values.
        Anonymous in content: only clocks/voltages, no identifiers (the user reviews
        the form in the browser before submitting)."""
        import webbrowser, urllib.parse
        fields = {"template": "silicon-report.yml",
                  "cpu-max": cpu or ("%d @ %d" % (self.cf.value(), self.cs.value())),
                  "gpu-max": gpu or ("%d @ %d" % (self.gf.value(), self.gv.value())),
                  "validation": validation or "SkillFishOS Tuner"}
        webbrowser.open("https://github.com/MTSistemi/SkillFishOS/issues/new?" + urllib.parse.urlencode(fields))


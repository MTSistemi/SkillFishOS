# SkillFishOS - i pacchetti che fanno di questa immagine il prodotto e non un
# Debian sid con KDE sopra.
#
# Da dove viene l'elenco: sono i pacchetti che risultano installati a mano
# sulla BC-250 di sviluppo (192.168.5.40), la macchina che cloniamo per fare
# la release, incrociati con quelli davvero pubblicati nell'archivio
# (dists/aetherium/main/binary-amd64/Packages.gz). Elenco verificato il
# 12/09/2026 con "reprepro -b /srv/apt list aetherium": ogni pacchetto qui
# sotto esiste davvero nell'archivio (versioni singole, non piu' un unico
# numero comune come una volta). Arrivano da config/archives/aetherium.*.

# --- Sistema e hardware BC-250 ---
# skillfish-base e' il cuore: sblocco 8 core via SMU, watchdog hardware,
# rilevatore di freeze, campionatore di frequenza GPU, WoL, tabelle ACPI
# P-state/C-state, blacklist di nct6683 con force=1 su nct6687 (senza la quale
# il PWM della ventola viene rifiutato in silenzio), aggancio apt che rigenera
# le voci di ripristino nel menu di avvio.
skillfish-base

# --- Aspetto ---
# Tema steampunk: icone, cursori, schema colori, Kvantum, sfondo al primo
# accesso. Il motore Kvantum arriva da 10-desktop-kde.list.chroot
# (qt6-style-kvantum), qui c'e' solo il tema.
skillfish-theme
# Gruppo "SkillFishOS" nel menu applicazioni: senza, le nostre app finiscono
# sparpagliate nelle categorie generiche di Plasma.
skillfish-menu

# --- Applicazioni native ---
skillfish-monitor
skillfish-tuner
skillfish-hub
skillfish-dashboard
skillfish-ai-panel
skillfish-kernel-manager
skillfish-iso-mount
# Gli snapshot in una finestra: senza questo, l'unica strada
# per tornare indietro resta il terminale (snapper rollback).
skillfish-snapshots

# --- Sessione di gioco ---
# Fornisce la sessione di gioco Gamescope (wayland-sessions) e
# steamos-session-select.
skillfish-console
# Installatore degli emulatori (post-installazione, via flatpak).
skillfish-emulators

# --- Governor GPU ---
# skillfish-vf-governor sostituisce il vecchio cyan-skillfish-governor-smu:
# e' un pacchetto normale del repository aetherium, porta gia' con se' il
# proprio systemd unit e la propria ExecCondition per la BC-250. Non serve
# piu' nessun hook per installarlo o abilitarlo (era
# 0030-bc250-governor.hook.chroot, rimosso).
skillfish-vf-governor

# --- skillfishos-kernel: the package that brings newer kernels (#103) ---
# Without it an installed system never gets a newer kernel: apt has nothing
# to upgrade. Its postinst downloads nothing here (no running systemd), and
# hook 0005 installs the kernel it names in
# /usr/share/skillfishos-kernel/kernel.conf. Needs 7.2.6-2 or newer: older
# versions downloaded the kernel of the BUILD machine inside the chroot.
skillfishos-kernel

# --- Dipendenze consigliate che apt qui NON tira dentro da solo ---
# auto/config imposta --apt-recommends false, quindi i Recommends dei nostri
# .deb vengono ignorati. Questi sono i Recommends di skillfish-dashboard, e
# risultano tutti installati sulla BC-250: senza, la dashboard si avvia ma i
# riquadri corrispondenti restano morti.
ttyd
novnc
websockify
x11vnc
ethtool
wakeonlan
# Backend snap dell'Hub. Se un domani l'ISO deve dimagrire, questo e' il primo
# candidato: e' l'unica riga qui dentro che non serve a far funzionare
# qualcosa, solo ad ampliare il catalogo.
snapd

# --- Conky ---
# skillfish-base installa /etc/skel/.config/autostart/skillfish-conky.desktop
# e la configurazione, ma non dichiara la dipendenza. Sulla BC-250 conky-all
# risulta installato a mano e nessun altro pacchetto lo tira dentro: se manca,
# ogni nuovo utente si ritrova un autostart che punta a un binario assente.
conky-all

# La chiave del nostro archivio come pacchetto, non solo come file
# copiato da live-build: e' cosi' che l'aggiornamento continua a
# funzionare quando la chiave cambia.
skillfishos-archive-keyring

# Lo schedulatore dei giochi (scx_bpfland via GameMode). Il pacchetto
# non lo accende: l'interruttore sta nel Control Center.
skillfish-scx

# La finestra del primo accesso: chiede cosa installare (browser compreso,
# nessuno e' di serie), scarica i flatpak con una barra per ognuno, prepara
# /games e i permessi che servono a Steam e Heroic per arrivarci. Senza questa
# riga il pacchetto esiste su apt ma non e' nell'immagine, e su un sistema
# appena installato non si apre niente: e' cosi' fino alla 26.06.5.
skillfish-primo-avvio

# Il menu di avvio e la riga di comando del kernel. ⚠️ Si tira dietro
# shim-signed e grub-efi-amd64-signed, che nell'immagine non c'erano: senza
# quelli un'installazione su una macchina con Secure Boot acceso non parte.
skillfish-boot

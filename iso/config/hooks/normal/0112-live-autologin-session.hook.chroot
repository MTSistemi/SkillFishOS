#!/bin/sh
set -e
# live-config crea da solo l'accesso automatico di SDDM, ma lascia la sessione
# VUOTA: non sa quale scegliere. Questo servizio la imposta a Plasma DOPO che
# live-config ha fatto il suo, altrimenti la nostra impostazione verrebbe
# sovrascritta.
#
# Prima qui c'era Hyprland. Il nome della sessione e' quello del file .desktop
# che SDDM trova in /usr/share/xsessions: plasmax11.
#
# Vale solo per l'immagine live. Sul sistema installato l'utente "live" non
# esiste e questa roba non deve arrivarci (issue #28).

cat > /etc/systemd/system/skillfish-autologin-session.service <<'UNIT'
[Unit]
Description=SkillFish - imposta la sessione di accesso automatico di SDDM su Plasma
After=live-config.service
Before=display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/skillfish-set-autologin-session

[Install]
WantedBy=multi-user.target
UNIT

cat > /usr/local/bin/skillfish-set-autologin-session <<'SCR'
#!/bin/sh
# Se live-config ha scritto un accesso automatico senza sessione, ci mettiamo
# Plasma. Se la sessione c'e' gia' non si tocca niente: potrebbe averla scelta
# l'utente.
set -e
CONF=/etc/sddm.conf
[ -f "$CONF" ] || exit 0
grep -q '^\[Autologin\]' "$CONF" || exit 0
if grep -q '^Session=[[:space:]]*$' "$CONF"; then
    sed -i 's/^Session=[[:space:]]*$/Session=plasmax11/' "$CONF"
    echo "skillfish: sessione di accesso automatico impostata su plasmax11"
fi
SCR
chmod 755 /usr/local/bin/skillfish-set-autologin-session

systemctl enable skillfish-autologin-session.service

#!/bin/bash
# Modulo DKMS nct6687 per i sensori e la ventola. Costruito contro il kernel
# tkg installato. Se non riesce, non e' un guaio: si va avanti.
#
# ⚠️ IL SORGENTE NON SI SCARICA PIU'. Sta in
# config/includes.chroot/usr/src/nct6687d-1.0, quindi e' gia' dentro il chroot
# quando questo hook parte. Due motivi, trovati il 12/09/2026 costruendo la
# prima immagine dalla VM:
#   - a monte non esiste nessun rilascio: l'indirizzo del .deb risponde 404 da
#     sempre, quindi si finiva comunque a clonare;
#   - e il sorgente di HEAD non compila piu' con il nostro kernel 7.2.5. Quello
#     che spediamo ha due correzioni nostre del 18/08 (include esplicito di
#     string.h e strscpy al posto di strncpy), senza le quali il 7.2 rifiuta il
#     modulo. Clonare HEAD significava costruire un'immagine diversa ogni volta,
#     a seconda di cosa era cambiato a monte quel giorno.
#
# ⚠️ MANCAVA Kbuild, ED E' PER QUESTO CHE NON COMPILAVA (15/08/2026)
# Il progetto di partenza tiene l'`obj-m := nct6687.o` in un file `Kbuild`
# separato, non nel Makefile. Copiando solo `*.c`, `*.h`, `Makefile` e
# `dkms.conf` kbuild non sa COSA compilare: make attraversa la cartella, non
# trova moduli, scrive un Module.symvers vuoto ed esce con **successo**. Nel
# registro si legge "exit code: 0" e subito sotto "Error! Build of nct6687.ko
# failed". Il sorgente che spediamo ha il Kbuild al suo posto.
#
# ⚠️ E SE NON RIESCE, IL MODULO VA TOLTO DAL REGISTRO DI DKMS
# Un modulo registrato che non compila non fa danni oggi, ma fa restituire 1
# al postinst del kernel a OGNI aggiornamento futuro sul computer di chi ci
# usa. E' cosi' che una cosa cosmetica ha fatto fallire un'installazione
# intera. Meglio nessun modulo che un modulo rotto.
set +e
KVER=$(ls /lib/modules 2>/dev/null | sort -V | tail -1)
V=1.0
SORGENTE="/usr/src/nct6687d-$V"
echo "[nct6687] kernel di destinazione: ${KVER:-sconosciuto}"

costruisci_e_verifica() {
    [ -n "$KVER" ] || return 1
    dkms add -m nct6687d -v "$V" >/dev/null 2>&1
    dkms build   -m nct6687d -v "$V" -k "$KVER" --force
    dkms install -m nct6687d -v "$V" -k "$KVER" --force
    # dkms puo' dire di aver finito senza aver prodotto niente: si guarda il file
    find "/lib/modules/$KVER" -name 'nct6687.ko*' -print -quit 2>/dev/null | grep -q .
}

rinuncia() {
    echo "[nct6687] ATTENZIONE: il modulo non si costruisce, lo tolgo da DKMS."
    echo "[nct6687] Un modulo rotto nel registro farebbe fallire ogni futuro"
    echo "[nct6687] aggiornamento del kernel sul computer dell'utente."
    dkms remove -m nct6687d -v "$V" --all >/dev/null 2>&1
    sed -i '/^nct6687$/d' /etc/modules 2>/dev/null
}

# ⚠️ Si guarda il Makefile, non Kbuild: nel sorgente che spediamo l'`obj-m`
# sta nella prima riga del Makefile stesso, e un Kbuild separato non c'e'.
# Cercare Kbuild qui ha fatto uscire un'immagine senza modulo (12/09/2026).
if [ ! -f "$SORGENTE/Makefile" ] || [ ! -f "$SORGENTE/dkms.conf" ]; then
    echo "[nct6687] sorgente incompleto in $SORGENTE: niente da costruire"
    exit 0
fi

if costruisci_e_verifica; then
    echo "[nct6687] modulo costruito e installato per $KVER"
    # ⚠️ nct6687, NON nct6683: quello di serie accetta i comandi PWM e non li
    # esegue, in silenzio. Il nostro va caricato con force=1.
    grep -q '^nct6687$' /etc/modules 2>/dev/null || echo nct6687 >> /etc/modules
    install -d /etc/modprobe.d
    cat > /etc/modprobe.d/skillfish-nct6687.conf <<'CONF'
# Il sensore della ventola della BC-250. force=1 perche' il chip non si
# dichiara con un ID che il driver riconosce da solo.
options nct6687 force=1
# E il driver di serie va tenuto fuori: accetta i comandi PWM e non li esegue.
blacklist nct6683
CONF
else
    rinuncia
fi
exit 0

#!/bin/bash
set -e

# snapper and grub-btrfs configuration
# Note: snapper-config for root is created post-install by Calamares shellprocess.
# This hook enables the systemd timers so they activate after install.

# Enable snapper timers
# niente snapper-timeline.timer: la linea temporale e' spenta apposta,
# altrimenti il disco si riempie di snapshot orari
systemctl disable snapper-timeline.timer 2>/dev/null || true
systemctl enable snapper-cleanup.timer 2>/dev/null || true

# Enable grub-btrfs path unit (watches for new snapshots → regenerates GRUB entries)
# nemmeno grub-btrfs.path: e' l'innesco dello stesso demone che fallisce
systemctl disable grub-btrfs.path 2>/dev/null || true

# Snapper default config template for root (applied by Calamares post-install script)
mkdir -p /etc/snapper/config-templates
cat > /etc/snapper/config-templates/skillfish-root << 'TEMPLATE'
SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="10"
NUMBER_LIMIT_IMPORTANT="10"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="5"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_YEARLY="0"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
TEMPLATE

# --- Il servizio di primo avvio degli snapshot deve essere ATTIVO -----------
# Il postinst di skillfish-base fa gia' `systemctl enable`, ma nel chroot di
# live-build non attecchisce: su un sistema installato dalla ISO del 15/08/2026
# il servizio risultava `disabled` e non era mai partito (journalctl: nessuna
# voce), mentre quello dei Flatpak, abilitato da un hook, era regolarmente
# `enabled`. Qui lo si abilita in modo esplicito: e' idempotente e non costa
# niente.
systemctl enable skillfish-firstboot-snapshots.service 2>/dev/null || true

# --- E il marcatore "gia' fatto" NON deve finire dentro l'immagine ----------
# Lo stesso postinst esegue lo script durante la costruzione. Nel chroot la
# radice non e' btrfs, quindi lo script fa `touch $MARK; exit 0` e il marcatore
# viene cotto dentro il squashfs: su OGNI macchina installata sembrerebbe che
# il lavoro fosse gia' stato fatto. E' un guasto gia' visto una volta (marcatore
# datato 7 giugno su un'installazione dell'11 agosto). Lo script oggi non si
# fida piu' del solo marcatore, ma lasciarcelo resta sbagliato.
rm -f /var/lib/skillfish/.snapshots-setup-done

#!/bin/sh
set -e
# Il remote di Flathub, e basta.
#
# ⚠️ QUI NON SI INSTALLA E NON SI DECIDE PIU' NIENTE.
# Fino alla 26.06.5 questo hook scriveva anche il servizio e l'elenco delle
# applicazioni da scaricare al primo avvio: una lista fissa, uguale per tutti,
# che fra le altre cose conteneva un id di Ryujinx morto da mesi e falliva in
# silenzio. Adesso il servizio, l'elenco e la finestra che fa la domanda
# arrivano dal pacchetto skillfish-primo-avvio, cosi' si correggono con un
# aggiornamento invece che con una ISO nuova.
flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true

# Il servizio lo abilita il postinst del pacchetto; qui si controlla solo che
# sia arrivato, perche' senza di lui un sistema appena installato resta senza
# Steam e senza browser e nessuno sa perche'.
if [ -x /usr/local/bin/skillfish-primo-avvio ]; then
    echo "[flatpak] remote pronto; la scelta la fa skillfish-primo-avvio."
else
    echo "[flatpak] ATTENZIONE: manca skillfish-primo-avvio: un sistema"
    echo "[flatpak] installato da questa immagine non avrebbe nessun browser."
fi

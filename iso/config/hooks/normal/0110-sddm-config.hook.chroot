#!/bin/sh
set -e
# Aspetto di SDDM: tema scuro e puntatore steampunk.
#
# L'accesso automatico NON si scrive qui. Prima c'era, con l'utente scritto a
# mano come "live": ma con live-build l'utente creato da live-config si chiama
# "user", quindi quell'impostazione nominava qualcuno che non esisteva e non
# faceva niente. Lo decide a tempo di avvio skillfish-prepara-live, che il nome
# se lo legge da /etc/passwd invece di indovinarlo, e che gira solo da live.

mkdir -p /etc/sddm.conf.d

cat > /etc/sddm.conf.d/00-skillfish.conf << 'SDDM'
[Theme]
Current=breeze
CursorTheme=SkillFish-Steampunk-Cursors

[General]
InputMethod=

[Users]
MaximumUid=60000
MinimumUid=1000
SDDM

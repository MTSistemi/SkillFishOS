#!/bin/sh
set -e
# Aspetto di SDDM: tema scuro e puntatore steampunk.
#
# L'accesso automatico NON si scrive qui. Prima c'era, con l'utente scritto a
# mano come "live": ma con live-build l'utente creato da live-config si chiama
# "user", quindi quell'impostazione nominava qualcuno che non esisteva e non
# faceva niente. Lo decide a tempo di avvio skillfish-prepara-live, che il nome
# se lo legge da /etc/passwd invece di indovinarlo, e che gira solo da live.

mkdir -p /etc/sddm.conf.d

# ⚠️ skillfish-brass, NON breeze. Questa riga diceva `breeze` da prima che il
# nostro tema di accesso esistesse, e cosi' l'immagine scriveva a mano il tema
# di serie sopra il nostro: la schermata di accesso della live e del sistema
# installato era quella di KDE. Il tema arriva con skillfish-theme, che e'
# nella lista 70.
cat > /etc/sddm.conf.d/00-skillfish.conf << 'SDDM'
[Theme]
Current=skillfish-brass
CursorTheme=SkillFish-Steampunk-Cursors

[General]
InputMethod=

[Users]
MaximumUid=60000
MinimumUid=1000
SDDM

# La sessione proposta al primo accesso: Plasma su X11, non Wayland.
#
# ⚠️ QUI E NON SOLO NEL POSTINST DEL PACCHETTO. Nell'immagine skillfish-boot e'
# gia' configurato dentro il squashfs: quando l'utente installa, dpkg non
# riesegue niente, quindi il postinst non arriva mai a creare state.conf. Il
# file va scritto adesso, nel chroot, e viene ereditato dal sistema installato.
#
# Senza, l'installazione nasce in WAYLAND: SDDM al primo accesso propone la
# prima sessione dell'elenco e plasma.desktop viene prima di plasmax11.desktop.
# Sulla BC-250 giriamo in X11 di proposito. Verificato installando davvero in
# macchina virtuale il 12/09/2026: `loginctl` diceva Type=wayland.
if [ -x /usr/local/bin/skillfish-sessione-x11 ]; then
    /usr/local/bin/skillfish-sessione-x11
    echo "[sddm] sessione predefinita: $(grep -h Session= /var/lib/sddm/state.conf 2>/dev/null | tail -1)"
else
    echo "[sddm] ATTENZIONE: manca skillfish-sessione-x11 (skillfish-boot non e' entrato)"
fi

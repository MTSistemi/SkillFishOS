#!/bin/bash
set -e
# Questo hook non fa piu' niente, apposta.
#
# Scriveva la sua copia di /usr/local/bin/skillfish-gaming-mode e un secondo
# gamescope-steam.desktop. Ma gli hook girano DOPO l'installazione dei
# pacchetti, quindi sovrascriveva il file che arriva da skillfish-console: e
# la sua copia e' quella vecchia, che chiama gamescope per nome invece che con
# il percorso assoluto e fallisce con "Failed to start process gamescopereaper".
# Il guasto e' documentato riga per riga nel commento del file buono.
#
# Ora che il repository aetherium e i nostri .deb sono nell'immagine, la
# sessione di gioco la porta il pacchetto. Un file solo, una versione sola.
exit 0

#!/bin/bash
# grub-btrfs is not packaged in Debian -> install from source (Antynea/grub-btrfs).
echo "[grub-btrfs] installing from source"
TMP=$(mktemp -d); cd "$TMP"
if git clone --depth 1 https://github.com/Antynea/grub-btrfs.git; then
    cd grub-btrfs
    make install && echo "[grub-btrfs] installed" || echo "[grub-btrfs] make install failed (non-fatal)"
    # grub-btrfsd resta SPENTO e mascherato, apposta (issue #29): falliva a ogni
    # avvio con "Error during grub menu creation" e lo snapshot pre-aggiornamento
    # non compariva nel menu, cioe' mancava quando serve. Le voci le genera
    # update-grub via 41_snapshots-btrfs, chiamato dal nostro hook apt.
    # Mascherato perche' un aggiornamento del pacchetto lo riabiliterebbe.
    systemctl disable grub-btrfsd 2>/dev/null || true
    systemctl mask grub-btrfsd 2>/dev/null || true
else
    echo "[grub-btrfs] clone failed (non-fatal)"
fi
cd /; rm -rf "$TMP"
true

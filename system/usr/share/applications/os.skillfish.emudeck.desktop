# Terminal=true perche' lo script fa domande (dove tenere le ROM, quanto spazio
# serve) e mostra l'avanzamento di uno scaricamento da 107 MB. Senza terminale
# l'utente vedrebbe partire niente e non saprebbe cosa sta succedendo.
Exec=/usr/local/share/skillfish/install-emudeck.sh
Terminal=true
Icon=applications-games
Categories=Game;Emulator;
Keywords=emulator;emudeck;retro;roms;giochi;emulatori;

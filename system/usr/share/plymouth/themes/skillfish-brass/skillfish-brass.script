// SkillFishOS - Brass boot splash: ONLY the image + progress bar, NO text.
Window.SetBackgroundTopColor(0.043, 0.063, 0.043);     // dark green-black ~ #0b100b
Window.SetBackgroundBottomColor(0.020, 0.031, 0.020);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

// full splash image, scaled to cover the screen
bg.image = Image("splash.png");
img_w = bg.image.GetWidth();
img_h = bg.image.GetHeight();
// scale to fit width keeping aspect (image already 16:9 4K)
scale = screen_w / img_w;
if (screen_h / img_h > scale) scale = screen_h / img_h;
bg.scaled = bg.image.Scale(img_w * scale, img_h * scale);
bg.sprite = Sprite(bg.scaled);
bg.sprite.SetX((screen_w - img_w * scale) / 2);
bg.sprite.SetY((screen_h - img_h * scale) / 2);
bg.sprite.SetZ(0);

// progress bar (brass) BETWEEN the fish (top) and the SkillFishOS plate (bottom)
bar.w = 460;
bar.h = 6;
bar.x = screen_w / 2 - bar.w / 2;
bar.y = screen_h * 0.62;

track.image = Image("bartrack.png").Scale(bar.w, bar.h);
track.sprite = Sprite(track.image);
track.sprite.SetPosition(bar.x, bar.y, 5);

fill.orig = Image("barfill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(bar.x, bar.y, 6);

fun progress_cb(duration, progress) {
    w = bar.w * progress;
    if (w < 1) w = 1;
    fill.image = fill.orig.Scale(w, bar.h);
    fill.sprite.SetImage(fill.image);
}
Plymouth.SetBootProgressFunction(progress_cb);

// LA RICHIESTA DELLA PASSWORD, quando il disco e' cifrato.
//
// ⚠️ DEVE VEDERSI. La versione precedente disegnava soltanto i pallini, e con
// zero caratteri digitati i pallini non esistono: fra la richiesta e il primo
// tasto lo schermo restava fermo sullo splash, e chi ha installato con LUKS
// credeva che l'avvio si fosse piantato. Provato in macchina virtuale il
// 13/09/2026: scrivendo la password alla cieca l'avvio proseguiva.
//
// ⚠️ Image.Text vuole il modulo label di Plymouth. Sta nell'initramfs
// (label-pango.so): se un giorno non ci fosse piu', queste due immagini
// tornerebbero vuote e si tornerebbe allo schermo muto.
pw.y = bar.y + 40;

fun display_password_cb(prompt, bullets) {
    // Il testo lo manda cryptsetup ed e' in inglese: va bene, e' quello che
    // dice anche il resto del mondo. Se arriva vuoto ne mettiamo uno nostro,
    // perche' uno schermo senza parole e' il problema che stiamo togliendo.
    testo = prompt;
    if (testo == "")
        testo = "Encrypted disk: type the password and press Enter";
    pw.testo.image = Image.Text(testo, 0.93, 0.80, 0.55);
    pw.testo.sprite = Sprite(pw.testo.image);
    pw.testo.sprite.SetPosition(screen_w / 2 - pw.testo.image.GetWidth() / 2,
                                pw.y, 7);

    // Un pallino per carattere. ⚠️ Si parte da uno spazio: con la stringa
    // vuota Image.Text non restituisce un'immagine e GetWidth() fallisce,
    // e un errore qui dentro lascia di nuovo lo schermo muto.
    punti = " ";
    i = 0;
    while (i < bullets) {
        punti = punti + "*";
        i = i + 1;
    }
    pw.punti.image = Image.Text(punti, 0.85, 0.66, 0.29);
    pw.punti.sprite = Sprite(pw.punti.image);
    pw.punti.sprite.SetPosition(screen_w / 2 - pw.punti.image.GetWidth() / 2,
                                pw.y + 34, 7);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

// Password accettata: la richiesta sparisce e resta lo splash.
fun display_normal_cb() {
    pw.testo.sprite = NULL;
    pw.punti.sprite = NULL;
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);

// intentionally NO message function -> boot/fsck text is NOT shown

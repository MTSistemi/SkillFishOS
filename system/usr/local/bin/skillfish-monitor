            "gpu_power", "gpu_mv", "cpu_mv", "fan", "vram"]


def _num(s):
    """Extract the first number from a sensor value like '350Mhz' or '40/40'."""
    if s is None:
        return None
    m = re.search(r'-?\d+(?:\.\d+)?', str(s))
    return float(m.group()) if m else None


def _nice_step(raw):
    """Round a raw step up to 1/2/2.5/5 times a power of ten."""
    if raw <= 0:
        return 1.0
    mag = 10.0 ** math.floor(math.log10(raw))
    n = raw / mag
    return (1 if n <= 1 else 2 if n <= 2 else 2.5 if n <= 2.5 else 5 if n <= 5 else 10) * mag


def _nice_scale(lo, hi, ticks=4):
    """Snap an axis to human numbers (0/1000/2000, not -160/1394/2948).

    Two rules beyond plain rounding: zero becomes the floor when the data sits
    near it (a MHz or RPM chart must never show a negative baseline), and the
    step is taken from the *unpadded* range, otherwise the padding inflates the
    step and a 3992 MHz peak ends up on a 0-6000 axis."""
    # a dead-flat series must not get a wildly zoomed axis: 800/800 MHz would
    # otherwise be drawn on a 799.8-801.2 scale, amplifying nothing into noise
    if hi - lo < max(1e-9, abs(hi) * 0.005):
        if hi == 0:
            lo, hi = 0.0, 1.0
        else:
            band = abs(hi) * 0.05
            lo, hi = hi - band, hi + band
    nonneg = lo >= 0
    if nonneg and lo < (hi - lo):
        lo = 0.0
    span = hi - lo
    step = _nice_step(span / float(max(1, ticks)))
    pad = span * 0.06
    if nonneg and lo == 0.0:
        nlo = 0.0
    else:
        nlo = math.floor((lo - pad) / step) * step
        if nonneg:
            nlo = max(0.0, nlo)
    return nlo, math.ceil((hi + pad) / step) * step, step


def _fmt_axis(v, step):
    """Tick label with exactly the decimals the step needs (0.25 -> "0.25",
    never "0.2", which would print two different ticks with the same label)."""
    d = 0
    while d < 3 and abs(round(step, d) - step) > 1e-9:
        d += 1
    return "%.*f" % (d, v)


def cpu_mhz_per():
    """{cpu_id: MHz} from /proc/cpuinfo. Offline CPUs simply aren't listed there."""
    out = {}
    try:
        cur = None
        with open("/proc/cpuinfo") as fh:
            for ln in fh:
                if ln.startswith("processor"):
                    cur = int(ln.split(":")[1])
                elif ln.lower().startswith("cpu mhz") and cur is not None:
                    out[cur] = float(ln.split(":")[1])
    except Exception:
        pass
    return out


_TOPO = {}


def cpu_threads():
    """[(cpu, core, mhz|None)] for every logical CPU, mhz None when it is offline.

    An offline CPU drops its topology/ directory, so its physical core is taken
    from the cached map built while it was still up (SMT pairing as a fallback)."""
    base = "/sys/devices/system/cpu"
    try:
        cpus = sorted(int(d[3:]) for d in os.listdir(base) if re.match(r"cpu\d+$", d))
    except Exception:
        return []
    mhz = cpu_mhz_per()
    out = []
    for c in cpus:
        try:
            with open("%s/cpu%d/online" % (base, c)) as fh:
                on = fh.read().strip() == "1"
        except Exception:
            on = True                       # cpu0 exposes no 'online' node
        try:
            with open("%s/cpu%d/topology/core_id" % (base, c)) as fh:
                _TOPO[c] = int(fh.read().strip())
        except Exception:
            pass
        out.append((c, _TOPO.get(c, c // 2), mhz.get(c) if on else None))
    return out


class CoreBars(QWidget):
    """Live per-thread CPU frequency: one bar per logical CPU, grouped by core."""
    def __init__(self):
        super().__init__()
        self.threads = []            # [(cpu, core, mhz|None)]
        self.setMinimumHeight(150)

    def push(self, threads):
        self.threads = threads or []
        self.update()

    def _color(self, t):
        """Brass -> amber -> ember as the thread climbs its share of the peak."""
        a, b = ((0x6b, 0x5a, 0x34), (0xd8, 0xa8, 0x49)) if t < 0.5 else \
               ((0xd8, 0xa8, 0x49), (0xe0, 0x6b, 0x39))
        k = (t / 0.5) if t < 0.5 else ((t - 0.5) / 0.5)
        return QColor(*[int(a[i] + (b[i] - a[i]) * k) for i in range(3)])

    def paintEvent(self, _e):
        w, h = self.width(), self.height()
        if w <= 2 or h <= 2:
            return
        p = QPainter()
        if not p.begin(self):
            return
        try:
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            p.setPen(QPen(QColor(216, 168, 73, 80), 1)); p.setBrush(QColor(18, 15, 9, 240))
            p.drawRoundedRect(1, 1, w - 2, h - 2, 14, 14)

            live = [m for (_c, _k, m) in self.threads if m is not None]
            f = QFont("Inter"); f.setBold(True); f.setPointSize(10); p.setFont(f)
            p.setPen(QColor(216, 168, 73))
            p.drawText(14, 22, L("Frequenza per core/thread (MHz)",
                                 "Per core/thread frequency (MHz)"))
            if live:
                fv = QFont("DejaVu Sans Mono"); fv.setPointSize(9); fv.setBold(True)
                p.setFont(fv); p.setPen(QColor(185, 160, 122))
                s = "%s %d   %s %d   %s %d   %s %d/%d" % (
                    L("min", "min"), round(min(live)), L("med", "avg"), round(sum(live) / len(live)),
                    L("max", "max"), round(max(live)), L("attivi", "online"),
                    len(live), len(self.threads))
                p.drawText(w - 14 - p.fontMetrics().horizontalAdvance(s), 22, s)
            if not self.threads:
                return

            gx0, gy0, gx1, gy1 = 50, 36, w - 14, h - 20
            gw, gh = gx1 - gx0, gy1 - gy0
            hi = max(1000.0, max(live) if live else 0.0)
            hi = math.ceil(hi / 500.0) * 500.0          # bars share a stable, round scale
            ft = QFont("DejaVu Sans Mono"); ft.setPointSize(8); p.setFont(ft)
            for i in range(5):
                yy = int(gy0 + gh * i / 4)
                p.setPen(QPen(QColor(216, 168, 73, 26), 1)); p.drawLine(gx0, yy, gx1, yy)
                txt = "%d" % round(hi - hi * i / 4.0)
                p.setPen(QColor(185, 160, 122, 190))
                p.drawText(gx0 - 6 - p.fontMetrics().horizontalAdvance(txt), yy + 3, txt)

            n = len(self.threads)
            # a wider gap between physical cores makes the SMT pairs obvious
            slot = gw / float(n)
            bw = max(4.0, slot * 0.62)
            for i, (cpu, core, mhz) in enumerate(self.threads):
                pair_shift = (slot * 0.10) * (1 if (i % 2) else -1) if n > 4 else 0.0
                x = gx0 + slot * i + (slot - bw) / 2.0 + pair_shift
                if mhz is None:                          # core parked by the Tuner
                    p.setBrush(Qt.BrushStyle.NoBrush)
                    p.setPen(QPen(QColor(216, 168, 73, 55), 1, Qt.PenStyle.DashLine))
                    p.drawRoundedRect(int(x), gy1 - 14, int(bw), 14, 3, 3)
                else:
                    t = max(0.0, min(1.0, mhz / hi))
                    bh = max(2.0, gh * t)
                    col = self._color(t)
                    grad = QLinearGradient(0, gy1 - bh, 0, gy1)
                    c0 = QColor(col); c0.setAlpha(235); c1 = QColor(col); c1.setAlpha(110)
                    grad.setColorAt(0, c0); grad.setColorAt(1, c1)
                    p.setPen(Qt.PenStyle.NoPen); p.setBrush(QBrush(grad))
                    p.drawRoundedRect(int(x), int(gy1 - bh), int(bw), int(bh), 3, 3)
                    p.setPen(QPen(col, 1)); p.setBrush(Qt.BrushStyle.NoBrush)
                    p.drawRoundedRect(int(x), int(gy1 - bh), int(bw), int(bh), 3, 3)
                    if bw >= 26:
                        p.setFont(ft); p.setPen(QColor(232, 200, 120))
                        v = "%d" % round(mhz)
                        p.drawText(int(x + (bw - p.fontMetrics().horizontalAdvance(v)) / 2),
                                   int(max(gy0 + 9, gy1 - bh - 3)), v)
                lab = "%d" % cpu if bw < 26 else "%d·%d" % (core, cpu)
                p.setFont(ft)
                p.setPen(QColor(150, 130, 100) if mhz is not None else QColor(120, 100, 76))
                p.drawText(int(x + (bw - p.fontMetrics().horizontalAdvance(lab)) / 2), gy1 + 14, lab)
        except Exception:
            pass
        finally:
            if p.isActive():
                p.end()


class Chart(QWidget):
    """Live (rolling) or static (full recording + scrubber) line chart, brass look."""
    def __init__(self, title, unit, series):
        super().__init__()
        self.title = title; self.unit = unit; self.series = series  # [(label,color,key)]
        self.data = [collections.deque(maxlen=240) for _ in series]
        self.static = False           # viewer mode
        self.times = []               # x axis (seconds) in static mode
        self.sdata = [[] for _ in series]
        self.cursor = 0               # current index in static mode
        # Per-series switches, for the charts whose legend lives outside them in
        # clickable tiles. A hidden series leaves the y axis too, so isolating one
        # line actually zooms it instead of keeping the others' scale.
        self.visibile = [True] * len(series)
        # The six live charts carry their own legend at the top right. A chart
        # with eight series cannot: its legend is the column of tiles beside it,
        # and two lists of the same numbers is the overload to avoid.
        self.legenda_dentro = True
        self.setMinimumSize(360, 170)

    def _visibile(self, si):
        try:
            return bool(self.visibile[si])
        except IndexError:
            return True

    def valore_corrente(self, si):
        """Latest value (live) or the value under the cursor (viewer), or None.

        Exposed so the tiles read exactly what the chart draws, instead of each
        keeping its own idea of "current".
        """
        try:
            d = (self.sdata if self.static else self.data)[si]
        except IndexError:
            return None
        if not len(d):
            return None
        if self.static and 0 <= self.cursor < len(d):
            return d[self.cursor]
        return d[-1]

    def push(self, vals):
        for d, v in zip(self.data, vals, strict=False):
            d.append(float(v) if v is not None else (d[-1] if d else 0.0))
        self.update()

    def set_full(self, times, series_vals):
        self.static = True; self.times = times; self.sdata = series_vals
        self.cursor = len(times) - 1 if times else 0; self.update()

    def set_cursor(self, i):
        self.cursor = i; self.update()

    def paintEvent(self, _e):
        w, h = self.width(), self.height()
        if w <= 2 or h <= 2:
            return
        p = QPainter()
        if not p.begin(self):
            return
        try:
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            p.setPen(QPen(QColor(216, 168, 73, 80), 1)); p.setBrush(QColor(18, 15, 9, 240))
            p.drawRoundedRect(1, 1, w - 2, h - 2, 14, 14)
            gx0, gy0, gx1, gy1 = 50, 34, w - 14, h - 16   # left gutter holds the y-axis values
            gw, gh = gx1 - gx0, gy1 - gy0
            f = QFont("Inter"); f.setBold(True); f.setPointSize(10); p.setFont(f)
            p.setPen(QColor(216, 168, 73)); p.drawText(14, 22, "%s (%s)" % (self.title, self.unit))

            cols = [self.sdata, self.data][not self.static]
            # Only the visible series set the scale: hiding the hottest chip has
            # to rescale the axis, or isolating a line shows nothing new.
            allv = [v for si, d in enumerate(cols) if self._visibile(si)
                    for v in d if v is not None]
            if not allv:
                return
            lo, hi, astep = _nice_scale(min(allv), max(allv), 4)   # padding included
            span = (hi - lo) or 1.0
            fv = QFont("DejaVu Sans Mono"); fv.setPointSize(9); fv.setBold(True)
            # y axis: gridlines with their value, so the scale is readable
            ft = QFont("DejaVu Sans Mono"); ft.setPointSize(8)
            p.setFont(ft)
            v = lo
            while v <= hi + astep / 2.0:
                yy = int(gy1 - gh * (v - lo) / span)
                p.setPen(QPen(QColor(216, 168, 73, 26), 1)); p.drawLine(gx0, yy, gx1, yy)
                txt = _fmt_axis(v, astep)
                p.setPen(QColor(185, 160, 122, 190))
                p.drawText(gx0 - 6 - p.fontMetrics().horizontalAdvance(txt), yy + 3, txt)
                v += astep

            n = len(cols[0]) if cols else 0
            # vertical time cursor (viewer mode)
            if self.static and n >= 2:
                cx = gx0 + gw * (self.cursor / (n - 1))
                p.setPen(QPen(QColor(216, 168, 73, 120), 1, Qt.PenStyle.DashLine))
                p.drawLine(int(cx), gy0, int(cx), gy1)

            lx = gx1
            for si, (label, col, _key) in enumerate(self.series):
                if not self._visibile(si):
                    continue
                d = cols[si]; nn = len(d); color = QColor(col)
                if nn >= 2:
                    line = QPainterPath(); fill = QPainterPath()
                    for i, v in enumerate(d):
                        vv = v if v is not None else lo
                        x = gx0 + gw * (i / (nn - 1)); y = gy1 - gh * ((vv - lo) / span)
                        if i == 0: line.moveTo(x, y); fill.moveTo(x, gy1); fill.lineTo(x, y)
                        else: line.lineTo(x, y); fill.lineTo(x, y)
                    fill.lineTo(gx1, gy1); fill.closeSubpath()
                    grad = QLinearGradient(0, gy0, 0, gy1)
                    c0 = QColor(color); c0.setAlpha(75); c1 = QColor(color); c1.setAlpha(0)
                    grad.setColorAt(0, c0); grad.setColorAt(1, c1)
                    p.setPen(Qt.PenStyle.NoPen); p.setBrush(QBrush(grad)); p.drawPath(fill)
                    glow = QColor(color); glow.setAlpha(55)
                    p.setBrush(Qt.BrushStyle.NoBrush); p.setPen(QPen(glow, 5)); p.drawPath(line)
                    p.setPen(QPen(color, 2)); p.drawPath(line)
                # legend value: cursor value (static) or latest (live)
                if self.static:
                    cur = d[self.cursor] if 0 <= self.cursor < nn else (d[-1] if nn else None)
                else:
                    cur = d[-1] if nn else 0.0
                if not self.legenda_dentro:
                    continue
                if cur is None: cur = 0.0
                txt = "%s %s" % (label, ("%d" % round(cur)) if abs(cur) >= 10 else ("%.2f" % cur))
                p.setFont(fv); p.setPen(color)
                tw = p.fontMetrics().horizontalAdvance(txt)
                lx -= tw + 14; p.drawText(int(lx), 22, txt)
        except Exception:
            pass
        finally:
            if p.isActive():
                p.end()


# Resolve the sensor helper by absolute path: launched from SDDM/menu the PATH
# usually has /usr/local/bin, but a sudo/cron context may not — never rely on PATH.
HUD = shutil.which("skillfish-hud-val") or "/usr/local/bin/skillfish-hud-val"


def read_all():
    """One subprocess: parse `skillfish-hud-val all` into {key: float}."""
    out = {}
    try:
        txt = subprocess.run([HUD, "all"], capture_output=True,
                             text=True, timeout=1.2).stdout
        for line in txt.splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2:
                out[parts[0]] = _num(parts[1])
    except Exception:
        pass
    return out


def cpu_load_pct(prev):
    """CPU utilization % from /proc/stat delta. Returns (pct_or_None, new_state)."""
    try:
        with open("/proc/stat") as fh:
            f = fh.readline().split()[1:]
        vals = [int(x) for x in f]
        idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
        total = sum(vals)
        if prev is None:
            return None, (total, idle)
        dt = total - prev[0]; di = idle - prev[1]
        pct = (100.0 * (dt - di) / dt) if dt > 0 else None
        return (max(0.0, min(100.0, pct)) if pct is not None else None), (total, idle)
    except Exception:
        return None, prev


class Sampler(QThread):
    """Reads sensors off the GUI thread. Emits a {key: value} dict per tick."""
    sample = pyqtSignal(dict)

    def __init__(self):
        super().__init__()
        self._interval = 0.7
        self._stop = False
        self._cpu_prev = None

    def setIntervalMs(self, ms):
        try:
            self._interval = max(0.1, float(ms) / 1000.0)
        except Exception:
            self._interval = 0.7

    def stop(self):
        self._stop = True

    def run(self):
        while not self._stop:
            vals = read_all()
            pct, self._cpu_prev = cpu_load_pct(self._cpu_prev)
            vals["cpu_load"] = pct
            vals["_threads"] = cpu_threads()
            if self._stop:
                break
            self.sample.emit(vals)
            t = 0.0
            while t < self._interval and not self._stop:
                self.msleep(50); t += 0.05


# ---------- GDDR6 memory temperature ----------
# Eight on-die JEDEC sensors, one per memory chip, reached through the SMU. The
# reading is a capped session started by skillfish-gddr6-helper: see that file for
# why it must never be a service that simply runs.
#
# Here the window only ever READS /run/bc250-memory/telemetry, which the collector
# publishes world-readable. Nothing on this side needs privileges.
GDDR6_SNAPSHOT = "/run/bc250-memory/telemetry"
GDDR6_HELPER = shutil.which("skillfish-gddr6-helper") or "/usr/local/bin/skillfish-gddr6-helper"
GDDR6_CHIP = 8
# Eight colours that stay apart on a dark ground, taken from the palette the six
# live charts already use: a memory chip has to be recognisable next to them.
GDDR6_COLORI = ["#e8c878", "#d8a849", "#c98a3a", "#e07b39",
                "#e0d24f", "#9bd24f", "#5fd24f", "#49b6e0"]


def gddr6_disponibile():
    """True only where the reading can exist at all.

    Checked before the button is created, so on any other machine the Monitor
    stays exactly as it was instead of growing a control that cannot work.
    """
    if not os.path.exists(GDDR6_HELPER):
        return False
    try:
        with open("/sys/class/dmi/id/product_name") as fh:
            return "BC-250" in fh.read()
    except OSError:
        return False


def leggi_gddr6():
    """(status, [temperature per chip]) from the collector's snapshot.

    The file is five lines: marker, boot time, status, eight raw words, error.
    Degrees come out of the JEDEC code in the low byte: code * 2 - 40.
    """
    try:
        with open(GDDR6_SNAPSHOT, encoding="utf-8", errors="replace") as fh:
            righe = fh.read().splitlines()
    except OSError:
        return "assente", []
    if len(righe) < 4 or righe[0] != "BC250_MEMORY_V1":
        return "assente", []
    if righe[2] != "ok":
        return righe[2], []
    gradi = [(int(w) & 0xFF) * 2 - 40 for w in righe[3].split() if w.isdigit()]
    return ("ok", gradi) if len(gradi) == GDDR6_CHIP else (righe[2], [])


def gddr6_helper(azione, *extra, con_password=True):
    """Ask the helper to start or stop the reading. Returns its JSON, or a reason.

    `stato` runs without pkexec: it asks nothing of the hardware and a password
    prompt every few seconds to read a countdown would be absurd.
    """
    cmd = ([] if not con_password else ["pkexec"]) + [GDDR6_HELPER, azione] + [str(x) for x in extra]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=40)
        return json.loads((p.stdout or "{}").strip().splitlines()[-1])
    except subprocess.TimeoutExpired:
        return {"ok": False, "errore": L("l'helper non ha risposto", "the helper did not answer")}
    except Exception:
        return {"ok": False, "errore": L("helper non disponibile", "helper unavailable")}


class Tessera(QPushButton):
    """Legend and value in one, as in the Fan window: click to hide the line.

    ⚠️ There is no second list of these numbers anywhere. A legend inside the
    chart AND a column beside it was exactly the overload the Fan layout removed.
    """
    def __init__(self, etichetta, colore):
        super().__init__()
        self.etichetta = etichetta
        self.colore = colore
        self.setCheckable(True)
        self.setChecked(True)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setMinimumWidth(124)
        self.aggiorna(None)

    def aggiorna(self, valore):
        testo = "—" if valore is None else "%d °C" % round(valore)
        self.setText("%s\n%s" % (self.etichetta, testo))
        acceso = self.isChecked()
        self.setStyleSheet(
            "QPushButton{text-align:left;padding:5px 9px;border-radius:9px;font-size:11px;"
            "font-family:'DejaVu Sans Mono';font-weight:bold;"
            "color:%s;background:rgba(216,168,73,%s);border:1px solid %s;}"
            % (self.colore if acceso else "#6b5a34",
               "0.12" if acceso else "0.03",
               self.colore + ("" if acceso else "44")))


class GddrPanel(QWidget):
    """The GDDR6 card: tiles on the left, one chart, controls underneath.

    One chart and not eight: with a single one the whole memory is watched at
    once, and with more you have to keep switching.
    """
    def __init__(self):
        super().__init__()
        self.setStyleSheet("QWidget{background:#120f09;border:1px solid rgba(216,168,73,.31);"
                           "border-radius:14px;} QLabel{border:none;}")
        serie = [("chip %d" % i, GDDR6_COLORI[i], "chip%d" % i) for i in range(GDDR6_CHIP)]
        self.chart = Chart(L("Memoria GDDR6", "GDDR6 memory"), "°C", serie)
        self.chart.legenda_dentro = False          # the tiles are the legend
        self.chart.setMinimumHeight(240)

        fuori = QVBoxLayout(self)
        fuori.setContentsMargins(14, 12, 14, 12)
        fuori.setSpacing(10)

        riga = QHBoxLayout()
        riga.setSpacing(12)
        colonna = QVBoxLayout()
        colonna.setSpacing(5)
        self.tessere = []
        for i, (etichetta, colore, _k) in enumerate(serie):
            t = Tessera(etichetta, colore)
            t.toggled.connect(lambda _on, si=i: self._commuta(si))
            colonna.addWidget(t)
            self.tessere.append(t)
        self.riassunto = QLabel("")
        self.riassunto.setStyleSheet("color:#b9a07a;font-family:'DejaVu Sans Mono';font-size:11px;")
        colonna.addWidget(self.riassunto)
        colonna.addStretch(1)
        riga.addLayout(colonna)
        riga.addWidget(self.chart, 1)
        fuori.addLayout(riga)

        basso = QHBoxLayout()
        self.btn = QPushButton("")
        self.btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn.clicked.connect(self._premuto)
        basso.addWidget(self.btn)
        self.nota = QLabel("")
        self.nota.setStyleSheet("color:#8d7b5c;font-size:11px;")
        self.nota.setWordWrap(True)
        basso.addWidget(self.nota, 1)
        fuori.addLayout(basso)

        self._attiva = False
        self._chiedo = False
        self.orologio = QTimer(self)
        self.orologio.timeout.connect(self._giro)
        # The collector publishes every three seconds; asking faster only repeats
        # the same numbers, and the interval is not ours to shorten anyway.
        self.orologio.start(3000)
        self._giro()

    def _commuta(self, si):
        self.chart.visibile[si] = self.tessere[si].isChecked()
        self.tessere[si].aggiorna(self.chart.valore_corrente(si))
        self.chart.update()

    def _premuto(self):
        if self._chiedo:
            return
        self._chiedo = True
        try:
            r = gddr6_helper("ferma" if self._attiva else "avvia")
            if not r.get("ok"):
                self.nota.setText(str(r.get("errore") or L("non riuscito", "failed")))
        finally:
            self._chiedo = False
        self._giro()

    def _giro(self):
        st = gddr6_helper("stato", con_password=False)
        self._attiva = bool(st.get("attiva"))
        rimasti = st.get("rimasti")
        pausa = st.get("pausa") or 0
        motivo = st.get("perche_no")

        # The glyph stays out of the translated string: the web card shows the
        # same two labels without it, and one key translated once serves both.
        self.btn.setText("■ " + L("Ferma la lettura", "Stop reading") if self._attiva
                         else "◉ " + L("Leggi la memoria", "Read the memory"))
        self.btn.setEnabled(not motivo and (self._attiva or not pausa))
        self.btn.setStyleSheet(
            "QPushButton{color:%s;background:rgba(216,168,73,0.12);"
            "border:1px solid rgba(216,168,73,0.35);border-radius:9px;"
            "padding:5px 14px;font-weight:bold;}QPushButton:hover{color:#fff;}"
            "QPushButton:disabled{color:#6b5a34;border-color:rgba(216,168,73,0.14);}"
            % ("#e8c878" if self._attiva else "#b9a07a"))

        if motivo:
            self.nota.setText(str(motivo))
        elif self._attiva and rimasti is not None:
            # %s and not %d:%02d: the same key has to serve the web card, where
            # the value arrives already formatted. One string, translated once.
            self.nota.setText(L("si chiude da sola fra %s — tocca la SMU, non si tiene accesa",
                                "closes itself in %s — it touches the SMU, do not leave it on")
                              % ("%d:%02d" % (rimasti // 60, rimasti % 60)))
        elif pausa:
            self.nota.setText(L("pausa fra una lettura e l'altra: ancora %s s",
                                "cooldown between readings: %s s left") % pausa)
        else:
            self.nota.setText(L("la lettura si accende quando serve e dura al massimo %s minuti",
                                "the reading is started when needed and lasts at most %s minutes")
                              % int(st.get("minuti_max") or 10))

        stato, gradi = leggi_gddr6()
        if self._attiva and stato == "ok" and gradi:
            self.chart.push(gradi)
            media = sum(gradi) / float(len(gradi))
            caldo = max(gradi)
            self.riassunto.setText(
                L("media %s °C", "average %s °C") % round(media) + "\n" +
                L("punto caldo %s °C (chip %s)", "hotspot %s °C (chip %s)")
                % (caldo, gradi.index(caldo)))
        elif not self._attiva:
            self.riassunto.setText("")
        for i, t in enumerate(self.tessere):
            t.aggiorna(self.chart.valore_corrente(i) if self._attiva else None)


# ---------- platform security state (AMD Secure Processor) ----------
# The BC-250 carries a secure processor at PCI 1022:143e that no upstream kernel
# binds, so these files only exist with our ccp patches in place. Everything here
# is world-readable and needs no helper: the panel is a plain read.
#
# The device is found through the driver rather than hardcoded, because a bus
# address is not a promise.
CCP_DRIVER = "/sys/bus/pci/drivers/ccp"

# key, label, and what a 1 and a 0 actually mean for the person reading.
SECURITY_ROWS = [
    ("fused_part",
     L("Silicio", "Silicon"),
     L("di produzione, fusibili bruciati", "production part, fuses blown"),
     L("campione di pre-produzione", "pre-production sample")),
    ("debug_lock_on",
     L("Debug", "Debug"),
     L("chiuso", "locked"),
     L("aperto", "open")),
    ("boot_integrity",
     L("Integrità all'avvio", "Boot integrity"),
     L("verificata", "verified"),
     L("non verificata", "not verified")),
    ("tsme_status",
     L("Memoria", "Memory"),
     L("cifrata dal firmware", "encrypted by firmware"),
     L("in chiaro, nessun costo in prestazioni", "in the clear, no performance cost")),
    ("hsp_tpm_available",
     L("TPM firmware", "Firmware TPM"),
     L("presente", "present"),
     L("assente", "absent")),
    ("rom_armor_enforced",
     L("Flash del BIOS", "BIOS flash"),
     L("protetta dal processore sicuro", "guarded by the secure processor"),
     L("non protetta", "not guarded")),
    ("anti_rollback_status",
     L("Firmware più vecchi", "Older firmware"),
     L("bloccati", "blocked"),
     L("ammessi", "allowed")),
    ("rpmc_spirom_available",
     L("Contatore antiritorno", "Rollback counter"),
     L("presente sulla flash", "present on the flash"),
     L("assente", "absent")),
]


def psp_security():
    """Read the secure processor's own account of the platform, or None.

    Returns {"bootloader": str|None, "<key>": bool} for the keys above. None
    when there is no secure processor bound, which is every machine that is not
    a BC-250 running our kernel - the panel is simply not offered there.
    """
    try:
        indirizzi = [n for n in os.listdir(CCP_DRIVER) if n.count(":") == 2]
    except OSError:
        return None
    for indirizzo in sorted(indirizzi):
        base = os.path.join(CCP_DRIVER, indirizzo)
        fuori = {}
        for chiave, _lab, _si, _no in SECURITY_ROWS:
            try:
                with open(os.path.join(base, chiave)) as fh:
                    fuori[chiave] = fh.read().strip() == "1"
            except OSError:
                pass
        if not fuori:
            continue                      # bound, but without our sysfs group
        try:
            with open(os.path.join(base, "bootloader_version")) as fh:
                fuori["bootloader"] = fh.read().strip() or None
        except OSError:
            fuori["bootloader"] = None
        return fuori
    return None


class SecurityPanel(QWidget):
    """What the secure processor says about this board. Read once, never polled.

    None of it changes while the machine is running: it is fused, flashed or
    configured before Linux starts. Polling it would be noise.
    """
    def __init__(self, stato):
        super().__init__()
        self.setStyleSheet("QWidget{background:#120f09;border:1px solid rgba(216,168,73,.31);"
                           "border-radius:14px;} QLabel{border:none;}")
        g = QGridLayout(self)
        g.setContentsMargins(16, 12, 16, 14)
        g.setHorizontalSpacing(14)
        g.setVerticalSpacing(5)

        titolo = QLabel(L("Stato di sicurezza della piattaforma",
                          "Platform security state"))
        titolo.setStyleSheet("color:#d8a849;font-weight:bold;font-size:13px;letter-spacing:1px;")
        g.addWidget(titolo, 0, 0, 1, 2)

        versione = stato.get("bootloader")
        if versione:
            v = QLabel(L("bootloader %s", "bootloader %s") % versione)
            v.setStyleSheet("color:#b9a07a;font-family:'DejaVu Sans Mono';font-size:11px;")
            v.setAlignment(Qt.AlignmentFlag.AlignRight)
            g.addWidget(v, 0, 2)

        riga = 1
        for chiave, etichetta, se_si, se_no in SECURITY_ROWS:
            if chiave not in stato:
                continue
            acceso = stato[chiave]
            nome = QLabel(etichetta)
            nome.setStyleSheet("color:#cbb98f;font-size:12px;")
            segno = QLabel("●")
            # Gold for a fact that holds, dim brass for one that does not. No red
            # and no green: none of these rows is a fault, and colouring them as
            # alarms would tell the reader something untrue about their board.
            segno.setStyleSheet("color:%s;font-size:12px;" % ("#d8a849" if acceso else "#6b5a34"))
            senso = QLabel(se_si if acceso else se_no)
            senso.setStyleSheet("color:#8d7b5c;font-size:12px;")
            g.addWidget(segno, riga, 0)
            g.addWidget(nome, riga, 1)
            g.addWidget(senso, riga, 2)
            riga += 1
        g.setColumnStretch(2, 1)


class Monitor(QMainWindow):
    def __init__(self, recording=None):
        super().__init__()
        self.setWindowIcon(QIcon(ICON))
        self.resize(1060, 880)
        w = QWidget(); self.setCentralWidget(w)
        w.setStyleSheet("QWidget{background:#0d0b06;color:#cbb98f;}"
                        "QLabel{color:#b9a07a;} QComboBox{background:#1a140b;color:#e8c878;"
                        "border:1px solid rgba(216,168,73,.3);border-radius:6px;padding:2px 8px;}")
        self.v = QVBoxLayout(w); self.v.setContentsMargins(14, 12, 14, 12); self.v.setSpacing(10)

        self.charts = []
        grid = QGridLayout(); grid.setSpacing(12)
        for i, (title, unit, series) in enumerate(CHARTS):
            c = Chart(title, unit, series)
            self.charts.append(c)
            grid.addWidget(c, i // 2, i % 2)

        if recording:
            self._build_viewer(recording, grid)
        else:
            self._build_live(grid)

    # ---------------- live mode ----------------
    def _build_live(self, grid):
        self.setWindowTitle(L("SkillFishOS — Telemetry", "SkillFishOS — Telemetry"))
        top = QHBoxLayout()
        hdr = QLabel(L("◉  TELEMETRY LIVE", "◉  TELEMETRY LIVE"))
        hdr.setStyleSheet("color:#d8a849;font-weight:bold;font-size:14px;letter-spacing:3px;")
        top.addWidget(hdr); top.addStretch(1)
        self._rec = None
        self.open_btn = QPushButton(L("\U0001f4c2 Apri", "\U0001f4c2 Open"))
        self.open_btn.setToolTip(L("Apri una registrazione .sfmon da analizzare",
                                   "Open a .sfmon recording to analyze"))
        self.open_btn.setStyleSheet(self._btn_css())
        self.open_btn.clicked.connect(self._open_recording)
        top.addWidget(self.open_btn)
        self.rec_btn = QPushButton(L("● REC", "● REC")); self.rec_btn.setCheckable(True)
        self.rec_btn.setToolTip(L("Registra la telemetria su file .sfmon (benchmark/sessioni)",
                                  "Record telemetry to a .sfmon file (benchmarks/sessions)"))
        self.rec_btn.setStyleSheet(self._btn_css() +
            "QPushButton:checked{color:#fff;background:#a03020;border-color:#e05540;}")
        self.rec_btn.toggled.connect(self._rec_toggle)
        top.addWidget(self.rec_btn)
        # Offered only where there is a secure processor to ask, so the button is
        # absent rather than dead on every other machine.
        self._sec_state = psp_security()
        self.sec_panel = None
        if self._sec_state:
            self.sec_btn = QPushButton(L("Sicurezza", "Security"))
            self.sec_btn.setCheckable(True)
            self.sec_btn.setToolTip(L("Cosa dice il processore sicuro di questa scheda",
                                      "What the secure processor says about this board"))
            self.sec_btn.setStyleSheet(self._btn_css() +
                "QPushButton:checked{color:#fff;background:rgba(216,168,73,0.28);}")
            self.sec_btn.toggled.connect(self._sec_toggle)
            top.addWidget(self.sec_btn)
        self.gddr_panel = None
        if gddr6_disponibile():
            self.mem_btn = QPushButton(L("Memoria", "Memory"))
            self.mem_btn.setCheckable(True)
            self.mem_btn.setToolTip(L("Temperatura dei chip di memoria GDDR6, a richiesta",
                                      "GDDR6 memory chip temperature, on demand"))
            self.mem_btn.setStyleSheet(self._btn_css() +
                "QPushButton:checked{color:#fff;background:rgba(216,168,73,0.28);}")
            self.mem_btn.toggled.connect(self._mem_toggle)
            top.addWidget(self.mem_btn)
        top.addWidget(QLabel(L("Aggiornamento:", "Refresh:")))
        self.iv = QComboBox()
        for ms, lab in [(300, "0.3 s"), (500, "0.5 s"), (750, "0.75 s"), (1000, "1 s"), (2000, "2 s")]:
            self.iv.addItem(lab, ms)
        self.iv.setCurrentIndex(2)  # default 0.75 s
        self.iv.currentIndexChanged.connect(lambda: self.sampler.setIntervalMs(self.iv.currentData()))
        top.addWidget(self.iv)
        self.v.addLayout(top)
        self.v.addLayout(grid)
        self.cores = CoreBars()
        self.v.addWidget(self.cores)

        self._sec_slot = self.v.count()   # where the panel goes when asked for

        self.sampler = Sampler()
        self.sampler.setIntervalMs(self.iv.currentData())
        self.sampler.sample.connect(self._apply)
        self.sampler.start()

    def _mem_toggle(self, aperto):
        """Build the GDDR6 card the first time it is asked for, then show it.

        The card is not built at startup: it polls a snapshot and drives a helper,
        and neither should happen in a Monitor nobody opened it in.
        """
        if aperto and self.gddr_panel is None:
            self.gddr_panel = GddrPanel()
            self.v.insertWidget(self._sec_slot, self.gddr_panel)
        if self.gddr_panel is not None:
            self.gddr_panel.setVisible(aperto)

    def _sec_toggle(self, aperto):
        """Build the panel the first time it is asked for, then just show it.

        Nothing in it changes at runtime, so it is read once at startup and the
        widget is kept: reopening must not re-read sysfs for the same answer.
        """
        if aperto and self.sec_panel is None:
            self.sec_panel = SecurityPanel(self._sec_state)
            self.v.insertWidget(self._sec_slot, self.sec_panel)
        if self.sec_panel is not None:
            self.sec_panel.setVisible(aperto)

    def _btn_css(self):
        return ("QPushButton{color:#b9a07a;background:rgba(216,168,73,0.10);"
                "border:1px solid rgba(216,168,73,0.3);border-radius:8px;padding:4px 12px;font-weight:bold;}"
                "QPushButton:hover{color:#fff;}")

    def _apply(self, vals):
        if getattr(self, "cores", None) is not None:
            self.cores.push(vals.get("_threads"))
        for c in self.charts:
            c.push([vals.get(k) for (_lab, _col, k) in c.series])
        if self._rec:
            wtr, fh, rows, t0 = self._rec
            row = [round(time.time() - t0, 2)] + [vals.get(k) for k in REC_KEYS]
            wtr.writerow(row); rows.append(row)

    # ---------------- recorder ----------------
    def _rec_toggle(self, on):
        if on:
            os.makedirs(REC_DIR, exist_ok=True)
            path = os.path.join(REC_DIR, datetime.datetime.now().strftime("rec-%Y%m%d-%H%M%S") + SFMON_EXT)
            fh = open(path, "w", newline="")
            fh.write("# SkillFishOS Monitor recording v1\n")
            fh.write("# started=%s interval_ms=%s\n" % (
                datetime.datetime.now().isoformat(timespec="seconds"), self.iv.currentData()))
            wtr = csv.writer(fh); wtr.writerow(["t_sec"] + REC_KEYS)
            self._rec = (wtr, fh, [], time.time()); self._rec_path = path
            self.rec_btn.setText(L("■ STOP", "■ STOP"))
        else:
            rec, self._rec = self._rec, None
            self.rec_btn.setText(L("● REC", "● REC"))
            if not rec:
                return
            _w, fh, rows, _t0 = rec; fh.close()
            if not rows:
                return
            dur = rows[-1][0]
            names = {"cpu_temp": "CPU °C", "gpu_temp": "GPU °C", "cpu_load": "CPU %",
                     "gpu_util": "GPU %", "cpu_mhz": "CPU MHz", "gpu_freq": "GPU MHz",
                     "gpu_power": "GPU W", "gpu_mv": "GPU mV", "cpu_mv": "CPU mV",
                     "fan": "Fan RPM", "vram": "VRAM MB"}
            lines = [L("Registrazione: %.0f s, %d campioni", "Recording: %.0f s, %d samples") % (dur, len(rows)), ""]
            for i, k in enumerate(REC_KEYS, start=1):
                series = [r[i] for r in rows if isinstance(r[i], (int, float))]
                if series:
                    lines.append("%-9s min %.0f · avg %.0f · max %.0f"
                                 % (names[k], min(series), sum(series) / len(series), max(series)))
            lines += ["", L("Salvato in (apri per analizzare):", "Saved to (open to analyze):"), self._rec_path]
            QMessageBox.information(self, L("Riepilogo registrazione", "Recording summary"), "\n".join(lines))

    def _open_recording(self):
        path, _ = QFileDialog.getOpenFileName(
            self, L("Apri registrazione", "Open recording"), REC_DIR,
            "SkillFishOS Monitor (*.sfmon *.csv)")
        if path:
            self._launch_viewer(path)

    def _launch_viewer(self, path):
        # open the viewer in a fresh process so live and analysis can coexist
        try:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), path])
        except Exception:
            self._build_viewer(path, None)

    # ---------------- viewer mode ----------------
    def _build_viewer(self, path, grid):
        self.sampler = None
        name = os.path.basename(path)
        self.setWindowTitle(L("SkillFishOS — Analisi: ", "SkillFishOS — Analysis: ") + name)
        times, cols, meta = self._load_sfmon(path)
        top = QHBoxLayout()
        hdr = QLabel(L("\U0001f4ca ANALISI  ·  ", "\U0001f4ca ANALYSIS  ·  ") + name)
        hdr.setStyleSheet("color:#d8a849;font-weight:bold;font-size:14px;letter-spacing:1px;")
        top.addWidget(hdr); top.addStretch(1)
        self.cur_lbl = QLabel("")
        self.cur_lbl.setStyleSheet("color:#e8c878;font-family:'DejaVu Sans Mono';font-weight:bold;")
        top.addWidget(self.cur_lbl)
        self.v.addLayout(top)
        if grid is None:
            grid = QGridLayout(); grid.setSpacing(12)
            for i, c in enumerate(self.charts):
                grid.addWidget(c, i // 2, i % 2)
        self.v.addLayout(grid)

        # feed each chart its full series
        self._times = times
        for c in self.charts:
            series_vals = [cols.get(k, [None] * len(times)) for (_lab, _col, k) in c.series]
            c.set_full(times, series_vals)

        # time scrubber
        sb = QHBoxLayout()
        sb.addWidget(QLabel(L("Tempo:", "Time:")))
        self.scrub = QSlider(Qt.Orientation.Horizontal)
        self.scrub.setMinimum(0); self.scrub.setMaximum(max(0, len(times) - 1))
        self.scrub.setValue(max(0, len(times) - 1))
        self.scrub.valueChanged.connect(self._scrub)
        sb.addWidget(self.scrub, 1)
        self.v.addLayout(sb)
        if times:
            self._scrub(len(times) - 1)

    def _scrub(self, i):
        for c in self.charts:
            c.set_cursor(i)
        if 0 <= i < len(self._times):
            self.cur_lbl.setText("t = %.1f s  /  %.1f s   (#%d)" % (
                self._times[i], self._times[-1] if self._times else 0, i))

    def _load_sfmon(self, path):
        times, header, rows, meta = [], None, [], {}
        try:
            with open(path, newline="") as fh:
                for line in fh:
                    s = line.strip()
                    if not s:
                        continue
                    if s.startswith("#"):
                        for tok in s[1:].split():
                            if "=" in tok:
                                k, v = tok.split("=", 1); meta[k] = v
                        continue
                    parts = next(csv.reader([line]))
                    if header is None:
                        header = parts; continue
                    rows.append(parts)
        except Exception:
            pass
        cols = {}
        if header:
            idx = {h: i for i, h in enumerate(header)}
            for r in rows:
                try:
                    times.append(float(r[idx["t_sec"]]))
                except Exception:
                    times.append(len(times) * 1.0)
            for k in REC_KEYS:
                if k in idx:
                    series = []
                    for r in rows:
                        try:
                            series.append(float(r[idx[k]]))
                        except Exception:
                            series.append(None)
                    cols[k] = series
        return times, cols, meta

    def closeEvent(self, e):
        if getattr(self, "_rec", None):
            try: self._rec[1].close()
            except Exception: pass
            self._rec = None
        if getattr(self, "sampler", None):
            try:
                self.sampler.stop(); self.sampler.wait(1500)
            except Exception:
                pass
        super().closeEvent(e)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("SkillFishOS Telemetry")
    app.setDesktopFileName("os.skillfish.monitor")
    app.setWindowIcon(QIcon(ICON))
    rec = None
    for a in sys.argv[1:]:
        if a.endswith(SFMON_EXT) or a.endswith(".csv"):
            if os.path.isfile(a):
                rec = a; break
    win = Monitor(recording=rec); win.show()
    if win.sampler is not None:
        app.aboutToQuit.connect(win.sampler.stop)
    signal.signal(signal.SIGTERM, lambda *_a: app.quit())
    signal.signal(signal.SIGINT, lambda *_a: app.quit())
    _keepalive = QTimer(); _keepalive.start(250); _keepalive.timeout.connect(lambda: None)
    win._keepalive = _keepalive
    sq = os.environ.get("SFX_SELFQUIT_MS")
    if sq:
        QTimer.singleShot(int(sq), win.close)
    sys.exit(app.exec())

if __name__ == "__main__":
    main()

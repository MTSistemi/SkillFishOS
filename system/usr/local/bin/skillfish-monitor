def L(it, en):
    """Restituisce la stringa IT, PL o EN secondo il locale rilevato."""
    if LANG == "it": return it
    if LANG == "pl": return PL.get(en) or _TR(en)
    if LANG == "uk": return UK.get(en) or _TR(en)
    return _TR(en)

# Chart spec: (title_it, title_en, unit, [(label, color, key)...]). Drives both
# the live charts and the recording/viewer columns.

#!/bin/bash
# Genera la configurazione del HUD dai sensori che questa macchina ha davvero.
#
# PERCHE' ESISTE
# La configurazione di conky era scritta a mano sulla BC-250: 16 barre perche'
# quella scheda ha 16 thread, sensori amdgpu, ventola nct6686, VRAM, Compute
# Unit. Su un PC diverso quelle voci tornano VUOTE, conky non riesce a misurare
# l'ingombro del testo, riduce la finestra a pochi pixel e sparisce. Non
# degrada: sparisce. Per questo il HUD era stato limitato alla sola BC-250 —
# una toppa onesta, ma sull'edizione Generic voleva dire spedire un avvio
# automatico e una configurazione che non potevano funzionare per nessuno.
#
# Qui si fa il contrario: si chiede a `skillfish-hud-val` ogni valore, si tiene
# solo quello che risponde, e si scrive una configurazione su misura. Su una
# BC-250 esce esattamente il HUD di prima; su un portatile Intel escono CPU,
# RAM e disco; su un PC con scheda NVIDIA esce anche la temperatura della GPU.
#
#   uso:  skillfish-hud-config [percorso]     (default: ~/.config/conky/skillfish.conf)
set -u

# Versione del GENERATORE, non del HUD. Si alza ogni volta che cambia cio che
# viene scritto nella configurazione: skillfish-hud confronta questo numero
# con quello scritto dentro e rigenera se non coincide.
#
# PERCHE SERVE: il controllo di prima guardava solo il numero di barre contro
# i thread. Su una macchina che non cambia hardware quei due numeri coincidono
# per sempre, quindi una configurazione scritta mesi fa non veniva MAI
# aggiornata: la riga della versione del kernel, aggiunta il 18/08, non
# compariva a chi aveva gia il HUD in funzione. Misurato sulla BC-250, che
# aveva ancora la configurazione del 9 agosto.
VERSIONE=8
VAL=/usr/local/bin/skillfish-hud-val
OUT="${1:-$HOME/.config/conky/skillfish.conf}"
[ -x "$VAL" ] || { echo "manca $VAL" >&2; exit 1; }

# c'e' <chiave>: vero se il valore non e' vuoto e non e' un segnaposto
ce(){ v=$("$VAL" "$1" 2>/dev/null); [ -n "$v" ] && [ "$v" != "?" ] && [ "$v" != "0" ]; }
# gpu_util torna 0 anche quando il dato non c'e': si distingue guardando la fonte
ce_util(){ [ -r /run/skillfish-gpu-util ] || \
           for d in /sys/class/drm/card[0-9]/device/gpu_busy_percent; do [ -e "$d" ] && return 0; done
           [ -r /run/skillfish-gpu-util ]; }

THREAD=$(nproc 2>/dev/null || echo 4)
PER_RIGA=8

barre(){                       # disegna le barre dei thread, 8 per riga
  # La prima riga stacca di 3, le successive di 2: e' la spaziatura della
  # configurazione scritta a mano sulla BC-250, tenuta identica per non
  # cambiare di un pixel il HUD di chi ha gia' la scheda.
  i=1; riga=0
  while [ "$i" -le "$THREAD" ]; do
    if [ "$riga" -eq 0 ]; then printf '${voffset 3}${color D8A849}'
    else printf '${voffset 2}${color D8A849}'; fi
    riga=$((riga+1))
    j=0; sep=""
    while [ "$j" -lt "$PER_RIGA" ] && [ "$i" -le "$THREAD" ]; do
      printf '%s${cpubar cpu%d 6,16}' "$sep" "$i"; sep=" "   # niente spazio in coda
      i=$((i+1)); j=$((j+1))
    done
    printf '\n'
  done
}

mkdir -p "$(dirname "$OUT")"
{
printf -- '-- skillfish-hud-config v%s
' "$VERSIONE"
cat <<'TESTA'
conky.config = {
    alignment = 'top_right',
    gap_x = 16,
    gap_y = 16,
    minimum_width = 240,
    maximum_width = 240,
    own_window = true,
    own_window_type = 'normal',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_class = 'Conky',
    own_window_argb_visual = true,
    own_window_argb_value = 165,
    own_window_colour = '14100a',
-- background = false: conky NON deve sganciarsi.
--
-- KDE avvia l'autostart come servizio utente di systemd. Se conky forka e il
-- processo padre esce, systemd considera il servizio finito e ripulisce tutto
-- il gruppo, ammazzando anche il figlio.
background = false,
    double_buffer = true,
    update_interval = 2,
    cpu_avg_samples = 2,
    use_xft = true,
    xftalpha = 1,
    font = 'DejaVu Sans:size=9',
    default_color = 'D8A849',
    color1 = 'F1E3C6',
    color2 = 'B9A07A',
    draw_shades = false,
    draw_outline = false,
    border_inner_margin = 14,
    border_outer_margin = 0,
};

conky.text = [[
TESTA

printf '${font DejaVu Sans:bold:size=12}${color D8A849}SkillFish${color1}OS${font}${alignr}${color1}${time %%a %%d  %%H:%%M}\n'

# La versione del kernel sotto al nome: e' identita', non una misura, quindi
# sta in alto e in tono spento invece che fra i sensori.
printf '${voffset 1}${color2}${font DejaVu Sans:size=7}${execi 9999 skillfish-hud-val kernel}${font}\n'

# --- CPU: la frequenza e il carico ci sono su qualunque macchina -------------
printf '${voffset 5}${color2}CPU   ${color1}${freq_g} GHz'
ce cpu_temp && printf '${color2}    ${color1}${execi 2 skillfish-hud-val cpu_temp}°C'
printf '${color2}    ${execi 9999 skillfish-hud-val lbl_use} ${color1}${cpu cpu0}%%\n'
barre

# --- GPU: solo le voci che questa scheda espone ------------------------------
# I pezzi si uniscono con un separatore SOLO se qualcosa li precede, altrimenti
# la riga comincia con uno spazio vuoto e sembra un difetto grafico.
riga_gpu=""
unisci(){ [ -n "$riga_gpu" ] && riga_gpu="${riga_gpu}"'${color2}  '; riga_gpu="${riga_gpu}$1"; }
ce gpu_freq && unisci '${color1}${execi 2 skillfish-hud-val gpu_freq}'
ce gpu_temp && unisci '${color1}${execi 2 skillfish-hud-val gpu_temp}°C'
ce_util     && unisci '${execi 9999 skillfish-hud-val lbl_use} ${color1}${execi 2 skillfish-hud-val gpu_util}%'
if [ -n "$riga_gpu" ]; then
  printf '${voffset 6}${color2}GPU   %s\n' "$riga_gpu"
  ce_util && printf '${voffset 3}${color D8A849}${execibar 6,208 skillfish-hud-val gpu_util}\n'
fi

linea=""
ce gpu_mv    && linea='${color2}VDDGFX ${color1}${execi 2 skillfish-hud-val gpu_mv} mV'
ce gpu_power && linea="${linea}"'${color2}   Power ${color1}${execi 2 skillfish-hud-val gpu_power} W'
[ -n "$linea" ] && printf '%s\n' "$linea"

# VRAM: dove il driver dice quanta ne e' in uso si scrive "usata / totale",
# dove dice solo quanta ce n'e' si scrive il totale e basta. Su AMD i due numeri
# stanno in sysfs; altrove il totale lo dichiara Vulkan e lo deposita
# skillfish-sensori all'avvio, mentre l'uso non lo espone nessuno.
linea=""
if ce vram && ce vram_tot; then
  linea='${color2}VRAM  ${color1}${execi 2 skillfish-hud-val vram}/${execi 9999 skillfish-hud-val vram_tot}'
elif ce vram_tot; then
  linea='${color2}VRAM  ${color1}${execi 9999 skillfish-hud-val vram_tot} MiB'
elif ce vram; then
  linea='${color2}VRAM  ${color1}${execi 2 skillfish-hud-val vram} MiB'
fi
# La frequenza della memoria video la espone amdgpu; nouveau e i915 no.
# ⚠️ Forma compatta, senza unita'. Con "245 / 8192 MiB @ 450 MHz  CU 40/40" per
# esteso la riga usciva dalla finestra e le CU venivano tagliate: il HUD e' largo
# 240 pixel e allargarlo cambierebbe l'aspetto su tutte le macchine.
ce vram_mhz && linea="${linea}"'${color2} @${color1}${execi 5 skillfish-hud-val vram_mhz}'
# Unita' di calcolo: 40/40 sulla BC-250, il numero dichiarato da Vulkan altrove
# (CU su AMD, CUDA core su NVIDIA). Dove nessuno lo dice, la voce non compare.
ce cu   && linea="${linea}"'${color2}  CU ${color1}${execi 5 skillfish-hud-val cu}'
[ -n "$linea" ] && printf '%s\n' "$linea"

# --- memoria, ventola, disco -------------------------------------------------
# Un solo segno di percento, non due: prima la riga si stampava con printf,
# che converte il doppio in singolo; adesso passa da una variabile stampata
# con %s, che non converte niente.
riga_ram='${color2}RAM   ${color1}${mem} / ${memmax}${color2}   ${color1}${memperc}%'
# La frequenza dei moduli la sa solo dmidecode, che vuole root: la legge
# skillfish-sensori all'avvio e la deposita in /run. Non cambia mai, quindi
# si chiede una volta sola.
# ⚠️ Forma compatta, senza unita'. Con " @ 2400 MT/s" per esteso la riga usciva
# dalla finestra e "MT/s" veniva tagliato a meta': il HUD e' largo 240 pixel e
# allargarlo cambierebbe l'aspetto anche sulla BC-250, dove va bene com'e'.
ce ram_mhz && riga_ram="${riga_ram}"'${color2} @${color1}${execi 9999 skillfish-hud-val ram_mhz}'
printf '%s\n' "$riga_ram"
# VENTOLE. Sulla BC-250 ce n'e' una sola e resta com'era. Su un PC normale ce
# ne sono diverse - processore, case, a volte due sul case - e il driver quasi
# mai dice quale sia quale: si mostrano tutte, nell'ordine in cui il chip le
# espone, che almeno e' stabile fra un avvio e l'altro. Inventare le etichette
# sarebbe peggio che non metterle.
#
# ⚠️ Su molte macchine le ventole NON si vedono finche' skillfish-sensori non
# carica il driver del chip Super-I/O: sta su bus ISA e il kernel non puo'
# enumerarlo, quindi nessuno lo carica da solo.
riga_fan=""
if ce fan_all; then
  riga_fan='${color2}FAN   ${color1}${execi 2 skillfish-hud-val fan_all} rpm'
elif ce fan; then
  riga_fan='${color2}FAN   ${color1}${execi 2 skillfish-hud-val fan} rpm'
fi
# La ventola della scheda video: giri se la scheda ha un contagiri, altrimenti
# la percentuale del PWM, che e' il solo dato vero che quelle schede dichiarano.
# ⚠️ Se la macchina non ha una ventola di sistema leggibile, qui riga_fan e'
# ancora vuota: accodare "   GPU 39%" lascerebbe la percentuale senza
# etichetta, due righe sotto "GPU 34°C", e si legge come carico della GPU.
# Visto sulla Generic (Xeon + GTX 1050 Ti). Sulla BC-250 non si manifesta,
# perche' li' la ventola di sistema c'e' sempre.
if ce fan_gpu; then
  if [ -n "$riga_fan" ]; then
    riga_fan="${riga_fan}"'${color2}   GPU ${color1}${execi 2 skillfish-hud-val fan_gpu}'
  else
    riga_fan='${color2}FAN   GPU ${color1}${execi 2 skillfish-hud-val fan_gpu}'
  fi
fi
[ -n "$riga_fan" ] && printf '%s\n' "$riga_fan"
printf '${color2}${execi 9999 skillfish-hud-val lbl_disk} ${color1}${fs_used /} / ${fs_size /}${color2}   ${color1}${fs_used_perc /}%%\n'

# --- Bluetooth: solo se la macchina ha un adattatore -------------------------
if [ -d /sys/class/bluetooth ] && [ -n "$(ls /sys/class/bluetooth 2>/dev/null)" ]; then
  printf '${voffset 4}${color D8A849}── Bluetooth ──${color}\n'
  printf '${execpi 15 skillfish-hud-bt}\n'
fi

printf ']];\n'
} > "$OUT"

echo "scritta $OUT"
echo "  thread: $THREAD   righe di barre: $(( (THREAD + PER_RIGA - 1) / PER_RIGA ))"
for k in cpu_temp gpu_freq gpu_temp gpu_mv gpu_power vram vram_tot vram_mhz ram_mhz cu fan fan_all fan_gpu; do
  ce "$k" && echo "  presente: $k" || echo "  assente:  $k"
done

[Unit]
Description=Count available updates for SkillFishOS Hub, once a day
Documentation=https://github.com/MTSistemi/SkillFishOS

[Timer]
OnCalendar=daily
# ⚠️ Il ritardo a caso non e' pignoleria: senza, tutte le macchine con
# SkillFishOS bussano al mirror allo stesso secondo di mezzanotte.
RandomizedDelaySec=4h
# Se la scheda era spenta all'ora prevista, si recupera al primo avvio: una
# scheda da gioco sta spenta molto piu' di quanto sta accesa.
Persistent=true
# Al primo avvio dopo l'accensione si aspetta comunque un po', per non
# litigare con tutto il resto che parte insieme.
OnBootSec=15min

[Install]
WantedBy=timers.target

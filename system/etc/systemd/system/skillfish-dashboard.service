[Unit]
Description=SkillFish Remote dashboard (LAN control panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/skillfish-dashboardd
# Sta in uno script: scritto qui dentro, il pkill trovava la riga di comando
# della propria shell e la ammazzava, e il servizio finiva in stato failed a ogni
# spegnimento regolare.
ExecStopPost=/usr/local/bin/skillfish-dashboard-stop
Restart=on-failure
RestartSec=3
# LAN control panel: needs PAM auth and system actions, so it runs as root.
# It binds only where dashboard.json says (LAN by default) and serves over TLS.

[Install]
WantedBy=multi-user.target

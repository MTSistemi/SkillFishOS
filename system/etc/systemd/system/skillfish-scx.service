[Unit]
Description=SkillFishOS: scx_lavd CPU scheduler (sched_ext)
Documentation=https://github.com/sched-ext/scx
# The scheduler only exists on a kernel built with CONFIG_SCHED_CLASS_EXT. On
# one without it - our own 7.2.0, or the stock Debian kernel if somebody falls
# back to it - this service would fail at every boot and fill the journal with
# errors about something that is not a fault. With the condition it simply does
# not start.
ConditionPathExists=/sys/kernel/sched_ext
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/scx_lavd
# If the scheduler dies the kernel falls back to the default one by itself, so
# the machine keeps running either way. Restarting gets the better scheduling
# back without anybody noticing.
Restart=on-failure
RestartSec=5
# ⚠️ scx_lavd scrive «scx_task_data:83 no task data» circa quattro volte al
# secondo - trecentomila righe al giorno - dal flusso BPF, non dal log di Rust,
# quindi --log-level non lo tocca. Zittirlo del tutto con StandardError=null
# toglierebbe anche gli errori veri: si limita il ritmo e journald annota da se'
# quanti messaggi ha soppresso.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target

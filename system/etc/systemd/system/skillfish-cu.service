[Unit]
Description=SkillFishOS — route the BC-250 Compute Units at boot
Documentation=https://skillfishos.com
After=display-manager.service multi-user.target
Wants=display-manager.service

[Service]
Type=oneshot
# ⚠️ La guardia hardware sta QUI e non solo nel postinst di
# skillfish-base. Prima veniva iniettata con una sed al momento
# dell'installazione: funziona, ma basta che qualcosa riscriva questo
# file dopo e la macchina resta scoperta. Su un PC che non e' una
# BC-250 il servizio parte, non trova le CU e fallisce a ogni avvio.
ExecCondition=/usr/local/bin/skillfish-is-bc250
# `boot` and not `max`: all 40 CU are still what happens unless somebody has
# saved a mapping with "keep at boot", which is how a defective CU gets to stay
# switched off. See issue #77.
ExecStart=/usr/local/bin/skillfish-cu boot
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
